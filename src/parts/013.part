
function iconV4(name, className = '') {
  const paths = {
    headset: '<path d="M4 13v-2a8 8 0 0 1 16 0v2"/><path d="M18 19c0 1.1-.9 2-2 2h-3"/><rect x="3" y="12" width="4" height="6" rx="2"/><rect x="17" y="12" width="4" height="6" rx="2"/>',
    receipt: '<path d="M6 2v20l3-2 3 2 3-2 3 2V2l-3 2-3-2-3 2-3-2Z"/><path d="M9 9h6M9 13h6"/>',
    crown: '<path d="m3 7 4 4 5-7 5 7 4-4-2 10H5L3 7Z"/><path d="M5 21h14"/>',
    shield: '<path d="M12 3 5 6v5c0 5 3.5 8.5 7 10 3.5-1.5 7-5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
    bolt: '<path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"/>',
    refresh: '<path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/>',
    user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
    check: '<path d="m5 12 4 4L19 6"/>',
    lock: '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
    card: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h3"/>',
    arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    alert: '<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>',
    plane: '<path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/>',
    home: '<path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10"/><path d="M9 21v-6h6v6"/>',
    plug: '<path d="M9 2v6M15 2v6"/><path d="M7 8h10v3a5 5 0 0 1-10 0V8Z"/><path d="M12 16v6"/>',
    list: '<path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/>',
    sliders: '<path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="8" cy="18" r="2"/>'
  };
  const body = paths[name] || paths.check;
  return '<svg class="ico ' + className + '" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">' + body + '</svg>';
}

function storeHtmlV4() {
  const ICON = {
    headset: iconV4('headset'),
    receipt: iconV4('receipt'),
    crown: iconV4('crown'),
    shield: iconV4('shield'),
    bolt: iconV4('bolt'),
    refresh: iconV4('refresh'),
    user: iconV4('user'),
    check: iconV4('check'),
    lock: iconV4('lock'),
    card: iconV4('card'),
    arrow: iconV4('arrow'),
    clock: iconV4('clock'),
    alert: iconV4('alert'),
    plane: iconV4('plane')
  };

  return `<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#07111f">
<meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
<link rel="manifest" href="/manifest.webmanifest?v=6">
<link rel="icon" type="image/svg+xml" href="/brandmark.webp?v=6">
<title>${BRAND_FA} | ${BRAND}</title>
<style>
:root{color-scheme:dark;--bg:#050a12;--surface:#0c1524;--surface2:#111e31;--surface3:#14243b;--line:rgba(154,190,235,.13);--text:#f7fbff;--muted:#879bb4;--blue:#338cff;--blue2:#59c8ff;--gold:#f2cb73;--green:#4bdda3;--danger:#ff7886;--shadow:0 24px 65px rgba(0,30,90,.35)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;background:var(--bg)}
body{margin:0;min-height:100vh;font-family:Tahoma,"Segoe UI",system-ui,sans-serif;color:var(--text);background:
radial-gradient(760px 360px at 92% -8%,rgba(45,134,255,.26),transparent 64%),
radial-gradient(520px 420px at -5% 38%,rgba(38,180,255,.08),transparent 68%),
linear-gradient(180deg,#081220 0%,#050a12 58%,#050a12 100%);overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.18;background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:29px 29px;mask-image:linear-gradient(#000,transparent 78%)}
.ico{width:20px;height:20px;display:block;flex:0 0 auto}
.shell{width:min(1020px,100%);margin:auto;padding:14px 16px 124px;position:relative}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:max(3px,env(safe-area-inset-top))}
.brand{display:flex;align-items:center;gap:10px}.brand-logo{width:45px;height:45px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(145deg,#3a97ff,#0d4ac5);box-shadow:0 13px 30px rgba(22,106,245,.32),inset 0 1px rgba(255,255,255,.32);position:relative;overflow:hidden}.brand-logo{background:#fff;overflow:hidden}.brand-logo img{width:100%;height:100%;object-fit:cover;display:block}.brand-logo:after{display:none}
.brand-name{font-size:15px;font-weight:900}.brand-name small{display:block;direction:ltr;text-align:right;margin-top:3px;color:#71869f;font-size:8px;letter-spacing:1.4px}
.top-actions{display:flex;gap:7px}.icon-button{height:42px;min-width:42px;padding:0 11px;border-radius:14px;border:1px solid var(--line);background:rgba(10,20,34,.72);backdrop-filter:blur(16px);color:#c9def6;font:700 9px Tahoma;display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;cursor:pointer}.icon-button .ico{width:18px;height:18px}
.product{margin-top:26px;display:grid;grid-template-columns:1.08fr .92fr;gap:22px;align-items:center}
.product-copy .online{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;background:rgba(75,221,163,.055);border:1px solid rgba(75,221,163,.14);font-size:8px;font-weight:800;color:#a6d5c3}.online-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(75,221,163,.08)}
.product h1{margin:14px 0 9px;font-size:clamp(34px,6vw,58px);line-height:1.16;letter-spacing:-2px}.product h1 span{background:linear-gradient(100deg,#fff,#72d0ff 56%,#6c93ff);-webkit-background-clip:text;color:transparent}.product p{margin:0;max-width:610px;color:#8ea3ba;line-height:2.1;font-size:11px}
.features{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}.feature{display:inline-flex;align-items:center;gap:6px;padding:8px 9px;border-radius:11px;border:1px solid var(--line);background:rgba(255,255,255,.025);color:#91a7bf;font-size:8px}.feature .ico{width:15px;height:15px;color:#78bfff}
.visual{min-height:250px;display:grid;place-items:center;position:relative;perspective:900px}.premium-card{width:278px;height:182px;border-radius:29px;position:relative;overflow:hidden;background:linear-gradient(135deg,#459bff,#195ac4 54%,#082e7c);box-shadow:0 44px 80px rgba(6,60,158,.46),inset 0 1px rgba(255,255,255,.45);transform:rotateY(-12deg) rotateX(6deg) rotateZ(2deg);animation:floatCard 5.2s ease-in-out infinite}.premium-card:before{content:"";position:absolute;inset:-80px;background:conic-gradient(from 80deg,transparent,rgba(255,255,255,.17),transparent 22%);animation:rotateShine 6s linear infinite}.card-brand{position:absolute;right:22px;top:21px;width:46px;height:46px;border-radius:15px;background:#fff;border:1px solid rgba(255,255,255,.2);overflow:hidden}.card-brand img{width:100%;height:100%;object-fit:cover;display:block}.card-crown{position:absolute;left:23px;top:22px;color:var(--gold)}.card-crown .ico{width:36px;height:36px;stroke-width:1.6}.card-copy{position:absolute;right:22px;bottom:23px}.card-copy b{font-size:20px;display:block;letter-spacing:-.8px}.card-copy small{display:block;color:#d9eaff;font-size:8px;margin-top:5px;letter-spacing:1.4px}
.floating{position:absolute;border-radius:14px;padding:9px 11px;border:1px solid var(--line);background:rgba(7,15,27,.82);backdrop-filter:blur(15px);box-shadow:0 15px 34px rgba(0,0,0,.26);display:flex;align-items:center;gap:7px;color:#9fb1c8;font-size:8px}.floating .ico{width:15px;height:15px;color:#77bfff}.floating b{color:white}.f1{right:0;bottom:16px}.f2{left:2px;top:27px}
.section-title{display:flex;align-items:end;justify-content:space-between;gap:10px;margin:20px 0 10px}.section-title h2{margin:0;font-size:15px}.section-title p{margin:4px 0 0;color:var(--muted);font-size:8px}.section-title span{font-size:8px;color:#6e849d}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.plan{position:relative;min-height:177px;padding:16px;border-radius:23px;border:1px solid var(--line);background:linear-gradient(155deg,rgba(18,31,51,.94),rgba(7,14,25,.98));overflow:hidden;cursor:pointer;transition:.2s transform,.2s border-color,.2s box-shadow}.plan:after{content:"";position:absolute;width:140px;height:140px;left:-46px;bottom:-68px;border-radius:50%;background:radial-gradient(circle,rgba(55,148,255,.18),transparent 67%)}.plan:hover{transform:translateY(-3px)}.plan.active{border-color:rgba(72,157,255,.66);box-shadow:0 16px 44px rgba(17,93,210,.19),inset 0 0 0 1px rgba(72,157,255,.1)}
.selector{position:absolute;left:14px;top:14px;width:22px;height:22px;border:1px solid #3b526d;border-radius:50%;display:grid;place-items:center;color:transparent}.selector .ico{width:13px;height:13px}.plan.active .selector{background:var(--blue);border-color:var(--blue);color:white}
.plan-label{display:inline-flex;padding:5px 8px;border-radius:999px;border:1px solid rgba(242,203,115,.17);background:rgba(242,203,115,.08);color:#f4d992;font-size:7px;font-weight:800}.months{font-size:27px;font-weight:900;margin-top:13px;letter-spacing:-1px}.months small{font-size:9px;color:#7e94ad;font-weight:500}.type{color:#71869e;font-size:8px;margin-top:3px}.price{font-size:19px;font-weight:900;margin-top:20px}.price small{font-size:8px;color:#6e849d;font-weight:500}.plan-note{margin-top:5px;font-size:8px;color:#62b6ff}
.checkout{margin-top:12px;display:grid;grid-template-columns:1.14fr .86fr;gap:10px}.box{border-radius:23px;border:1px solid var(--line);background:linear-gradient(155deg,rgba(12,23,39,.97),rgba(6,13,23,.98));padding:17px;box-shadow:var(--shadow)}.box h3{margin:0;font-size:13px}.hint{margin-top:4px;color:#7f94ad;font-size:8px;line-height:1.9}
.steps{display:flex;align-items:center;gap:5px;margin:14px 0}.step{display:flex;align-items:center;gap:5px;color:#61758e;font-size:8px}.step i{font-style:normal;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#0d1929;border:1px solid var(--line);font:700 9px Arial}.step.on{color:#b9dbff}.step.on i{background:#176fe9;border-color:#318eff;color:white}.steps .line{height:1px;flex:1;background:var(--line)}
.field{margin-top:9px}.field label{display:block;margin:0 3px 6px;color:#95aac1;font-size:8px}.input-wrap{height:52px;border-radius:16px;border:1px solid #203650;background:#07101c;display:flex;align-items:center;padding:0 12px;transition:.2s}.input-wrap:focus-within{border-color:#3a91ff;box-shadow:0 0 0 4px rgba(58,145,255,.08)}.input-icon{color:#6c8aad}.input-icon .ico{width:18px;height:18px}.input{height:100%;flex:1;border:0;background:transparent;color:white;outline:0;direction:ltr;text-align:left;font:700 13px "Segoe UI",Tahoma;padding:0 8px}
.account{display:none;align-items:center;gap:10px;margin-top:10px;padding:10px;border-radius:15px;border:1px solid rgba(61,152,255,.16);background:rgba(52,139,255,.065)}.account.show{display:flex}.avatar{width:40px;height:40px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(145deg,#3798ff,#164ab0);font:900 14px Arial}.account-info b{font-size:9px}.account-info small{display:block;margin-top:4px;color:#7e95ae;font-size:8px;direction:ltr;text-align:right}.account-check{margin-right:auto;width:25px;height:25px;border-radius:50%;display:grid;place-items:center;background:rgba(75,221,163,.1);color:var(--green)}.account-check .ico{width:14px;height:14px}
.actions{display:grid;grid-template-columns:.82fr 1.18fr;gap:8px;margin-top:10px}.btn{height:50px;border:0;border-radius:16px;padding:0 14px;font:800 9px Tahoma;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;transition:.15s}.btn .ico{width:17px;height:17px}.btn:active{transform:scale(.985)}.btn.primary{background:linear-gradient(100deg,#136bf7,#2ca9ff);color:white;box-shadow:0 13px 28px rgba(26,112,255,.24)}.btn.secondary{background:#0e1b2d;color:#c7d8ea;border:1px solid var(--line)}.btn:disabled{opacity:.43;box-shadow:none}
.summary{display:flex;flex-direction:column;justify-content:space-between}.summary-head{display:flex;justify-content:space-between;align-items:center}.summary-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:rgba(242,203,115,.075);border:1px solid rgba(242,203,115,.13);color:var(--gold)}.summary-icon .ico{width:22px;height:22px}.summary-rows{border-top:1px solid var(--line);margin-top:13px}.summary-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px dashed var(--line);font-size:8px;color:#748aa3}.summary-row b{font-size:9px;color:#eaf3ff;max-width:62%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.secure{display:flex;align-items:flex-start;gap:7px;margin-top:11px;padding:10px;border-radius:14px;border:1px solid rgba(75,221,163,.11);background:rgba(75,221,163,.05);font-size:8px;line-height:1.8;color:#9dbeb3}.secure .ico{width:16px;height:16px;color:var(--green);margin-top:1px}
.order{display:none;margin-top:11px;padding-top:11px;border-top:1px solid var(--line)}.order.show{display:block}.order-state{display:flex;gap:9px;align-items:center}.state-icon{width:39px;height:39px;border-radius:13px;display:grid;place-items:center;background:rgba(51,140,255,.09);color:#83c7ff}.state-icon .ico{width:19px;height:19px}.order-state b{font-size:9px}.order-state small{display:block;margin-top:4px;color:#7188a2;font-size:7px;direction:ltr;text-align:right}.progress{height:5px;border-radius:999px;background:#122138;overflow:hidden;margin:11px 0}.progress i{display:block;height:100%;background:linear-gradient(90deg,#338cff,#59c8ff);border-radius:999px;transition:.35s;width:20%}.order-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.meta{padding:9px;border-radius:12px;background:#081321;border:1px solid var(--line)}.meta small{display:block;font-size:7px;color:#627a95}.meta b{display:block;margin-top:4px;font-size:8px;direction:ltr;text-align:right}
.mobile-cta{display:none;position:fixed;z-index:30;right:10px;left:10px;bottom:max(9px,env(safe-area-inset-bottom));padding:8px;border-radius:20px;border:1px solid rgba(130,174,227,.17);background:rgba(7,15,26,.91);backdrop-filter:blur(22px);box-shadow:0 20px 55px rgba(0,0,0,.42);align-items:center;justify-content:space-between;gap:8px}.cta-copy{min-width:0;padding:3px 6px}.cta-copy small{display:block;color:#6e859f;font-size:7px}.cta-copy b{display:block;margin-top:4px;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mobile-cta .btn{height:48px;min-width:140px}
.toast{position:fixed;z-index:50;left:50%;bottom:86px;transform:translate(-50%,16px);opacity:0;pointer-events:none;transition:.2s;background:#e7f3ff;color:#07111f;padding:10px 13px;border-radius:13px;font:700 9px Tahoma;box-shadow:0 14px 34px rgba(0,0,0,.3);max-width:88%;text-align:center}.toast.show{opacity:1;transform:translate(-50%,0)}
.skeleton{animation:sk 1.2s ease-in-out infinite;background:linear-gradient(90deg,#0b1626,#122239,#0b1626);background-size:220% 100%}
@keyframes sk{to{background-position:-220% 0}}@keyframes floatCard{0%,100%{transform:rotateY(-12deg) rotateX(6deg) rotateZ(2deg) translateY(0)}50%{transform:rotateY(-8deg) rotateX(4deg) rotateZ(1deg) translateY(-8px)}}@keyframes rotateShine{to{transform:rotate(360deg)}}
@media(max-width:820px){.shell{padding:13px 13px 104px}.product{grid-template-columns:1fr;margin-top:29px}.visual{min-height:auto}.premium-card{width:100%;max-width:360px;height:154px;transform:none;animation:none}.floating{display:none}.product h1{font-size:35px}.product p{font-size:10px}.plans{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:0 -13px;padding:2px 13px 8px}.plans::-webkit-scrollbar{display:none}.plan{min-width:80vw;scroll-snap-align:center}.checkout{grid-template-columns:1fr}.summary{order:-1}.mobile-cta{display:flex}.icon-button .label{display:none}}
@media(max-width:430px){.product h1{font-size:33px}.plan{min-width:85vw}.actions{grid-template-columns:1fr}.step span{display:none}.order-grid{grid-template-columns:1fr 1fr}.premium-card{height:148px}.card-copy b{font-size:18px}}
</style>
</head>
<body>
<main class="shell">
<header class="topbar">
  <div class="brand"><div class="brand-logo"><img src="/brandmark.webp?v=6" alt=""></div><div class="brand-name">${BRAND_FA}<small>BLUE PREMIUM</small></div></div>
  <div class="top-actions">
    <a id="supportLink" class="icon-button" href="#" style="display:none">${ICON.headset}<span class="label">پشتیبانی</span></a>
    <button class="icon-button" onclick="goOrder()">${ICON.receipt}<span class="label">سفارش من</span></button>
  </div>
</header>

<section class="product">
  <div class="product-copy">
    <span class="online"><i class="online-dot"></i> سرویس فعال و آنلاین</span>
    <h1>تلگرام پرمیوم،<br><span>سریع و مطمئن.</span></h1>
    <p>پلن را انتخاب کن، حساب مقصد را بررسی کن و پرداخت را انجام بده. وضعیت فعال‌سازی از لحظه پرداخت تا تحویل، همین‌جا به‌صورت زنده نمایش داده می‌شود.</p>
    <div class="features">
      <span class="feature">${ICON.shield} پرداخت امن</span>
      <span class="feature">${ICON.bolt} پردازش سریع</span>
      <span class="feature">${ICON.refresh} قیمت به‌روز</span>
    </div>
  </div>
  <div class="visual">
    <div class="premium-card">
      <div class="card-brand"><img src="/brandmark.webp?v=6" alt=""></div>
      <div class="card-crown">${ICON.crown}</div>
      <div class="card-copy"><b>Telegram Premium</b><small>BLUE PREMIUM</small></div>
    </div>
    <div class="floating f1">${ICON.bolt}<span><b>پردازش سریع</b> پس از پرداخت</span></div>
    <div class="floating f2">${ICON.lock}<span><b>پرداخت امن</b> و محافظت‌شده</span></div>
  </div>
</section>

<div class="section-title"><div><h2>انتخاب پلن</h2><p>قیمت نهایی و به‌روز</p></div><span>۳، ۶ یا ۱۲ ماه</span></div>
<section id="plans" class="plans">
  <article class="plan skeleton"><div class="months">---</div><div class="type">در حال دریافت قیمت</div></article>
  <article class="plan skeleton"><div class="months">---</div><div class="type">در حال دریافت قیمت</div></article>
  <article class="plan skeleton"><div class="months">---</div><div class="type">در حال دریافت قیمت</div></article>
</section>

<section class="checkout" id="checkout">
  <article class="box">
    <h3>اطلاعات حساب مقصد</h3>
    <div class="hint">یوزرنیم تلگرام را وارد کن. قبل از ساخت فاکتور، حساب بررسی می‌شود.</div>
    <div class="steps">
      <div id="step1" class="step on"><i>1</i><span>پلن</span></div><div class="line"></div>
      <div id="step2" class="step"><i>2</i><span>حساب</span></div><div class="line"></div>
      <div id="step3" class="step"><i>3</i><span>پرداخت</span></div>
    </div>
    <div class="field">
      <label>یوزرنیم تلگرام</label>
      <div class="input-wrap"><span class="input-icon">${ICON.user}</span><input id="username" class="input" maxlength="32" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="telegram_username"></div>
    </div>
    <div id="account" class="account"><div id="avatar" class="avatar">T</div><div class="account-info"><b id="displayName">حساب تلگرام</b><small id="verifiedUser">@username</small></div><div class="account-check">${ICON.check}</div></div>
    <div class="actions"><button id="verify" class="btn secondary">${ICON.user}<span>بررسی حساب</span></button><button id="buy" class="btn primary" disabled>${ICON.card}<span>ساخت فاکتور</span></button></div>
    <div id="order" class="order"></div>
  </article>

  <aside class="box summary">
    <div>
      <div class="summary-head"><div><h3>خلاصه سفارش</h3><div class="hint">قبل از پرداخت قابل تغییر است</div></div><div class="summary-icon">${ICON.crown}</div></div>
      <div class="summary-rows">
        <div class="summary-row"><span>محصول</span><b>Telegram Premium</b></div>
        <div class="summary-row"><span>مدت</span><b id="sumMonths">---</b></div>
        <div class="summary-row"><span>مقصد</span><b id="sumUser">---</b></div>
        <div class="summary-row"><span>مبلغ نهایی</span><b id="sumPrice">---</b></div>
      </div>
    </div>
    <div class="secure">${ICON.shield}<span>فاکتور فقط بعد از تأیید حساب ساخته می‌شود و اطلاعات سرویس روی گوشی ذخیره نمی‌شود.</span></div>
  </aside>
</section>
</main>

<div class="mobile-cta">
  <div class="cta-copy"><small>پلن انتخاب‌شده</small><b id="ctaText">در حال دریافت قیمت</b></div>
  <button class="btn primary" onclick="document.getElementById('checkout').scrollIntoView({behavior:'smooth',block:'start'})">${ICON.arrow}<span>ادامه خرید</span></button>
</div>
<div id="toast" class="toast"></div>

<script>
const UI_VERSION='6.0.0';
const ICONS=${JSON.stringify(ICON)};
let plans=[],selected=null,current=null,verifiedUsername='',busy=false;
const el=id=>document.getElementById(id);
const money=n=>new Intl.NumberFormat('fa-IR').format(Number(n||0))+' تومان';
const esc=v=>String(v||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
function toast(t){const x=el('toast');x.textContent=t;x.classList.add('show');clearTimeout(window.__t);window.__t=setTimeout(()=>x.classList.remove('show'),2200)}
function currentPlan(){return plans.find(p=>Number(p.id)===Number(selected))}
function setStep(n){[1,2,3].forEach(i=>el('step'+i).classList.toggle('on',i<=n))}
function updateSummary(){const p=currentPlan();el('sumMonths').textContent=p?p.months+' ماه':'---';el('sumPrice').textContent=p?money(p.price_toman):'---';el('sumUser').textContent=verifiedUsername?'@'+verifiedUsername:'---';el('ctaText').textContent=p?p.months+' ماهه · '+money(p.price_toman):'فعلاً پلنی موجود نیست'}
function renderPlans(){if(!plans.length){el('plans').innerHTML='<article class="plan"><div class="months">---</div><div class="type">فعلاً پلن قابل خریدی وجود ندارد</div><div class="plan-note">قیمت‌ها باید توسط مدیر تنظیم شوند.</div></article>';updateSummary();return}selected=selected||plans[0].id;el('plans').innerHTML=plans.map(p=>'<article class="plan '+(Number(p.id)===Number(selected)?'active':'')+'" data-id="'+p.id+'"><span class="selector">'+ICONS.check+'</span><span class="plan-label">'+(Number(p.months)===6?'پیشنهاد ویژه':'Premium')+'</span><div class="months">'+p.months+' <small>ماه</small></div><div class="type">Telegram Premium</div><div class="price">'+money(p.price_toman)+'</div><div class="plan-note">پردازش سریع پس از پرداخت</div></article>').join('');document.querySelectorAll('.plan[data-id]').forEach(x=>x.onclick=()=>{selected=Number(x.dataset.id);renderPlans();updateSummary();setStep(verifiedUsername?2:1)});updateSummary()}
async function loadConfig(){try{const d=await fetch('/api/config?v='+UI_VERSION,{cache:'no-store'}).then(r=>r.json());const s=String(d.support||'').trim();if(s){const a=el('supportLink');a.href=s.startsWith('http')?s:'https://t.me/'+encodeURIComponent(s.replace(/^@/,''));a.style.display='inline-flex'}}catch(e){}}
async function load(){loadConfig();try{const d=await fetch('/api/plans?v='+UI_VERSION,{cache:'no-store'}).then(r=>r.json());plans=d.plans||[];renderPlans()}catch(e){el('plans').innerHTML='<article class="plan"><div class="months">---</div><div class="type">ارتباط با سرور برقرار نشد</div></article>'}try{const saved=localStorage.getItem('bp_order');if(saved){current=JSON.parse(saved);check()}}catch(e){}}
el('username').addEventListener('input',()=>{verifiedUsername='';el('account').classList.remove('show');el('buy').disabled=true;updateSummary();setStep(1)});
el('verify').onclick=async()=>{if(busy)return;const u=el('username').value.trim().replace(/^@+/,'');if(!/^[A-Za-z0-9_]{5,32}$/.test(u)){toast('یوزرنیم معتبر وارد کن');return}busy=true;el('verify').disabled=true;el('verify').querySelector('span').textContent='در حال بررسی';try{const d=await fetch('/api/telegram/lookup?username='+encodeURIComponent(u)+'&v='+UI_VERSION,{cache:'no-store'}).then(r=>r.json());if(!d.ok||d.found===false){toast('این حساب تلگرام پیدا نشد');return}if(d.premium_eligible===false){toast('این حساب فعلاً امکان دریافت Premium ندارد');return}verifiedUsername=u;el('displayName').textContent=d.display_name||u;el('verifiedUser').textContent='@'+u;el('avatar').textContent=String(d.display_name||u).trim().slice(0,1).toUpperCase();el('account').classList.add('show');el('buy').disabled=false;updateSummary();setStep(2);toast('حساب با موفقیت تأیید شد')}catch(e){toast('بررسی حساب ناموفق بود؛ دوباره تلاش کن')}finally{busy=false;el('verify').disabled=false;el('verify').querySelector('span').textContent='بررسی دوباره'}}
el('buy').onclick=async()=>{const p=currentPlan();if(!p){toast('اول یک پلن انتخاب کن');return}if(!verifiedUsername){toast('اول حساب تلگرام را بررسی کن');return}el('buy').disabled=true;el('buy').querySelector('span').textContent='در حال ساخت فاکتور';setStep(3);try{let did=localStorage.getItem('bp_device');if(!did){did=crypto.randomUUID();localStorage.setItem('bp_device',did)}const r=await fetch('/api/orders',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({plan_id:selected,username:verifiedUsername,device_id:did})});const d=await r.json();if(!d.ok){toast(errorText(d.error));setStep(2);return}current={code:d.order.code,token:d.order.token};localStorage.setItem('bp_order',JSON.stringify(current));showOrder(d.order,d.payment_url);setTimeout(()=>location.href=d.payment_url,450)}catch(e){toast('ارتباط با سرور قطع شد');setStep(2)}finally{el('buy').querySelector('span').textContent='ساخت فاکتور';el('buy').disabled=!verifiedUsername}}
async function check(){if(!current)return;try{const d=await fetch('/api/orders/'+encodeURIComponent(current.code)+'/check?token='+encodeURIComponent(current.token)+'&v='+UI_VERSION,{cache:'no-store'}).then(r=>r.json());if(d.ok){showOrder(d.order,d.order.payment_url);if(!['delivered','failed','payment_mismatch'].includes(d.order.status))setTimeout(check,5000)}}catch(e){}}
function progress(s){return ({creating_payment:15,awaiting_payment:30,paid:55,awaiting_approval:62,processing:70,provider_pending:84,delivered:100,payment_error:25,payment_mismatch:45,failed:80})[s]||20}
function stateIcon(s){if(s==='delivered')return ICONS.check;if(['failed','payment_error','payment_mismatch'].includes(s))return ICONS.alert;if(['processing','provider_pending','paid'].includes(s))return ICONS.refresh;return ICONS.clock}
function showOrder(o,pay){const x=el('order');x.className='order show';const payBtn=pay?'<a class="btn primary" style="margin-top:9px" href="'+pay+'">'+ICONS.card+'<span>ادامه پرداخت</span></a>':'';x.innerHTML='<div class="order-state"><div class="state-icon">'+stateIcon(o.status)+'</div><div><b>'+esc(o.message)+'</b><small>'+esc(o.code)+'</small></div></div><div class="progress"><i style="width:'+progress(o.status)+'%"></i></div><div class="order-grid"><div class="meta"><small>مقصد</small><b>@'+esc(o.username)+'</b></div><div class="meta"><small>پلن</small><b>'+o.months+' ماهه</b></div><div class="meta"><small>مبلغ</small><b>'+money(o.price_toman)+'</b></div><div class="meta"><small>وضعیت</small><b>'+esc(o.message)+'</b></div></div>'+payBtn}
function goOrder(){el('checkout').scrollIntoView({behavior:'smooth',block:'start'});if(current)check();else toast('هنوز سفارشی روی این دستگاه ثبت نشده')}
function errorText(e){return ({invalid_username:'یوزرنیم معتبر نیست.',telegram_user_not_found:'حساب تلگرام پیدا نشد.',not_premium_eligible:'این حساب امکان دریافت پرمیوم ندارد.',payment_not_configured:'درگاه پرداخت هنوز فعال نشده است.',plan_unavailable:'این پلن فعلاً قابل خرید نیست.',payment_create_failed:'ساخت لینک پرداخت انجام نشد.'})[e]||'ثبت سفارش انجام نشد؛ دوباره تلاش کن.'}
load();
</script>
</body>
</html>`;
}
