
function storeHtmlV2() {
  return \`<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07111f">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon.svg">
<title>\${BRAND_FA} | \${BRAND}</title>
<style>
:root{color-scheme:dark;--bg:#050912;--panel:#0b1422;--panel2:#101c2d;--line:rgba(150,185,230,.13);--text:#f8fbff;--muted:#8da2bb;--blue:#2f86ff;--cyan:#58c8ff;--gold:#f5c86b;--green:#42d99a;--red:#ff6d7a;--shadow:0 24px 70px rgba(0,35,90,.35)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;font-family:Tahoma,"Segoe UI",system-ui,sans-serif;background:
radial-gradient(700px 420px at 90% -5%,rgba(39,121,255,.28),transparent 62%),
radial-gradient(520px 420px at -10% 35%,rgba(0,193,255,.12),transparent 65%),
linear-gradient(180deg,#07101d 0%,#050912 52%,#050912 100%);color:var(--text);overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:28px 28px;mask-image:linear-gradient(#000,transparent 75%)}
.shell{width:min(1120px,100%);margin:auto;padding:18px 18px 118px;position:relative}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:max(4px,env(safe-area-inset-top))}
.brand{display:flex;align-items:center;gap:11px}.brandmark{width:46px;height:46px;border-radius:16px;display:grid;place-items:center;background:linear-gradient(145deg,#2f8cff,#0c4dcc);box-shadow:0 14px 32px rgba(26,111,255,.35),inset 0 1px rgba(255,255,255,.3);font-size:23px;font-weight:900;position:relative;overflow:hidden}.brandmark:after{content:"";position:absolute;width:42px;height:12px;background:linear-gradient(90deg,transparent,rgba(255,214,117,.8),transparent);transform:rotate(-35deg);top:6px;left:-18px}.brandname{font-size:16px;font-weight:900;letter-spacing:-.3px}.brandname small{display:block;color:var(--muted);font-size:10px;font-weight:500;margin-top:3px;direction:ltr;text-align:right;letter-spacing:.8px}.top-action{display:flex;gap:8px}.iconbtn{height:42px;border:1px solid var(--line);border-radius:14px;background:rgba(12,24,40,.72);color:#cfe3ff;padding:0 13px;display:inline-flex;align-items:center;gap:7px;text-decoration:none;font:700 11px Tahoma;backdrop-filter:blur(14px)}
.hero{padding:42px 0 22px;display:grid;grid-template-columns:1.3fr .7fr;gap:20px;align-items:center}.hero-copy{position:relative}.eyebrow{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;border:1px solid rgba(84,171,255,.22);background:rgba(18,77,143,.15);color:#a9d8ff;font-size:10px;font-weight:700}.pulse{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(66,217,154,.1)}.hero h1{font-size:clamp(34px,7vw,62px);line-height:1.18;margin:16px 0 10px;letter-spacing:-2px}.hero h1 span{background:linear-gradient(95deg,#eaf6ff 10%,#68c7ff 55%,#4d8cff);-webkit-background-clip:text;color:transparent}.hero p{margin:0;max-width:690px;color:#9db0c7;font-size:13px;line-height:2.05}.hero-visual{min-height:230px;position:relative;display:grid;place-items:center}.orb{width:190px;height:190px;border-radius:48px;transform:rotate(10deg);background:linear-gradient(145deg,rgba(54,146,255,.95),rgba(12,54,145,.95));box-shadow:0 40px 80px rgba(10,75,180,.45),inset 0 1px rgba(255,255,255,.4);display:grid;place-items:center;position:relative;animation:float 5s ease-in-out infinite}.orb:before,.orb:after{content:"";position:absolute;border-radius:999px;border:1px solid rgba(255,255,255,.24)}.orb:before{inset:22px}.orb:after{inset:45px}.diamond{font-size:76px;filter:drop-shadow(0 12px 20px rgba(0,0,0,.2));transform:rotate(-10deg)}.spark{position:absolute;color:var(--gold);font-size:24px}.spark.s1{top:8px;right:20px}.spark.s2{bottom:18px;left:8px;font-size:15px}.float-chip{position:absolute;padding:9px 12px;background:rgba(7,16,29,.78);border:1px solid var(--line);border-radius:15px;backdrop-filter:blur(14px);font-size:10px;color:#cfe0f6;box-shadow:0 14px 30px rgba(0,0,0,.22)}.chip-a{right:-5px;bottom:26px}.chip-b{left:0;top:26px}.float-chip b{color:#fff}
.trust{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.trust span{display:inline-flex;align-items:center;gap:6px;padding:8px 10px;border-radius:12px;background:rgba(255,255,255,.035);border:1px solid var(--line);color:#aabbd0;font-size:10px}
.section-title{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:20px 0 11px}.section-title h2{margin:0;font-size:17px}.section-title p{margin:0;color:var(--muted);font-size:10px}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.plan{position:relative;min-height:178px;border:1px solid var(--line);background:linear-gradient(155deg,rgba(18,31,51,.9),rgba(8,16,29,.94));border-radius:25px;padding:18px;cursor:pointer;overflow:hidden;transition:transform .22s,border-color .22s,box-shadow .22s}.plan:after{content:"";position:absolute;width:110px;height:110px;border-radius:50%;background:radial-gradient(circle,rgba(63,157,255,.18),transparent 67%);left:-30px;bottom:-30px}.plan:hover{transform:translateY(-3px)}.plan.active{border-color:rgba(74,157,255,.7);box-shadow:0 16px 45px rgba(21,93,210,.2),inset 0 0 0 1px rgba(79,162,255,.18)}.plan.active .selector{background:var(--blue);border-color:var(--blue)}.selector{position:absolute;top:17px;left:17px;width:20px;height:20px;border-radius:50%;border:1px solid #3b536f;display:grid;place-items:center;font-size:11px;color:white}.badge{display:inline-flex;padding:6px 8px;border-radius:999px;font-size:9px;font-weight:800;background:rgba(245,200,107,.12);color:#f7d78f;border:1px solid rgba(245,200,107,.2);margin-bottom:13px}.months{font-size:28px;font-weight:900;letter-spacing:-1px}.months small{font-size:11px;color:var(--muted);font-weight:500}.plan-sub{font-size:10px;color:var(--muted);margin-top:3px}.price{margin-top:20px;font-size:21px;font-weight:900}.price small{font-size:10px;color:#8296ae;font-weight:500}.saving{font-size:9px;color:#7cc4ff;margin-top:5px}
.checkout{display:grid;grid-template-columns:1.15fr .85fr;gap:12px;margin-top:14px}.card{border:1px solid var(--line);background:linear-gradient(160deg,rgba(12,23,39,.95),rgba(7,14,25,.95));border-radius:25px;padding:19px;box-shadow:0 20px 55px rgba(0,0,0,.14)}.card h3{margin:0 0 6px;font-size:16px}.hint{color:var(--muted);font-size:10px;line-height:1.9}.steps{display:flex;align-items:center;gap:5px;margin:16px 0}.step{display:flex;align-items:center;gap:6px;color:#6e829b;font-size:9px;white-space:nowrap}.step i{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#101d2d;border:1px solid var(--line);font-style:normal}.step.on{color:#bfe1ff}.step.on i{background:#126df0;border-color:#2c8cff;color:white}.line{height:1px;flex:1;background:var(--line)}
.field{position:relative;margin-top:10px}.field label{display:block;color:#a9bbd0;font-size:10px;margin:0 3px 7px}.inputwrap{display:flex;align-items:center;border:1px solid #203552;background:#07101c;border-radius:17px;padding:0 13px;transition:.2s}.inputwrap:focus-within{border-color:#388cff;box-shadow:0 0 0 4px rgba(47,134,255,.09)}.prefix{direction:ltr;color:#6e8bad;font-weight:800}.input{width:100%;height:52px;border:0;background:transparent;color:#fff;outline:0;font:700 14px "Segoe UI",Tahoma;direction:ltr;text-align:left;padding:0 7px}.btn{height:52px;border:0;border-radius:17px;background:linear-gradient(100deg,#126bfb,#2aa9ff);color:white;font:800 12px Tahoma;padding:0 18px;cursor:pointer;box-shadow:0 14px 30px rgba(25,111,255,.27);transition:.18s}.btn:active{transform:scale(.985)}.btn:disabled{opacity:.48;box-shadow:none;cursor:not-allowed}.btn.secondary{background:#101d2d;border:1px solid var(--line);box-shadow:none;color:#c9d9ec}.actionrow{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:11px}
.profile{display:none;align-items:center;gap:10px;margin-top:11px;padding:11px;border-radius:16px;background:rgba(55,152,255,.08);border:1px solid rgba(72,161,255,.17)}.profile.show{display:flex}.avatar{width:39px;height:39px;border-radius:13px;background:linear-gradient(145deg,#2389ff,#164bb4);display:grid;place-items:center;font-weight:900}.profile b{font-size:11px}.profile small{display:block;color:var(--muted);font-size:9px;margin-top:4px}.verified{margin-right:auto;color:var(--green);font-size:18px}
.summary{display:flex;flex-direction:column;justify-content:space-between}.summary-head{display:flex;justify-content:space-between;align-items:center}.summary-icon{width:42px;height:42px;border-radius:14px;background:rgba(48,140,255,.12);display:grid;place-items:center;font-size:20px}.summary-list{margin-top:15px;border-top:1px solid var(--line)}.sumrow{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px dashed var(--line);font-size:10px;color:var(--muted)}.sumrow b{color:#edf6ff;font-size:11px}.secure{margin-top:13px;padding:11px;border-radius:15px;background:rgba(66,217,154,.065);border:1px solid rgba(66,217,154,.13);font-size:9px;line-height:1.8;color:#a6c7bc}
.orderbox{display:none;margin-top:13px}.orderbox.show{display:block}.order-head{display:flex;align-items:center;gap:10px}.stateicon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:rgba(47,134,255,.12);font-size:20px}.order-head b{font-size:12px}.order-head small{display:block;color:var(--muted);font-size:9px;margin-top:4px}.progress{height:5px;border-radius:999px;background:#142137;overflow:hidden;margin:15px 0}.progress i{display:block;height:100%;width:20%;border-radius:inherit;background:linear-gradient(90deg,#2f86ff,#56caff);transition:width .35s}.order-meta{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.meta{padding:10px;border-radius:14px;background:#091321;border:1px solid var(--line)}.meta small{display:block;color:#6f849e;font-size:8px}.meta b{display:block;font-size:10px;margin-top:5px;direction:ltr;text-align:right}.paylink{display:flex;align-items:center;justify-content:center;text-decoration:none;margin-top:10px}
.bottom{display:none;position:fixed;z-index:30;right:12px;left:12px;bottom:max(10px,env(safe-area-inset-bottom));height:68px;border-radius:22px;border:1px solid rgba(147,185,232,.16);background:rgba(7,15,26,.86);backdrop-filter:blur(22px);box-shadow:0 20px 55px rgba(0,0,0,.42);padding:8px}.bottom button{flex:1;border:0;background:transparent;color:#879bb3;font:700 9px Tahoma;border-radius:15px}.bottom button.on{background:#11213a;color:#d9ecff}.toast{position:fixed;z-index:50;left:50%;bottom:94px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#dfeeff;color:#07111f;padding:10px 14px;border-radius:14px;font:700 10px Tahoma;box-shadow:0 12px 35px rgba(0,0,0,.3);transition:.22s;max-width:85%;text-align:center}.toast.show{opacity:1;transform:translate(-50%,0)}
.skeleton{animation:pulsebg 1.3s ease-in-out infinite;background:linear-gradient(90deg,#0c1727,#132237,#0c1727);background-size:200% 100%}
@keyframes float{0%,100%{transform:rotate(10deg) translateY(0)}50%{transform:rotate(7deg) translateY(-9px)}}@keyframes pulsebg{0%{background-position:0 0}100%{background-position:-200% 0}}
@media(max-width:820px){.hero{grid-template-columns:1fr}.hero-visual{display:none}.hero{padding-top:34px}.checkout{grid-template-columns:1fr}.plans{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding:2px 2px 8px;margin:0 -18px;padding-right:18px;scrollbar-width:none}.plans::-webkit-scrollbar{display:none}.plan{min-width:78vw;scroll-snap-align:center}.bottom{display:flex}.shell{padding-bottom:100px}.top-action .support-text{display:none}.hero h1{font-size:39px}.order-meta{grid-template-columns:1fr 1fr}}
@media(max-width:430px){.shell{padding-left:14px;padding-right:14px}.plan{min-width:84vw}.hero h1{font-size:35px}.actionrow{grid-template-columns:1fr}.steps{gap:3px}.step span{display:none}}
</style>
</head>
<body>
<main class="shell">
<header class="topbar">
  <div class="brand"><div class="brandmark">B</div><div class="brandname">\${BRAND_FA}<small>BLUE PREMIUM</small></div></div>
  <div class="top-action"><a id="supportLink" class="iconbtn" href="#" style="display:none">💬 <span class="support-text">پشتیبانی</span></a><button class="iconbtn" onclick="scrollToOrder()">🧾 سفارش من</button></div>
</header>

<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow"><i class="pulse"></i> فعال‌سازی خودکار و امن</span>
    <h1>تلگرام پرمیوم،<br><span>بدون دردسر.</span></h1>
    <p>پلن را انتخاب کن، یوزرنیم را بررسی کن و پرداخت را انجام بده. وضعیت سفارش لحظه‌به‌لحظه داخل همین اپ به‌روزرسانی می‌شود.</p>
    <div class="trust"><span>⚡ پردازش خودکار</span><span>🔒 پرداخت امن BluePal</span><span>🎁 تحویل از TG Tools</span></div>
  </div>
  <div class="hero-visual">
    <div class="orb"><span class="spark s1">✦</span><div class="diamond">💎</div><span class="spark s2">✦</span></div>
    <div class="float-chip chip-a">⚡ <b>فعال‌سازی سریع</b></div>
    <div class="float-chip chip-b">✓ <b>بررسی یوزرنیم</b></div>
  </div>
</section>

<div class="section-title"><div><h2>انتخاب پلن</h2><p>قیمت نهایی و به‌روز</p></div><p>۳ / ۶ / ۱۲ ماهه</p></div>
<section id="plans" class="plans">
  <div class="plan skeleton"><div class="months">•••</div><div class="plan-sub">در حال دریافت قیمت‌ها</div></div>
  <div class="plan skeleton"><div class="months">•••</div><div class="plan-sub">در حال دریافت قیمت‌ها</div></div>
  <div class="plan skeleton"><div class="months">•••</div><div class="plan-sub">در حال دریافت قیمت‌ها</div></div>
</section>

<section class="checkout">
  <article class="card">
    <h3>شروع خرید</h3>
    <div class="hint">قبل از ساخت فاکتور، حساب تلگرام مقصد را بررسی می‌کنیم.</div>
    <div class="steps"><div id="st1" class="step on"><i>1</i><span>پلن</span></div><div class="line"></div><div id="st2" class="step"><i>2</i><span>حساب</span></div><div class="line"></div><div id="st3" class="step"><i>3</i><span>پرداخت</span></div></div>
    <div class="field"><label>یوزرنیم تلگرام مقصد</label><div class="inputwrap"><span class="prefix">@</span><input id="username" class="input" maxlength="32" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="username"></div></div>
    <div id="profile" class="profile"><div id="avatar" class="avatar">T</div><div><b id="profileName">حساب تلگرام</b><small id="profileUser">@username</small></div><div class="verified">✓</div></div>
    <div class="actionrow"><button id="verifyBtn" class="btn secondary">بررسی حساب</button><button id="buy" class="btn" disabled>ساخت فاکتور و پرداخت</button></div>
    <div id="orderBox" class="orderbox"></div>
  </article>

  <aside class="card summary">
    <div>
      <div class="summary-head"><div><h3>خلاصه سفارش</h3><div class="hint">قبل از پرداخت دوباره بررسی کن</div></div><div class="summary-icon">👑</div></div>
      <div class="summary-list">
        <div class="sumrow"><span>محصول</span><b>Telegram Premium</b></div>
        <div class="sumrow"><span>مدت</span><b id="sumMonths">—</b></div>
        <div class="sumrow"><span>مقصد</span><b id="sumUser">—</b></div>
        <div class="sumrow"><span>مبلغ نهایی</span><b id="sumPrice">—</b></div>
      </div>
    </div>
    <div class="secure">🔐 پرداخت فقط بعد از تأیید حساب ساخته می‌شود. اطلاعات API و تأمین‌کننده در دستگاه شما ذخیره نمی‌شود.</div>
  </aside>
</section>
</main>

<nav class="bottom"><button class="on" onclick="window.scrollTo({top:0,behavior:'smooth'})">⌂<br>خانه</button><button onclick="document.getElementById('plans').scrollIntoView({behavior:'smooth'})">♛<br>پلن‌ها</button><button onclick="scrollToOrder()">◎<br>سفارش</button></nav>
<div id="toast" class="toast"></div>

<script>
let plans=[],selected=null,current=null,verifiedUsername='',checking=false;
const el=id=>document.getElementById(id);
const money=n=>new Intl.NumberFormat('fa-IR').format(Number(n||0))+' تومان';
function toast(t){const x=el('toast');x.textContent=t;x.classList.add('show');clearTimeout(window.__tt);window.__tt=setTimeout(()=>x.classList.remove('show'),2400)}
function initials(v){return String(v||'T').trim().slice(0,1).toUpperCase()}
function selectedPlan(){return plans.find(p=>Number(p.id)===Number(selected))}
function updateSummary(){const p=selectedPlan();el('sumMonths').textContent=p?p.months+' ماه':'—';el('sumPrice').textContent=p?money(p.price_toman):'—';el('sumUser').textContent=verifiedUsername?'@'+verifiedUsername:'—'}
function setStep(n){[1,2,3].forEach(i=>el('st'+i).classList.toggle('on',i<=n))}
function renderPlans(){if(!plans.length){el('plans').innerHTML='<div class="plan"><div class="months">—</div><div class="plan-sub">فعلاً قیمت فعالی وجود ندارد</div><div class="saving">مدیر باید APIها یا قیمت دستی را تنظیم کند.</div></div>';updateSummary();return}selected=selected||plans[0].id;el('plans').innerHTML=plans.map(p=>{const rec=Number(p.months)===6?'<span class="badge">پیشنهاد محبوب</span>':'<span class="badge" style="visibility:hidden">پلن</span>';return '<article class="plan '+(Number(p.id)===Number(selected)?'active':'')+'" data-id="'+p.id+'"><span class="selector">✓</span>'+rec+'<div class="months">'+p.months+' <small>ماه</small></div><div class="plan-sub">Telegram Premium</div><div class="price">'+money(p.price_toman)+'</div><div class="saving">فعال‌سازی خودکار پس از پرداخت</div></article>'}).join('');document.querySelectorAll('.plan[data-id]').forEach(x=>x.onclick=()=>{selected=Number(x.dataset.id);renderPlans();updateSummary();setStep(verifiedUsername?2:1)});updateSummary()}
async function loadConfig(){try{const d=await fetch('/api/config').then(r=>r.json());const s=String(d.support||'').trim();if(s){const a=el('supportLink');const u=s.replace(/^@/,'');a.href=s.startsWith('http')?s:'https://t.me/'+encodeURIComponent(u);a.style.display='inline-flex'}}catch(e){}}
async function load(){loadConfig();try{const d=await fetch('/api/plans').then(r=>r.json());plans=d.plans||[];renderPlans()}catch(e){el('plans').innerHTML='<div class="plan"><div class="months">!</div><div class="plan-sub">ارتباط با سرور برقرار نشد</div></div>'}try{const saved=localStorage.getItem('bp_order');if(saved){current=JSON.parse(saved);check()}}catch(e){}}
el('username').addEventListener('input',()=>{verifiedUsername='';el('profile').classList.remove('show');el('buy').disabled=true;updateSummary();setStep(1)});
el('verifyBtn').onclick=verifyUser;
async function verifyUser(){if(checking)return;const u=el('username').value.trim().replace(/^@+/,'');if(!/^[A-Za-z0-9_]{5,32}$/.test(u)){toast('یوزرنیم معتبر وارد کن');return}checking=true;el('verifyBtn').disabled=true;el('verifyBtn').textContent='در حال بررسی…';try{const d=await fetch('/api/telegram/lookup?username='+encodeURIComponent(u)).then(r=>r.json());if(!d.ok||d.found===false){toast('این یوزرنیم در تلگرام پیدا نشد');return}if(d.premium_eligible===false){toast('این حساب فعلاً امکان دریافت Premium ندارد');return}verifiedUsername=u;el('profileName').textContent=d.display_name||u;el('profileUser').textContent='@'+u;el('avatar').textContent=initials(d.display_name||u);el('profile').classList.add('show');el('buy').disabled=false;updateSummary();setStep(2);toast('حساب با موفقیت تأیید شد ✓')}catch(e){toast('بررسی حساب انجام نشد؛ دوباره تلاش کن')}finally{checking=false;el('verifyBtn').disabled=false;el('verifyBtn').textContent='بررسی دوباره'}}
el('buy').onclick=async()=>{const p=selectedPlan();if(!p){toast('ابتدا یک پلن انتخاب کن');return}if(!verifiedUsername){toast('ابتدا حساب تلگرام را بررسی کن');return}el('buy').disabled=true;el('buy').textContent='در حال ساخت فاکتور…';setStep(3);try{let did=localStorage.getItem('bp_device');if(!did){did=crypto.randomUUID();localStorage.setItem('bp_device',did)}const r=await fetch('/api/orders',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({plan_id:selected,username:verifiedUsername,device_id:did})});const d=await r.json();if(!d.ok){toast(errorText(d.error));setStep(2);return}current={code:d.order.code,token:d.order.token};localStorage.setItem('bp_order',JSON.stringify(current));showOrder(d.order,d.payment_url);setTimeout(()=>location.href=d.payment_url,450)}catch(e){toast('خطا در ارتباط با سرور');setStep(2)}finally{el('buy').textContent='ساخت فاکتور و پرداخت';el('buy').disabled=!verifiedUsername}}
async function check(){if(!current)return;try{const d=await fetch('/api/orders/'+encodeURIComponent(current.code)+'/check?token='+encodeURIComponent(current.token)).then(r=>r.json());if(d.ok){showOrder(d.order,d.order.payment_url);if(!['delivered','failed','payment_mismatch'].includes(d.order.status))setTimeout(check,5000)}}catch(e){}}
function statusProgress(s){return ({creating_payment:15,awaiting_payment:30,paid:55,processing:70,provider_pending:84,delivered:100,payment_error:25,payment_mismatch:45,failed:80})[s]||20}
function statusIcon(s){return s==='delivered'?'✓':(['failed','payment_error','payment_mismatch'].includes(s)?'!':'⟳')}
function showOrder(o,pay){const box=el('orderBox');box.className='orderbox show';const extra=pay?'<a class="btn paylink" href="'+pay+'">ادامه پرداخت</a>':'';box.innerHTML='<div class="order-head"><div class="stateicon">'+statusIcon(o.status)+'</div><div><b>'+escapeHtml(o.message)+'</b><small>'+escapeHtml(o.code)+'</small></div></div><div class="progress"><i style="width:'+statusProgress(o.status)+'%"></i></div><div class="order-meta"><div class="meta"><small>مقصد</small><b>@'+escapeHtml(o.username)+'</b></div><div class="meta"><small>پلن</small><b>'+o.months+' ماهه</b></div><div class="meta"><small>مبلغ</small><b>'+money(o.price_toman)+'</b></div><div class="meta"><small>وضعیت</small><b>'+escapeHtml(o.message)+'</b></div></div>'+extra}
function scrollToOrder(){const box=el('orderBox');if(current){box.scrollIntoView({behavior:'smooth',block:'center'});check()}else{document.querySelector('.checkout').scrollIntoView({behavior:'smooth'});toast('هنوز سفارشی روی این دستگاه ثبت نشده')}}
function escapeHtml(v){return String(v||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function errorText(e){return ({invalid_username:'یوزرنیم معتبر نیست.',telegram_user_not_found:'این یوزرنیم در تلگرام پیدا نشد.',not_premium_eligible:'این حساب امکان دریافت پرمیوم ندارد.',payment_not_configured:'درگاه پرداخت هنوز فعال نشده است.',plan_unavailable:'این پلن فعلاً قابل خرید نیست.',payment_create_failed:'ساخت لینک پرداخت انجام نشد.'})[e]||'ثبت سفارش انجام نشد؛ دوباره تلاش کن.'}
if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{});
load();
</script>
</body></html>\`;
}
