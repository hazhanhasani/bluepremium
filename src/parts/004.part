B, 'profit_percent', '15'), 0, 500);
  const rounding = Math.max(100, Number(await getSetting(env.DB, 'rounding', '1000')) || 1000);
  const now = new Date().toISOString();
  for (const months of ALLOWED_MONTHS) {
    const ton = Number(pd[`premium_${months}m_ton`] || 0);
    if (!(ton > 0)) continue;
    const auto = roundUp(ton * tonToman * (1 + profit / 100), rounding);
    const current = await env.DB.prepare(`SELECT manual_price_toman FROM plans WHERE months=?`).bind(months).first();
    const chosen = Number(current?.manual_price_toman || auto);
    await env.DB.prepare(`UPDATE plans SET wholesale_ton=?, auto_price_toman=?, price_toman=?, updated_at=? WHERE months=?`)
      .bind(ton, auto, chosen, now, months).run();
  }
  await setSetting(env.DB, 'last_ton_toman', String(tonToman));
  await setSetting(env.DB, 'last_price_sync', now);
  return { ok: true, ton_toman: tonToman, profit_percent: profit };
}

async function providerHealth(env) {
  const [tgKey, blupalKey, paymentProvider, bazaarEnabled, blupalEnabled, rsaKey, sku3, sku6, sku12] = await Promise.all([
    getProviderSecret(env, 'tgtools_api_key'),
    getProviderSecret(env, 'blupal_api_key'),
    getSetting(env.DB, 'payment_provider', 'blupal'),
    getSetting(env.DB, 'cafebazaar_enabled', '0'),
    getSetting(env.DB, 'blupal_enabled', '1'),
    getSetting(env.DB, 'bazaar_rsa_public_key', ''),
    getSetting(env.DB, 'bazaar_sku_3', ''),
    getSetting(env.DB, 'bazaar_sku_6', ''),
    getSetting(env.DB, 'bazaar_sku_12', ''),
  ]);
  const bazaarConfigured = !!String(rsaKey).trim() && !!String(sku3).trim() && !!String(sku6).trim() && !!String(sku12).trim();
  const out = {
    tgtools: { configured: !!tgKey, ok: false, balance_ton: null, wallet_address: '', http_status: 0, error: '' },
    cafebazaar: {
      configured: bazaarConfigured,
      ok: String(paymentProvider) === 'cafebazaar' && String(bazaarEnabled) === '1' && bazaarConfigured,
      active: String(paymentProvider) === 'cafebazaar' && String(bazaarEnabled) === '1',
      sku_3: String(sku3 || ''),
      sku_6: String(sku6 || ''),
      sku_12: String(sku12 || ''),
    },
    blupal: {
      configured: !!blupalKey,
      ok: !!blupalKey && String(blupalEnabled) === '1' && String(paymentProvider) === 'blupal',
      active: String(blupalEnabled) === '1' && String(paymentProvider) === 'blupal',
    },
  };
  if (tgKey) {
    const wallet = await tgRequest(tgKey, 'GET', '/api/wallet');
    out.tgtools.ok = wallet.ok;
    out.tgtools.http_status = Number(wallet.http_status || 0);
    out.tgtools.error = wallet.ok ? '' : safeProviderMessage(wallet.message || 'wallet_check_failed');
    const d = wallet.data || {};
    out.tgtools.balance_ton = firstNumber(d, ['balanceTon','tonBalance','availableTon','availableBalance','walletBalance','balance']);
    out.tgtools.wallet_address = firstString(d, ['depositAddress','walletAddress','tonAddress','address']);
  }
  out.telegram_bot = await telegramBotHealth(env);
  out.telegram_bot.webhook_url = String(await getSetting(env.DB, 'telegram_bot_webhook_url', ''));
  return out;
}

async function tgRequest(apiKey, method, path, payload = null, auth = true) {
  const headers = { accept: 'application/json', 'content-type': 'application/json' };
  if (auth) {
    if (!apiKey) return { ok: false, http_status: 0, data: {}, message: 'not_configured' };
    // TGTools documents both authentication forms. Send both for compatibility
    // with proxies that may strip custom headers.
    headers['X-Api-Key'] = apiKey;
    headers['Authorization'] = 'Bearer ' + apiKey;
  }
  try {
    const response = await fetch(`${TG_BASE}${path}`, {
      method,
      headers,
      body: payload == null || method === 'GET' ? undefined : JSON.stringify(payload),
    });
    const raw = await response.json().catch(() => ({}));
    const success = !Object.prototype.hasOwnProperty.call(raw, 'isSuccess') || !!raw.isSuccess;
    const data = raw && typeof raw.data === 'object' && raw.data !== null ? raw.data : raw;
    const message = String(raw.message || data.message || data.error || '');
    return { ok: response.ok && success, http_status: response.status, data, message, raw };
  } catch (error) {
    return { ok: false, http_status: 0, data: {}, message: String(error?.message || 'network_error') };
  }
}

async function blupalRequest(apiKey, method, path, payload = null) {
  if (!apiKey) return { ok: false, http_status: 0, data: {}, message: 'not_configured' };
  try {
    const response = await fetch(`${BLUPAL_BASE}${path}`, {
      method,
      headers: { accept: 'application/json', 'content-type': 'application/json', 'X-API-Key': apiKey },
      body: payload == null || method === 'GET' ? undefined : JSON.stringify(payload),
      redirect: 'manual',
    });
    const raw = await response.json().catch(() => ({}));
    const ok = response.ok && raw.success !== false;
    const data = raw && typeof raw.data === 'object' && raw.data !== null ? raw.data : raw;
    return { ok, http_status: response.status, data, raw, message: String(raw.message || raw.error || '') };
  } catch (error) {
    return { ok: false, http_status: 0, data: {}, message: String(error?.message || 'network_error') };
  }
}

function blupalInvoiceFields(payload, expectedRial = 0) {
  const root = payload && typeof payload === 'object' ? payload : {};
  const data = root.data && typeof root.data === 'object' ? root.data : root;
  const invoiceId = String(data.invoice_id ?? root.invoice_id ?? '').trim();
  const paymentLink = String(data.payment_link ?? root.payment_link ?? data.url ?? root.url ?? '').trim();
  const cardNumber = String(
    data.card_number ?? data.cardNumber ?? data.card ??
    root.card_number ?? root.cardNumber ?? root.card ?? ''
  ).replace(/\D+/g, '').slice(0, 19);
  const amountRial = Number(data.amount ?? root.amount ?? expectedRial ?? 0);
  const finalAmountRial = Number(
    data.final_amount ?? data.finalAmount ??
    root.final_amount ?? root.finalAmount ??
    amountRial ?? 0
  );
  const expiresAt = String(data.expires_at ?? data.expiresAt ?? root.expires_at ?? root.expiresAt ?? '').trim();
  const status = String(data.status ?? root.status ?? '').trim().toUpperCase();
  return {
    invoice_id: invoiceId,
    payment_link: paymentLink,
    card_number: cardNumber,
    amount_rial: Number.isFinite(amountRial) ? Math.round(amountRial) : 0,
    final_amount_rial: Number.isFinite(finalAmountRial) ? Math.round(finalAmountRial) : 0,
    expires_at: expiresAt,
    status,
  };
}

function publicPaymentInstructions(order) {
  if (!order || order.status !== 'awaiting_payment') return null;
  const card = String(order.blupal_card_number || '').replace(/\D+/g, '');
  const amountRial = Number(order.blupal_final_amount_rial || 0);
  if (!card || !Number.isFinite(amountRial) || amountRial <= 0) return null;
  return {
    type: 'card_transfer',
    card_number: card,
    amount_rial: Math.round(amountRial),
    expires_at: order.blupal_expires_at || null,
  };
}

async function getAuthorizedOrder(db, code, token) {
  const order = await db.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(code).first();
  if (!order) return null;
  const hash = await sha256Hex(token);
  return timingSafeEqual(hash, String(order.public_token_hash || '')) ? order : null;
}

function publicOrder(order) {
  const provider = String(order.payment_provider || (order.blupal_invoice_id ? 'blupal' : 'cafebazaar'));
  return {
    code: order.order_code,
    username: order.username,
    months: Number(order.months),
    price_toman: Number(order.price_toman),
    status: order.status,
    created_at: order.created_at,
    updated_at: order.updated_at,
    delivered_at: order.delivered_at || null,
    payment_method: provider === 'blupal' ? 'card_transfer' : provider,
    payment_instructions: provider === 'blupal' ? publicPaymentInstructions(order) : null,
    bazaar_product_id: order.status === 'awaiting_bazaar_payment' ? String(order.bazaar_product_id || '') : null,
    bazaar_consumed: Number(order.bazaar_consumed || 0) === 1,
    message: customerStatusMessage(order.status),
  };
}

function customerStatusMessage(status) {
  return ({
    creating_payment: 'در حال آماده‌سازی اطلاعات پرداخت',
    awaiting_payment: 'در انتظار پرداخت',
    awaiting_bazaar_payment: 'در انتظار پرداخت با کافه‌بازار',
    paid: 'پرداخت تایید شد',
    awaiting_approval: 'پرداخت تایید شد؛ منتظر تایید مدیریت',
    provider_submitting: 'در حال ارسال سفارش به TG Tools',
    provider_uncertain: 'ارسال سفارش نیاز به بررسی مدیریت دارد',
    processing: 'در حال فعال‌سازی پرمیوم',
    provider_pending: 'در حال پردازش توسط سرویس فعال‌سازی',
    delivered: 'پرمیوم با موفقیت فعال شد',
    payment_error: 'ساخت پرداخت ناموفق بود',
    payment_mismatch: 'پرداخت نیاز به بررسی دارد',
    failed: 'سفارش نیاز به بررسی پشتیبانی دارد',
  })[status] || 'در حال بررسی';
}

function tgState(data) {
  const raw = String(data.status || '').toLowerCase().trim();
  if (['completed','complete','delivered','success','succeeded'].includes(raw)) return 'completed';
  if (['failed','error','rejected','cancelled','canceled','refunded'].includes(raw)) return 'failed';
  return 'pending';
}

async function markOrderError(db, id, message) {
  await db.prepare(`UPDATE orders SET status='failed', provider_error=?, updated_at=? WHERE id=? AND status='provider_submitting'`)
    .bind(safeProviderMessage(message), new Date().toISOString(), id).run();
}

async function setProviderSecret(env, key, value) {
  const encryptionKey = await ensureEncryptionKey(env);
  const encrypted = await encryptSecret(encryptionKey, value);
  await env.DB.prepare(`INSERT INTO provider_secrets(key,value,updated_at) VALUES(?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at`)
    .bind(key, encrypted, new Date().toISOString()).run();
}

async function getProviderSecret(env, key) {
  const row = await env.DB.prepare(`SELECT value FROM provider_secrets WHERE key=?`).bind(key).first();
  if (!row?.value) return '';
  try { return await decryptSecret(await ensureEncryptionKey(env), String(row.value)); } catch (_) { return ''; }
}

async function ensureEncryptionKey(env) {
  if (env.CONFIG_ENCRYPTION_KEY) return String(env.CONFIG_ENCRYPTION_KEY);
  let value = await getSetting(env.DB, 'internal_config_key', '');
  if (value) return value;
  value = bytesToBase64(crypto.getRandomValues(new Uint8Array(32)));
  await setSetting(env.DB, 'internal_config_key', value);
  return value;
}

async function ensureSessionSecret(env) {
  if (env.SESSION_SECRET) return String(env.SESSION_SECRET);
  let value = await getSetting(env.DB, 'internal_session_secret', '');
  if (value) return value;
  value = randomToken(48);
  await setSetting(env.DB, 'internal_session_secret', value);
  return value;
}

