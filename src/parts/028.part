function bpMidnightDecorate(html){return html.replace("</head>",'<style id="bp-midnight-v5">'+bpMidnightCss()+"</style></head>");}
function bpMidnightCss(){return "\n/* Midnight Luxe v5: BluePremium original branded UI, modeled on polished\n   Telegram commerce layouts without copying competitor art or trademarks.\n   Presentation only: never touches checkout, prices or payment state. */\n:root:has(.bp-shell-v3){\n  color-scheme:dark;\n  --bg:#08111f;--surface:#111d31;--surface2:#16233a;--surface3:#1b2c47;\n  --line:rgba(170,194,249,.15);--text:#f5f7ff;--muted:#a3b0cc;\n  --blue:#8c70ff;--blue2:#64baff;--gold:#f2c671;--green:#66d4b3;\n  --shadow:0 18px 42px rgba(0,0,0,.24)\n}\nhtml:has(.bp-shell-v3){background:#08111f!important;color-scheme:dark}\nbody.bp-shell-v3{\n  background:radial-gradient(560px 370px at 50% -120px,rgba(46,72,139,.29),transparent 85%),#08111f!important;\n  color:#f5f7ff!important;font-family:\"Vazirmatn\",\"Noto Sans Arabic\",Tahoma,sans-serif!important;\n}\nbody.bp-shell-v3::before{display:none!important}\nbody.bp-shell-v3 .shell{max-width:960px;padding-bottom:calc(113px + env(safe-area-inset-bottom,0px))}\nbody.bp-shell-v3 .topbar{\n  background:rgba(8,17,31,.92)!important;border-bottom:1px solid rgba(146,176,255,.12)!important;\n  backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);\n  box-shadow:none!important\n}\nbody.bp-shell-v3 .brand-name{color:#f4f6ff!important;letter-spacing:-.02em}\nbody.bp-shell-v3 .brand-name small{color:#8d9bc3!important}\nbody.bp-shell-v3 .brand-logo{border:1px solid #6b8dd044!important;box-shadow:0 5px 22px #0005!important}\nbody.bp-shell-v3 .topbar button,body.bp-shell-v3 .topbar .icon-btn{color:#f5f7ff!important}\nbody.bp-shell-v3 :is(h1,h2,h3,strong){text-wrap:pretty}\nbody.bp-shell-v3 .bp-overline,body.bp-shell-v3 .bp-card-label{letter-spacing:.12em;font-size:10px;color:#a49eff!important}\nbody.bp-shell-v3 .bp-section-head h2,body.bp-shell-v3 .bp-tab-heading h1{color:#f8f8ff!important}\nbody.bp-shell-v3 .bp-section-note,body.bp-shell-v3 .bp-tab-heading p{color:#9caac7!important}\nbody.bp-shell-v3 .bp-tab-heading{margin:24px 0 18px}\nbody.bp-shell-v3 .bp-tab-symbol{background:linear-gradient(145deg,#262658,#15274c)!important;border:1px solid #9a8cff32!important}\nbody.bp-shell-v3 .bp-tab-symbol .bp-art{width:36px;height:36px}\n\n/* Aspirational hero / artwork remains BluePremium's own SVG. */\nbody.bp-shell-v3 .bp-hero{\n  min-height:245px;padding:25px 24px 22px!important;border-radius:27px!important;\n  background:radial-gradient(300px 190px at 7% 24%,rgba(63,91,245,.35),transparent 85%),\n             linear-gradient(122deg,#10193f 0%,#080f28 55%,#101d3a 100%)!important;\n  border:1px solid rgba(141,157,255,.24)!important;\n  box-shadow:0 19px 44px #0306158c,inset 0 1px #ffffff13!important;\n}\nbody.bp-shell-v3 .bp-hero::before{display:block!important;left:-90px;top:-130px;border-color:#a0aeff20!important;box-shadow:0 0 0 40px #8a8eff08,0 0 0 85px #8a8eff05!important}\nbody.bp-shell-v3 .bp-hero::after{display:none!important}\nbody.bp-shell-v3 .bp-hero .bp-editorial-tag{font-size:10px;letter-spacing:1.6px;color:#b7b5ff}\nbody.bp-shell-v3 .bp-hero .bp-led{background:#61e7c0;box-shadow:0 0 0 5px #61e7c018}\nbody.bp-shell-v3 .bp-hero h1{color:#fff!important;font-size:clamp(26px,4.7vw,39px)!important;line-height:1.52!important;position:relative;z-index:2}\nbody.bp-shell-v3 .bp-hero h1 em{color:#b5a8ff!important}\nbody.bp-shell-v3 .bp-hero p{color:#c0c9df!important;font-size:12px!important;line-height:2.05!important;max-width:min(390px,75%);position:relative;z-index:2}\nbody.bp-shell-v3 .bp-hero-art{\n  left:-1px;top:18px;width:min(37vw,194px);height:min(37vw,194px);\n  filter:drop-shadow(0 18px 20px #091d68bf) saturate(1.16)!important;\n  transform:rotate(-12deg)!important;opacity:.98!important\n}\nbody.bp-shell-v3 .bp-hero-foot{border-top:1px solid #b3bbff30!important;color:#aeb9e1!important;position:relative;z-index:2}\nbody.bp-shell-v3 .bp-hero-arrow{border-color:#9fa6ff60!important}\n\n/* Featured services: clear hierarchy, dedicated visual assets, real actions. */\nbody.bp-shell-v3 .bp-featured,body.bp-shell-v3 .bp-discover{margin:27px 0 24px!important}\nbody.bp-shell-v3 .bp-quick-grid{gap:13px}\nbody.bp-shell-v3 .bp-quick-card{\n  position:relative;isolation:isolate;min-height:245px;padding:17px 16px 15px!important;\n  gap:7px;border-radius:23px!important;color:#fff!important;overflow:hidden;\n  border:1px solid rgba(167,177,255,.16)!important;\n  box-shadow:inset 0 1px #ffffff12,0 13px 24px #0004!important;\n  transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease!important\n}\nbody.bp-shell-v3 .bp-quick-card.premium{\n  background:radial-gradient(150px 140px at 50% 9%,#5c48a65c,transparent),linear-gradient(155deg,#1d1e49,#191329)!important\n}\nbody.bp-shell-v3 .bp-quick-card.stars{\n  background:radial-gradient(150px 140px at 50% 9%,#c99c4140,transparent),linear-gradient(155deg,#272238,#241d11)!important\n}\nbody.bp-shell-v3 .bp-quick-card::before{\n  content:\"\";position:absolute;top:-42px;left:calc(50% - 86px);width:172px;height:172px;\n  background:radial-gradient(circle,rgba(255,255,255,.06),transparent 71%);z-index:-1\n}\nbody.bp-shell-v3 .bp-quick-card .bp-card-label{font:750 9px/1.6 \"Vazirmatn\",sans-serif!important;color:#c9c5f3!important}\nbody.bp-shell-v3 .bp-quick-icon{\n  margin:3px auto 7px;width:94px;height:89px;background:transparent!important;border:none!important;\n  filter:drop-shadow(0 14px 11px #0007)\n}\nbody.bp-shell-v3 .bp-quick-icon .bp-art{width:96px!important;height:96px!important}\nbody.bp-shell-v3 .bp-quick-card strong{display:block;width:100%;text-align:center;color:#fafaff!important;font-size:16px!important;line-height:1.7}\nbody.bp-shell-v3 .bp-quick-card small{\n  min-height:40px;color:#aaaeca!important;font-size:11px!important;line-height:1.9!important;text-align:center;width:100%\n}\nbody.bp-shell-v3 .bp-inline-arrow{\n  align-self:stretch;text-align:center;padding:9px 7px;border-radius:12px;\n  background:linear-gradient(100deg,#493992,#6f3cb0);color:#fff!important;\n  font-weight:850!important;min-height:42px;display:flex;align-items:center;justify-content:center;gap:8px\n}\nbody.bp-shell-v3 .bp-quick-card.stars .bp-inline-arrow{background:linear-gradient(100deg,#886427,#b18b36)}\nbody.bp-shell-v3 .bp-quick-card:is(:hover,:focus-visible){border-color:#a7a2ff80!important;box-shadow:0 12px 32px #010414a8!important}\n\n/* Discover: real category controls, never fictional products. */\nbody.bp-shell-v3 .bp-discover-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important}\nbody.bp-shell-v3 .bp-category{\n  min-height:156px!important;border-radius:21px!important;justify-content:center;\n  padding:15px 10px!important;border:1px solid #96a8dd30!important;\n  background:radial-gradient(120px 110px at 50% 8%,#4d7fd030,transparent),#111f35!important;\n  box-shadow:inset 0 1px #ffffff13,0 10px 26px #0003!important;color:#f6f8ff!important\n}\nbody.bp-shell-v3 .bp-category:nth-child(2){background:radial-gradient(120px 110px at 50% 8%,#36bab340,transparent),#0e2430!important}\nbody.bp-shell-v3 .bp-category:nth-child(3){background:radial-gradient(120px 110px at 50% 8%,#9d66e54a,transparent),#231834!important}\nbody.bp-shell-v3 .bp-category:nth-child(4){background:radial-gradient(120px 110px at 50% 8%,#e5ad5b39,transparent),#282032!important}\nbody.bp-shell-v3 .bp-category span{width:69px!important;height:69px!important;background:transparent!important}\nbody.bp-shell-v3 .bp-category .bp-art{width:69px!important;height:69px!important;filter:drop-shadow(0 8px 7px #0006)}\nbody.bp-shell-v3 .bp-category strong{font-size:14px!important;color:#fff!important}\nbody.bp-shell-v3 .bp-category small{color:#a5b3d3!important;font-size:9px!important}\nbody.bp-shell-v3 :is(.bp-quick-card,.bp-category):focus-visible{outline:2px solid #b49cff!important;outline-offset:3px}\n\n/* Dock retains the existing six real screens and proper aria-current. */\nbody.bp-shell-v3 .bp-app-nav{\n  background:rgba(13,25,47,.97)!important;border:1px solid #718bc455!important;\n  box-shadow:0 15px 40px #0009,inset 0 1px #ffffff16!important;\n  border-radius:24px!important;padding:8px 5px!important;\n  -webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px)\n}\nbody.bp-shell-v3 .bp-app-nav button{\n  color:#9ca9c7!important;font:750 10px/1.4 \"Vazirmatn\",Tahoma,sans-serif!important;\n  background:transparent!important;min-height:59px\n}\nbody.bp-shell-v3 .bp-app-nav button[aria-current=\"page\"]{\n  color:#c5a3ff!important;background:#32254c!important\n}\nbody.bp-shell-v3 .bp-app-nav button[aria-current=\"page\"]::after{\n  background:#a879ff!important;width:21px!important;height:3px!important;bottom:1px!important;\n  right:calc(50% - 10.5px)!important;box-shadow:0 0 10px #b885ff88\n}\nbody.bp-shell-v3 .bp-app-nav button[aria-current=\"page\"] .bp-nav-icon{\n  color:#cdafff!important\n}\n\n/* Market and plans: consistent premium product grammar. */\nbody.bp-shell-v3 .bp-market-view .tg-store{background:transparent!important;border:0!important}\nbody.bp-shell-v3 .bp-market-feature{\n  border:1px solid #8183d74d!important;\n  background:radial-gradient(200px 130px at 9% 15%,#5352c155,transparent),#111837!important;\n  box-shadow:0 10px 30px #0004!important\n}\nbody.bp-shell-v3 .bp-market-feature strong{color:#fff!important}\nbody.bp-shell-v3 .bp-market-feature p{color:#abb8d6!important}\nbody.bp-shell-v3 .bp-market-category-heading strong,body.bp-shell-v3 .bp-market-results-head strong{color:#f3f5ff!important}\nbody.bp-shell-v3 .bp-market-category-heading small,body.bp-shell-v3 .bp-market-results-head small{color:#9faccb!important}\nbody.bp-shell-v3 .bp-market-polished .tg-categories button{\n  background:#131f35!important;color:#c5d0e5!important;border-color:#3d507a!important\n}\nbody.bp-shell-v3 .bp-market-polished .tg-categories button:is(.selected,[aria-pressed=true]){\n  background:#402c7c!important;border-color:#8c73ff!important;color:#fff!important\n}\nbody.bp-shell-v3 .bp-market-polished .tg-item.bp-market-product{\n  background:radial-gradient(120px 100px at 50% 0%,#5a4dbc40,transparent),#181e3b!important;\n  border-color:#6066b64d!important;color:#f3f5ff!important;box-shadow:0 8px 24px #0004!important\n}\nbody.bp-shell-v3 .bp-market-polished .tg-item.bp-market-product:nth-child(4n+2){\n  background:radial-gradient(120px 100px at 50% 0%,#c19c4840,transparent),#272018!important;\n  border-color:#88713c5a!important\n}\nbody.bp-shell-v3 .bp-market-polished .tg-item.bp-market-product:nth-child(4n+3){\n  background:radial-gradient(120px 100px at 50% 0%,#3886c644,transparent),#111f37!important;\n  border-color:#3f78a35a!important\n}\nbody.bp-shell-v3 .bp-market-polished .tg-item.bp-market-product:nth-child(4n+4){\n  background:radial-gradient(120px 100px at 50% 0%,#ad5db04a,transparent),#2c1833!important;\n  border-color:#96559f5a!important\n}\nbody.bp-shell-v3 .bp-market-polished .tg-item.bp-market-product>b{color:#fff!important}\nbody.bp-shell-v3 .bp-market-polished .tg-item.bp-market-product>small{color:#aeb5ca!important}\nbody.bp-shell-v3 .bp-market-polished .bp-market-product-label{color:#b5a8ff!important}\nbody.bp-shell-v3 .bp-market-polished :is(#tgCatalogSearchArea,#tgCatalogSearch){\n  background:#12213a!important;color:#f1f5ff!important;border-color:#405376!important\n}\nbody.bp-shell-v3 .bp-market-polished #tgCatalogSearchButton{background:#6248a4!important;color:#fff!important}\nbody.bp-shell-v3 .bp-premium-view .plans .plan{\n  background:#15223a!important;border:1px solid #4c5e87!important;color:#f3f6ff!important;\n  border-radius:20px!important;box-shadow:0 8px 24px #0002!important\n}\nbody.bp-shell-v3 .bp-premium-view .plans .plan.active{\n  border-color:#b293ff!important;box-shadow:inset 0 0 0 1px #b293ff,0 10px 30px #38276d80!important\n}\nbody.bp-shell-v3 .bp-premium-view .plans .plan :is(.months,.price){color:#fff!important}\n\n/* Wallet, profile, history and checkout all share dark readable surfaces. */\nbody.bp-shell-v3 :is(.bp-panel,.bp-orders-card,.bp-account-widget,.bp-order-row,.bp-empty-state){\n  background:#121e32!important;color:#f3f5ff!important;border-color:#344a6b!important;\n  box-shadow:0 10px 28px #0003!important\n}\nbody.bp-shell-v3 :is(.bp-panel-head h2,.bp-profile-copy strong,.bp-order-category strong,.bp-orders-card h2){\n  color:#f8f9ff!important\n}\nbody.bp-shell-v3 :is(.bp-panel-head p,.bp-profile-copy small,.bp-orders-card p,.bp-empty-state p){\n  color:#aab9d2!important\n}\nbody.bp-shell-v3 .bp-overview-card{\n  background:#15233a!important;color:#fff!important;border-color:#435b80!important\n}\nbody.bp-shell-v3 .bp-overview-card.wallet{\n  background:linear-gradient(135deg,#173850,#102b3f)!important;border-color:#286b7b!important\n}\nbody.bp-shell-v3 .bp-overview-card.orders{\n  background:linear-gradient(135deg,#32244d,#1d233d)!important;border-color:#6a477b!important\n}\nbody.bp-shell-v3 .bp-overview-card :is(.bp-overview-kicker,.bp-overview-number){color:#f6f7ff!important}\nbody.bp-shell-v3 .bp-overview-card .bp-overview-action{color:#8fe8d8!important}\nbody.bp-shell-v3 .bp-overview-status{background:#16223a!important;color:#afc0df!important;border-color:#42567a!important}\nbody.bp-shell-v3 .bp-chip{\n  background:#1a2941!important;color:#d1dcf2!important;border-color:#455a7d!important\n}\nbody.bp-shell-v3 .bp-chip[aria-pressed=true]{background:#57409b!important;border-color:#8e75dc!important;color:#fff!important}\nbody.bp-shell-v3 .bp-order-row{border-bottom-color:#364967!important}\nbody.bp-shell-v3 .bp-order-category-icon,body.bp-shell-v3 .bp-timeline-icon{\n  background:#202e49!important;color:#cab0ff!important\n}\nbody.bp-shell-v3 .bp-timeline-row{border-color:#364762!important}\nbody.bp-shell-v3 .bp-timeline-text strong{color:#eaf0fc!important}\nbody.bp-shell-v3 .bp-timeline-text small{color:#99a9c8!important}\nbody.bp-shell-v3 .bp-order-row :is(small,p){color:#9fb0d0!important}\nbody.bp-shell-v3 .bp-account-actions button:not(.secondary),body.bp-shell-v3 .bp-panel-action{\n  background:#49348e!important;color:#fff!important;border-color:#7a60bf!important\n}\nbody.bp-shell-v3 .bp-account-actions button.secondary{background:#243452!important;color:#d6dffd!important}\nbody.bp-shell-v3 .bp-premium-view .checkout .box{\n  background:#13223a!important;color:#f2f5ff!important;border:1px solid #3c547b!important\n}\nbody.bp-shell-v3 :is(input,select,textarea){\n  background:#121e34!important;color:#f4f7ff!important;border-color:#435a80!important\n}\nbody.bp-shell-v3 :is(input,textarea)::placeholder{color:#8295b7!important}\nbody.bp-shell-v3 :is(#tgPayCard,#tgPayWallet,#tgQuoteButton,.checkout .btn.primary):not(:disabled){\n  background:linear-gradient(105deg,#5240a0,#7450b9)!important;color:#fff!important;border-color:transparent!important\n}\nbody.bp-shell-v3 :is(.bp-quick-card,.bp-category,button):focus-visible{outline:2px solid #b19bff!important;outline-offset:2px}\n\n/* Compact phones & reduced-motion access. */\n@media(max-width:700px){\n  body.bp-shell-v3 .shell{padding:11px 13px calc(110px + env(safe-area-inset-bottom,0px))}\n  body.bp-shell-v3 .bp-hero{min-height:218px;padding:22px 17px!important}\n  body.bp-shell-v3 .bp-hero h1{font-size:26px!important;margin:24px 0 8px!important}\n  body.bp-shell-v3 .bp-hero p{font-size:11px!important}\n  body.bp-shell-v3 .bp-hero-art{width:132px;height:132px;left:-13px;top:28px}\n  body.bp-shell-v3 .bp-quick-card{min-height:228px;padding:13px 12px!important}\n  body.bp-shell-v3 .bp-quick-icon{width:76px;height:77px}\n  body.bp-shell-v3 .bp-quick-icon .bp-art{width:79px!important;height:79px!important}\n  body.bp-shell-v3 .bp-quick-card strong{font-size:14px!important}\n  body.bp-shell-v3 .bp-quick-card small{font-size:10px!important;min-height:38px}\n  body.bp-shell-v3 .bp-app-nav{left:7px;right:7px;bottom:calc(7px + env(safe-area-inset-bottom,0px))}\n  body.bp-shell-v3 .bp-app-nav button{font-size:9px!important}\n}\n@media(max-width:355px){\n  body.bp-shell-v3 .bp-hero-art{opacity:.48!important}\n  body.bp-shell-v3 .bp-category{min-height:139px!important}\n  body.bp-shell-v3 .bp-app-nav button{font-size:8px!important;padding:2px}\n}\n@media(prefers-reduced-motion:reduce){\n  body.bp-shell-v3 :is(.bp-quick-card,.bp-category,.bp-app-nav button){transition:none!important}\n}\n";}
