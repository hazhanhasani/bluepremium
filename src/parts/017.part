
function telegramBotTokenLooksValid(value) {
  return /^\d{6,12}:[A-Za-z0-9_-]{30,80}$/.test(String(value || '').trim());
}

function telegramAdminIdLooksValid(value) {
  return /^-?\d{5,20}$/.test(String(value || '').trim());
}

function telegramEscapeHtml(value) {
  return String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
}

async function telegramBotApi(token, method, payload = {}) {
  if (!telegramBotTokenLooksValid(token)) {
    return { ok: false, error: 'invalid_bot_token', http_status: 0, result: null };
  }
  try {
    const response = await fetch(`https://api.telegram.org/bot${token}/${method}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload || {}),
    });
    const data = await response.json().catch(() => ({}));
    return {
      ok: response.ok && data?.ok === true,
      http_status: response.status,
      result: data?.result ?? null,
      description: String(data?.description || ''),
      error: response.ok && data?.ok === true ? '' : String(data?.description || 'telegram_api_error'),
    };
  } catch (error) {
    return { ok: false, error: String(error?.message || 'network_error'), http_status: 0, result: null };
  }
}

async function ensureTelegramWebhookSecret(env) {
  let secret = await getSetting(env.DB, 'internal_telegram_webhook_secret', '');
  if (secret) return secret;
  secret = randomToken(32);
  await setSetting(env.DB, 'internal_telegram_webhook_secret', secret);
  return secret;
}

async function telegramBotHealth(env) {
  const [enabled, adminId, username, token] = await Promise.all([
    getSetting(env.DB, 'telegram_bot_enabled', '0'),
    getSetting(env.DB, 'telegram_admin_id', ''),
    getSetting(env.DB, 'telegram_bot_username', ''),
    getProviderSecret(env, 'telegram_bot_token'),
  ]);
  const configured = !!token && telegramAdminIdLooksValid(adminId);
  const out = {
    enabled: String(enabled) === '1',
    configured,
    ok: false,
    username: String(username || ''),
    admin_id: String(adminId || ''),
    webhook_url: '',
    http_status: 0,
    error: '',
  };
  if (!configured || String(enabled) !== '1') return out;
  const me = await telegramBotApi(token, 'getMe');
  out.ok = me.ok;
  out.http_status = Number(me.http_status || 0);
  out.error = me.ok ? '' : safeProviderMessage(me.error || me.description || 'telegram_bot_error');
  if (me.ok && me.result?.username) {
    out.username = String(me.result.username);
    await setSetting(env.DB, 'telegram_bot_username', out.username);
  }
  return out;
}

async function configureTelegramBot(env, origin, { token = '', adminId = '', enabled = true } = {}) {
  let currentToken = await getProviderSecret(env, 'telegram_bot_token');
  const suppliedToken = String(token || '').trim();
  if (suppliedToken) {
    if (!telegramBotTokenLooksValid(suppliedToken)) return { ok: false, error: 'invalid_bot_token' };
    const me = await telegramBotApi(suppliedToken, 'getMe');
    if (!me.ok) return { ok: false, error: 'bot_token_rejected', message: me.description || me.error };
    currentToken = suppliedToken;
    await setProviderSecret(env, 'telegram_bot_token', suppliedToken);
    await setSetting(env.DB, 'telegram_bot_username', String(me.result?.username || ''));
  }

  const finalAdminId = String(adminId || await getSetting(env.DB, 'telegram_admin_id', '')).trim();
  if (!telegramAdminIdLooksValid(finalAdminId)) return { ok: false, error: 'invalid_admin_id' };
  if (!currentToken) return { ok: false, error: 'bot_token_required' };

  await setSetting(env.DB, 'telegram_admin_id', finalAdminId);
  await setSetting(env.DB, 'telegram_bot_enabled', enabled ? '1' : '0');

  if (!enabled) {
    const removed = await telegramBotApi(currentToken, 'deleteWebhook', { drop_pending_updates: false });
    return { ok: removed.ok, disabled: true, health: await telegramBotHealth(env), error: removed.ok ? '' : removed.error };
  }

  const secret = await ensureTelegramWebhookSecret(env);
  const webhookUrl = String(origin || '').replace(/\/$/, '') + '/api/telegram/bot/webhook';

  const hook = await telegramBotApi(currentToken, 'setWebhook', {
    url: webhookUrl,
    secret_token: secret,
    allowed_updates: ['message', 'callback_query'],
    drop_pending_updates: false,
  });
  if (!hook.ok) return { ok: false, error: 'set_webhook_failed', message: hook.description || hook.error };

  await telegramBotApi(currentToken, 'setMyCommands', {
    commands: [
      { command: 'start', description: 'شروع و نمایش منوی بلوپرمیوم' },
      { command: 'buy', description: 'خرید تلگرام پرمیوم' },
      { command: 'status', description: 'پیگیری وضعیت سفارش' },
      { command: 'support', description: 'پشتیبانی' },
    ],
  });

  await telegramBotApi(currentToken, 'setChatMenuButton', {
    menu_button: {
      type: 'web_app',
      text: 'مینی اپ',
      web_app: { url: String(origin || '').replace(/\/$/, '') + '/?from=telegram' },
    },
  });

  await setSetting(env.DB, 'telegram_bot_webhook_url', webhookUrl);
  const health = await telegramBotHealth(env);
  health.webhook_url = webhookUrl;
  return { ok: true, health };
}

function telegramSupportUrl(value) {
  const s = String(value || '').trim();
  if (!s) return '';
  if (/^https:\/\/t\.me\/[A-Za-z0-9_]{4,}$/i.test(s)) return s;
  if (/^@[A-Za-z0-9_]{4,}$/.test(s)) return 'https://t.me/' + s.slice(1);
  if (/^[A-Za-z0-9_]{4,}$/.test(s)) return 'https://t.me/' + s;
  return '';
}

async function telegramMainKeyboard(env, origin, senderId = '') {
  const support = telegramSupportUrl(await getSetting(env.DB, 'support', ''));
  const adminId = String(await getSetting(env.DB, 'telegram_admin_id', ''));
  const rows = [
    [{ text: '🛍 خرید تلگرام پرمیوم', callback_data: 'buy' }],
    [{ text: '📦 پیگیری سفارش', callback_data: 'status_help' }],
  ];
  if (support) rows.push([{ text: '☎️ پشتیبانی', url: support }]);
  if (String(senderId) === adminId) {
    rows.push([{ text: '⚙️ مدیریت بلوپرمیوم', url: String(origin).replace(/\/$/, '') + '/admin' }]);
  }
  return { inline_keyboard: rows };
}

async function telegramSendMessage(env, chatId, text, extra = {}) {
  const token = await getProviderSecret(env, 'telegram_bot_token');
  if (!token) return { ok: false, error: 'not_configured' };
  return telegramBotApi(token, 'sendMessage', {
    chat_id: chatId,
    text,
    parse_mode: 'HTML',
    disable_web_page_preview: true,
    ...extra,
  });
}

async function notifyTelegramAdmin(env, text, replyMarkup = null) {
  const [enabled, adminId] = await Promise.all([
    getSetting(env.DB, 'telegram_bot_enabled', '0'),
    getSetting(env.DB, 'telegram_admin_id', ''),
  ]);
  if (String(enabled) !== '1' || !telegramAdminIdLooksValid(adminId)) return { ok: false, skipped: true };
  return telegramSendMessage(env, adminId, text, replyMarkup ? { reply_markup: replyMarkup } : {});
}

async function notifyTelegramAdminForOrder(env, order, type = 'update') {
  if (!order) return;
  const code = telegramEscapeHtml(order.order_code);
  const username = telegramEscapeHtml(order.username);
  const months = Number(order.months || 0);
  const amount = new Intl.NumberFormat('fa-IR').format(Number(order.price_toman || 0));

  if (type === 'awaiting_approval') {
    return notifyTelegramAdmin(
      env,
      `🟡 <b>سفارش آماده تأیید</b>\n\n🧾 <code>${code}</code>\n👤 @${username}\n📦 ${months} ماهه\n💳 ${amount} تومان\n\nپرداخت تأیید شده و سفارش منتظر ارسال به TG Tools است.`,
      { inline_keyboard: [[{ text: '✅ ارسال به TG Tools', callback_data: `approve:${order.order_code}` }]] }
    );
  }

  if (type === 'delivered') {
    return notifyTelegramAdmin(
      env,
      `✅ <b>سفارش تحویل شد</b>\n\n🧾 <code>${code}</code>\n👤 @${username}\n📦 ${months} ماهه`
    );
  }

  if (type === 'failed') {
    return notifyTelegramAdmin(
      env,
      `🔴 <b>سفارش نیاز به بررسی دارد</b>\n\n🧾 <code>${code}</code>\n👤 @${username}\n📦 ${months} ماهه\n⚠️ ${telegramEscapeHtml(order.provider_error || order.status)}`
    );
  }
}

async function telegramOrderStatusText(env, code) {
  const clean = String(code || '').trim().toUpperCase();
  if (!/^BP-[A-Z0-9]{6,40}$/.test(clean)) return null;
  const order = await env.DB.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(clean).first();
  if (!order) return null;
  return [
    '📦 <b>وضعیت سفارش بلوپرمیوم</b>',
    '',
    `🧾 کد: <code>${telegramEscapeHtml(order.order_code)}</code>`,
    `👤 مقصد: @${telegramEscapeHtml(order.username)}`,
    `📅 پلن: ${Number(order.months)} ماهه`,
    `💳 مبلغ: ${new Intl.NumberFormat('fa-IR').format(Number(order.price_toman || 0))} تومان`,
    `📍 وضعیت: <b>${telegramEscapeHtml(customerStatusMessage(order.status))}</b>`,
  ].join('\n');
}

async function telegramAdminSummaryText(env) {
  const result = await env.DB.prepare(`SELECT status,COUNT(*) count FROM orders GROUP BY status`).all();
  const rows = result.results || [];
  const count = status => Number(rows.find(r => r.status === status)?.count || 0);
  const total = rows.reduce((a, r) => a + Number(r.count || 0), 0);
  const waiting = count('awaiting_approval');
  const delivered = count('delivered');
  const issues = count('provider_uncertain') + count('failed') + count('payment_error') + count('payment_mismatch');
  return `⚙️ <b>مدیریت بلوپرمیوم</b>\n\n📦 کل سفارش‌ها: ${total}\n🟡 منتظر تأیید: ${waiting}\n✅ تحویل‌شده: ${delivered}\n🔴 نیازمند بررسی: ${issues}`;
}


async function isTelegramBotBlupalOrderAllowed(env, order) {
  if (!order || String(order.payment_provider || '') !== 'blupal') return false;
  if (!/^tg:-?\d+$/.test(String(order.device_id || ''))) return String(await getSetting(env.DB, 'blupal_enabled', '0')) === '1';
  return String(await getSetting(env.DB, 'telegram_bot_blupal_enabled', '1')) === '1';
}

function telegramOrderChatId(order) {
  const m = String(order?.device_id || '').match(/^tg:(-?\d+)$/);
  return m ? m[1] : '';
}

async function telegramSessionGet(env, chatId) {
  const row = await env.DB.prepare(`SELECT state,data,user_id,updated_at FROM telegram_bot_sessions WHERE chat_id=? LIMIT 1`)
    .bind(String(chatId)).first();
  if (!row) return null;
  let data = {};
  try { data = JSON.parse(String(row.data || '{}')); } catch (_) {}
  return { state: String(row.state || ''), data, user_id: String(row.user_id || '') };
}

async function telegramSessionSet(env, chatId, userId, state, data = {}) {
  await env.DB.prepare(`
    INSERT INTO telegram_bot_sessions(chat_id,user_id,state,data,updated_at) VALUES(?,?,?,?,?)
    ON CONFLICT(chat_id) DO UPDATE SET user_id=excluded.user_id,state=excluded.state,data=excluded.data,updated_at=excluded.updated_at
  `).bind(String(chatId), String(userId), String(state), JSON.stringify(data || {}), new Date().toISOString()).run();
}

async function telegramSessionClear(env, chatId) {
  await env.DB.prepare(`DELETE FROM telegram_bot_sessions WHERE chat_id=?`).bind(String(chatId)).run();
}

async function telegramPlansKeyboard(env) {
  const result = await env.DB.prepare(`
    SELECT id,months,price_toman,manual_price_toman,auto_price_toman
    FROM plans WHERE active=1 ORDER BY months
  `).all();
  const plans = (result.results || [])
    .map(p => ({
      id: Number(p.id),
      months: Number(p.months),
      price: Number(p.manual_price_toman || p.price_toman || p.auto_price_toman || 0),
    }))
    .filter(p => ALLOWED_MONTHS.includes(p.months) && p.price > 0);
  const rows = plans.map(p => [{
    text: `⭐ ${p.months} ماهه — ${new Intl.NumberFormat('fa-IR').format(p.price)} تومان`,
    callback_data: `buy_plan:${p.id}`,
  }]);
  rows.push([{ text: '✖️ انصراف', callback_data: 'buy_cancel' }]);
  return { plans, reply_markup: { inline_keyboard: rows } };
}

async function telegramBeginPurchase(env, chatId, userId) {
  const botBluePalEnabled = String(await getSetting(env.DB, 'telegram_bot_blupal_enabled', '1')) === '1';
  const bluePalKey = await getProviderSecret(env, 'blupal_api_key');
  if (!botBluePalEnabled || !bluePalKey) {
    await telegramSendMessage(env, chatId, 'درگاه BluePal ربات فعلاً آماده نیست. لطفاً با پشتیبانی در ارتباط باش.');
    return;
  }
  const menu = await telegramPlansKeyboard(env);
  if (!menu.plans.length) {
    await telegramSendMessage(env, chatId, 'فعلاً پلن فعالی برای خرید وجود ندارد.');
    return;
  }
  await telegramSessionClear(env, chatId);
  await telegramSendMessage(env, chatId, '🛍 <b>خرید تلگرام پرمیوم</b>\n\nپلن موردنظرت را انتخاب کن:', {
    reply_markup: menu.reply_markup,
  });
}

async function createTelegramBotBlupalOrder(env, { chatId, userId, planId, username }) {
  const plan = await env.DB.prepare(`SELECT * FROM plans WHERE id=? AND active=1 LIMIT 1`).bind(Number(planId)).first();
  if (!plan) return { ok: false, error: 'plan_not_found' };
  const months = Number(plan.months);
  const priceToman = Number(plan.manual_price_toman || plan.price_toman || plan.auto_price_toman || 0);
  if (!ALLOWED_MONTHS.includes(months) || !Number.isFinite(priceToman) || priceToman < 10000) {
    return { ok: false, error: 'plan_unavailable' };
  }

  const bluePalEnabled = String(await getSetting(env.DB, 'telegram_bot_blupal_enabled', '1')) === '1';
  const blupalKey = await getProviderSecret(env, 'blupal_api_key');
  if (!bluePalEnabled || !blupalKey) return { ok: false, error: 'payment_not_configured' };

  const tgKey = await getProviderSecret(env, 'tgtools_api_key');
  if (!tgKey) return { ok: false, error: 'provider_not_configured' };
  const lookup = await tgRequest(tgKey, 'GET', `/api/purchase/user/${encodeURIComponent(username)}`);
  if (!lookup.ok) return { ok: false, error: 'telegram_lookup_failed' };
  if (lookup.data?.found === false) return { ok: false, error: 'telegram_user_not_found' };
  if (lookup.data?.premiumEligible === false) return { ok: false, error: 'not_premium_eligible' };

  const orderCode = `BP-${crypto.randomUUID().replaceAll('-', '').slice(0, 14).toUpperCase()}`;
  const publicToken = randomToken(24);
  const publicTokenHash = await sha256Hex(publicToken);
  const now = new Date().toISOString();

  await env.DB.prepare(`
    INSERT INTO orders(
      order_code,public_token_hash,plan_id,months,username,price_toman,status,device_id,
      payment_provider,created_at,updated_at
    ) VALUES(?,?,?,?,?,?,'creating_payment',?,'blupal',?,?)
  `).bind(
    orderCode,
    publicTokenHash,
    Number(plan.id),
    months,
    username,
    Math.round(priceToman),
    `tg:${chatId}`,
    now,
    now
  ).run();

  const invoice = await blupalRequest(blupalKey, 'POST', '/v1/invoices/create', {
    amount: Math.round(priceToman) * 10,
  });
  const invoiceId = String(invoice.data?.invoice_id || invoice.raw?.invoice_id || invoice.raw?.data?.invoice_id || '').trim();
  const paymentLink = String(invoice.data?.payment_link || invoice.raw?.payment_link || invoice.raw?.data?.payment_link || '').trim();

  if (!invoice.ok || !invoiceId || !isHttpsUrl(paymentLink)) {
    await env.DB.prepare(`UPDATE orders SET status='payment_error',provider_error=?,updated_at=? WHERE order_code=?`)
      .bind(safeProviderMessage(invoice.message || 'invoice_create_failed'), new Date().toISOString(), orderCode).run();
    return { ok: false, error: 'invoice_create_failed', order_code: orderCode };
  }

  await env.DB.prepare(`
    UPDATE orders
    SET status='awaiting_payment',blupal_invoice_id=?,payment_url=?,updated_at=?
    WHERE order_code=? AND status='creating_payment'
  `).bind(invoiceId, paymentLink, new Date().toISOString(), orderCode).run();

  const order = await env.DB.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(orderCode).first();
  return { ok: true, order, payment_url: paymentLink };
}

async function notifyTelegramCustomerForOrder(env, order, type = 'update') {
  const chatId = telegramOrderChatId(order);
  if (!chatId) return { ok: false, skipped: true };
  const code = telegramEscapeHtml(order.order_code);
  if (type === 'paid') {
    return telegramSendMessage(env, chatId,
      `✅ <b>پرداخت سفارش تأیید شد</b>\n\n🧾 <code>${code}</code>\n📍 ${telegramEscapeHtml(customerStatusMessage(order.status))}`
    );
  }
  if (type === 'delivered') {
    return telegramSendMessage(env, chatId,
      `🎉 <b>تلگرام پرمیوم با موفقیت فعال شد</b>\n\n🧾 <code>${code}</code>\n👤 @${telegramEscapeHtml(order.username)}\n📦 ${Number(order.months)} ماهه`
    );
  }
  if (type === 'failed') {
    return telegramSendMessage(env, chatId,
      `⚠️ <b>سفارش نیاز به بررسی دارد</b>\n\n🧾 <code>${code}</code>\nپشتیبانی سفارش را بررسی خواهد کرد.`
    );
  }
}

async function telegramSendOrderStatus(env, chatId, fromId, code) {
  const clean = String(code || '').trim().toUpperCase();
  if (!/^BP-[A-Z0-9]{6,40}$/.test(clean)) {
    await telegramSendMessage(env, chatId, 'کد سفارش معتبر نیست.');
    return;
  }
  const order = await env.DB.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(clean).first();
  if (!order) {
    await telegramSendMessage(env, chatId, 'سفارشی با این کد پیدا نشد.');
    return;
  }
  const adminId = String(await getSetting(env.DB, 'telegram_admin_id', ''));
  const ownerChatId = telegramOrderChatId(order);
  if (ownerChatId && String(ownerChatId) !== String(chatId) && String(fromId) !== adminId) {
    await telegramSendMessage(env, chatId, 'این سفارش متعلق به این حساب تلگرام نیست.');
    return;
  }
  if (order.status === 'awaiting_payment' && await isTelegramBotBlupalOrderAllowed(env, order)) {
    await reconcileOrder(env, order, null);
  }
  const fresh = await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(order.id).first() || order;
  let keyboard = await telegramMainKeyboard(env, 'https://bluepremium.hazhanhasani4268-0f9.workers.dev', fromId);
  if (fresh.status === 'awaiting_payment' && fresh.payment_url && isHttpsUrl(fresh.payment_url)) {
    keyboard = { inline_keyboard: [
      [{ text: '💳 ادامه پرداخت BluePal', url: fresh.payment_url }],
      [{ text: '🔄 بررسی پرداخت', callback_data: `check:${fresh.order_code}` }],
    ] };
  }
  await telegramSendMessage(env, chatId, await telegramOrderStatusText(env, fresh.order_code), { reply_markup: keyboard });
}

async function handleTelegramBotUpdate(env, update, origin, ctx) {
  const enabled = String(await getSetting(env.DB, 'telegram_bot_enabled', '0')) === '1';
  if (!enabled) return;

  const token = await getProviderSecret(env, 'telegram_bot_token');
  if (!token) return;

  const callback = update?.callback_query;
  if (callback) {
    const callbackId = String(callback.id || '');
    const data = String(callback.data || '');
    const chatId = callback.message?.chat?.id || callback.from?.id;
    const fromId = String(callback.from?.id || '');
    const adminId = String(await getSetting(env.DB, 'telegram_admin_id', ''));

    if (callbackId) {
      await telegramBotApi(token, 'answerCallbackQuery', {
        callback_query_id: callbackId,
        cache_time: 0,
      });
    }

    if (data === 'buy') {
      await telegramBeginPurchase(env, chatId, fromId);
      return;
    }

    if (data === 'buy_cancel') {
      await telegramSessionClear(env, chatId);
      await telegramSendMessage(env, chatId, 'خرید لغو شد.', {
        reply_markup: await telegramMainKeyboard(env, origin, fromId),
      });
      return;
    }

    if (data.startsWith('buy_plan:')) {
      const planId = Number(data.slice('buy_plan:'.length));
      const plan = await env.DB.prepare(`
        SELECT id,months,price_toman,manual_price_toman,auto_price_toman
        FROM plans WHERE id=? AND active=1 LIMIT 1
      `).bind(planId).first();
      const price = Number(plan?.manual_price_toman || plan?.price_toman || plan?.auto_price_toman || 0);
      if (!plan || !ALLOWED_MONTHS.includes(Number(plan.months)) || price <= 0) {
        await telegramSendMessage(env, chatId, 'این پلن در حال حاضر قابل خرید نیست.');
        return;
      }
      await telegramSessionSet(env, chatId, fromId, 'awaiting_username', {
        plan_id: Number(plan.id),
        months: Number(plan.months),
        price_toman: price,
      });
      await telegramSendMessage(
        env,
        chatId,
        `👤 <b>حساب مقصد را بفرست</b>\n\nپلن: <b>${Number(plan.months)} ماهه</b>\nمبلغ: <b>${new Intl.NumberFormat('fa-IR').format(price)} تومان</b>\n\nیوزرنیم تلگرام مقصد را با یا بدون @ ارسال کن.`,
        { reply_markup: { inline_keyboard: [[{ text: '✖️ انصراف', callback_data: 'buy_cancel' }]] } }
      );
      return;
    }

    if (data === 'status_help') {
      await telegramSessionSet(env, chatId, fromId, 'awaiting_status', {});
      await telegramSendMessage(env, chatId, '🔎 کد سفارش را ارسال کن:\n<code>BP-XXXXXXXXXXXXXX</code>', {
        reply_markup: { inline_keyboard: [[{ text: '✖️ انصراف', callback_data: 'buy_cancel' }]] },
      });
      return;
    }

    if (data.startsWith('check:')) {
      const code = data.slice('check:'.length);
      await telegramSendOrderStatus(env, chatId, fromId, code);
      return;
    }

    if (data === 'admin' && fromId === adminId) {
      await telegramSendMessage(env, chatId, await telegramAdminSummaryText(env), {
        reply_markup: { inline_keyboard: [[{ text: '⚙️ باز کردن پنل', url: String(origin).replace(/\/$/, '') + '/admin' }]] }
      });
      return;
    }

    if (data.startsWith('approve:') && fromId === adminId) {
      const code = data.slice('approve:'.length);
      const order = await env.DB.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(code).first();
      if (!order) {
        await telegramSendMessage(env, chatId, 'سفارش پیدا نشد.');
        return;
      }
      if (order.status !== 'awaiting_approval') {
        await telegramSendMessage(env, chatId, `این سفارش دیگر منتظر تأیید نیست.\nوضعیت: <b>${telegramEscapeHtml(customerStatusMessage(order.status))}</b>`);
        return;
      }
      const claim = await env.DB.prepare(`UPDATE orders SET status='provider_submitting', provider_error=NULL, updated_at=? WHERE id=? AND status='awaiting_approval'`)
        .bind(new Date().toISOString(), order.id).run();
      if (!claim.meta?.changes) {
        await telegramSendMessage(env, chatId, 'این سفارش قبلاً توسط فرآیند دیگری دریافت شده است.');
        return;
      }
      const fresh = await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(order.id).first();
      await telegramSendMessage(env, chatId, `🚀 سفارش <code>${telegramEscapeHtml(code)}</code> برای TG Tools ارسال شد.`);
      ctx?.waitUntil?.(deliverPremium(env, fresh));
      if (!ctx?.waitUntil) await deliverPremium(env, fresh);
      return;
    }
    return;
  }

  const message = update?.message;
  if (!message?.chat?.id) return;
  const chatId = message.chat.id;
  const fromId = String(message.from?.id || '');
  const text = String(message.text || '').trim();
  const adminId = String(await getSetting(env.DB, 'telegram_admin_id', ''));

  if (/^\/start(?:@\w+)?(?:\s|$)/i.test(text)) {
    await telegramSessionClear(env, chatId);
    const firstName = telegramEscapeHtml(message.from?.first_name || 'دوست عزیز');
    await telegramSendMessage(
      env,
      chatId,
      `👋 سلام <b>${firstName}</b>\n\nبه <b>بلوپرمیوم</b> خوش اومدی.\nخرید معمولی داخل خود ربات انجام می‌شود؛ مینی‌اپ هم از دکمه اختصاصی منوی ربات در دسترس است.`,
      { reply_markup: await telegramMainKeyboard(env, origin, fromId) }
    );
    return;
  }

  if (/^\/buy(?:@\w+)?(?:\s|$)/i.test(text)) {
    await telegramBeginPurchase(env, chatId, fromId);
    return;
  }

  if (/^\/support(?:@\w+)?(?:\s|$)/i.test(text)) {
    const support = telegramSupportUrl(await getSetting(env.DB, 'support', ''));
    if (support) {
      await telegramSendMessage(env, chatId, '☎️ برای ارتباط با پشتیبانی روی دکمه زیر بزن.', {
        reply_markup: { inline_keyboard: [[{ text: 'پشتیبانی بلوپرمیوم', url: support }]] }
      });
    } else {
      await telegramSendMessage(env, chatId, 'پشتیبانی هنوز در پنل مدیریت تنظیم نشده است.');
    }
    return;
  }

  if (/^\/admin(?:@\w+)?(?:\s|$)/i.test(text) && fromId === adminId) {
    await telegramSendMessage(env, chatId, await telegramAdminSummaryText(env), {
      reply_markup: { inline_keyboard: [[{ text: '⚙️ باز کردن پنل مدیریت', url: String(origin).replace(/\/$/, '') + '/admin' }]] }
    });
    return;
  }

  const statusCommand = text.match(/^\/status(?:@\w+)?(?:\s+(.+))?$/i);
  if (statusCommand) {
    const code = String(statusCommand[1] || '').trim();
    if (!code) {
      await telegramSessionSet(env, chatId, fromId, 'awaiting_status', {});
      await telegramSendMessage(env, chatId, 'کد سفارش را ارسال کن:\n<code>BP-XXXXXXXXXXXXXX</code>');
    } else {
      await telegramSendOrderStatus(env, chatId, fromId, code);
    }
    return;
  }

  const session = await telegramSessionGet(env, chatId);
  if (session?.state === 'awaiting_username') {
    const username = normalizeUsername(text);
    if (!username) {
      await telegramSendMessage(env, chatId, 'یوزرنیم معتبر نیست. لطفاً یوزرنیم تلگرام را با یا بدون @ ارسال کن.');
      return;
    }

    await telegramSendMessage(env, chatId, '⏳ حساب تلگرام در حال بررسی و فاکتور BluePal در حال ساخت است...');
    const created = await createTelegramBotBlupalOrder(env, {
      chatId,
      userId: fromId,
      planId: Number(session.data?.plan_id || 0),
      username,
    });

    if (!created.ok) {
      const errors = {
        plan_not_found: 'پلن انتخاب‌شده پیدا نشد.',
        plan_unavailable: 'این پلن فعلاً قابل خرید نیست.',
        payment_not_configured: 'درگاه BluePal ربات آماده نیست.',
        provider_not_configured: 'اتصال TG Tools هنوز تنظیم نشده است.',
        telegram_lookup_failed: 'بررسی حساب تلگرام انجام نشد؛ دوباره تلاش کن.',
        telegram_user_not_found: 'این حساب تلگرام پیدا نشد.',
        not_premium_eligible: 'این حساب فعلاً امکان دریافت Telegram Premium ندارد.',
        invoice_create_failed: 'ساخت فاکتور BluePal ناموفق بود.',
      };
      await telegramSendMessage(env, chatId, errors[created.error] || 'ثبت سفارش انجام نشد؛ دوباره تلاش کن.');
      return;
    }

    await telegramSessionClear(env, chatId);
    const order = created.order;
    await telegramSendMessage(
      env,
      chatId,
      `✅ <b>سفارش ثبت شد</b>\n\n🧾 کد: <code>${telegramEscapeHtml(order.order_code)}</code>\n👤 مقصد: @${telegramEscapeHtml(order.username)}\n📦 پلن: ${Number(order.months)} ماهه\n💳 مبلغ: ${new Intl.NumberFormat('fa-IR').format(Number(order.price_toman))} تومان\n\nبرای تکمیل سفارش، پرداخت را از BluePal انجام بده.`,
      {
        reply_markup: {
          inline_keyboard: [
            [{ text: '💳 پرداخت با BluePal', url: created.payment_url }],
            [{ text: '🔄 بررسی وضعیت پرداخت', callback_data: `check:${order.order_code}` }],
          ],
        },
      }
    );
    return;
  }

  if (session?.state === 'awaiting_status') {
    await telegramSessionClear(env, chatId);
    await telegramSendOrderStatus(env, chatId, fromId, text);
    return;
  }

  if (/^BP-[A-Z0-9]{6,40}$/i.test(text)) {
    await telegramSendOrderStatus(env, chatId, fromId, text);
    return;
  }

  await telegramSendMessage(env, chatId, 'یکی از گزینه‌های زیر را انتخاب کن 👇', {
    reply_markup: await telegramMainKeyboard(env, origin, fromId)
  });
}

