function bpDecorateExperience(html){return html.replace('</head>','<style id="bp-experience-v2">'+bpExperienceCss()+'</style></head>').replace('</body>','<script>('+bpExperienceClient.toString()+')()</script></body>');}

function bpExperienceCss(){return "\n.bp-experience{--bp-ink:#eef5ff;--bp-soft:#a2bad4}\n.bp-experience .shell{max-width:1100px}\n.bp-experience .product{display:none}\n.bp-experience .topbar{margin-bottom:14px}\n.bp-quick-entry{position:relative;isolation:isolate;margin:16px 0 24px;padding:23px 22px 19px;border-radius:28px;border:1px solid rgba(109,169,245,.22);background:radial-gradient(320px 200px at 20% 0%,rgba(49,124,250,.24),transparent 80%),linear-gradient(145deg,#101c34 0%,#091324 68%,#071120);box-shadow:0 22px 68px rgba(0,7,26,.3);overflow:hidden}\n.bp-quick-entry:after{content:\"\";position:absolute;pointer-events:none;z-index:-1;width:230px;height:230px;left:-100px;top:-100px;border:1px solid rgba(115,189,255,.16);border-radius:50%;box-shadow:0 0 0 36px rgba(55,136,253,.035),0 0 0 72px rgba(55,136,253,.025)}\n.bp-brandline{display:inline-flex;align-items:center;gap:9px;color:#83c4ff;font:800 11px/1.6 Tahoma,sans-serif}\n.bp-brandline:before{content:\"\";width:7px;height:7px;border-radius:50%;background:#4cdea9;box-shadow:0 0 0 5px rgba(76,222,169,.09)}\n.bp-quick-entry h1{margin:11px 0 6px;font-size:clamp(22px,3.4vw,34px);font-weight:900;line-height:1.6;letter-spacing:-.7px;color:#fff}\n.bp-quick-entry h1 span{color:#72beff}\n.bp-intro{max-width:550px;font-size:12px;line-height:2.05;color:#9ab1cf;margin:0 0 20px}\n.bp-quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n.bp-action-card{min-width:0;display:flex;flex-direction:column;align-items:flex-start;text-align:right;gap:8px;border-radius:23px;padding:19px 18px 16px;color:#f1f7ff;cursor:pointer;position:relative;overflow:hidden;border:1px solid rgba(158,187,242,.22);font-family:Tahoma,system-ui,sans-serif;transition:transform .18s ease,box-shadow .2s ease,border-color .2s}\n.bp-action-card:hover,.bp-action-card:focus-visible{transform:translateY(-2px);border-color:#86c8ff;box-shadow:0 14px 34px rgba(12,96,219,.16);outline:none}\n.bp-action-card:active{transform:scale(.98)}\n.bp-action-card.premium{background:radial-gradient(200px 140px at 4% 0%,rgba(116,167,254,.20),transparent),linear-gradient(155deg,#1b3565,#142446 72%,#122038)}\n.bp-action-card.stars{background:radial-gradient(200px 140px at 4% 0%,rgba(92,189,255,.20),transparent),linear-gradient(155deg,#164660,#11334d 72%,#13283a)}\n.bp-card-icon{display:grid;place-items:center;min-width:51px;height:51px;padding:0 8px;border-radius:16px;background:rgba(255,255,255,.095);border:1px solid rgba(255,255,255,.12);font-size:29px;line-height:1;box-shadow:inset 0 1px rgba(255,255,255,.10)}\n.bp-action-card strong{font-size:17px;line-height:1.5;font-weight:900}\n.bp-action-card small{min-height:35px;color:#a8bddc;font-size:11px;line-height:1.75}\n.bp-card-cta{font-size:12px;font-weight:800;margin-top:auto;color:#b7e2ff}\n.bp-card-cta:before{content:\"←\";margin-left:7px;font-size:15px}\n.bp-trust-strip{display:flex;gap:8px;justify-content:space-between;margin-top:17px;flex-wrap:wrap}\n.bp-trust-strip span{display:inline-flex;align-items:center;gap:7px;font:700 11px/1.9 Tahoma,sans-serif;color:#a8bfd9}\n.bp-trust-strip i{font-size:14px;font-style:normal;color:#5be2b5}\n.bp-discover{margin:2px 0 18px}\n.bp-discover-head{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:0 0 11px}\n.bp-discover-head h2{font-size:17px;line-height:1.6;margin:0;color:#f3f8ff}\n.bp-discover-head p{font-size:11px;color:#91acc9;margin:2px 0 0}\n.bp-discover-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}\n.bp-category{display:flex;flex-direction:column;gap:7px;align-items:center;justify-content:center;text-align:center;background:linear-gradient(150deg,#132640,#091725);border:1px solid rgba(133,176,236,.17);border-radius:17px;color:#e3efff;min-height:110px;padding:12px 7px;font:800 11px/1.55 Tahoma,sans-serif;cursor:pointer}\n.bp-category:hover,.bp-category:focus-visible{border-color:rgba(104,189,255,.7);background:#183456;outline:none}\n.bp-category span{width:46px;height:46px;border:1px solid rgba(141,196,245,.16);background:rgba(80,147,244,.12);border-radius:15px;display:grid;place-items:center;font-size:25px}\n.bp-experience .section-title{margin-top:24px}\n.bp-experience .section-title h2{font-size:18px}\n.bp-experience .section-title p,.bp-experience .section-title span{font-size:11px}\n.bp-experience .plans{scroll-margin-top:100px}\n.bp-experience .plans .plan{border-radius:20px}\n.bp-experience .checkout{scroll-margin-top:90px}\n.bp-experience .tg-store{border-radius:24px;scroll-margin-top:95px;box-shadow:0 14px 44px rgba(0,0,0,.15)}\n.bp-experience .tg-categories{scroll-snap-type:x proximity}\n.bp-experience .tg-categories button{scroll-snap-align:start;min-height:42px;flex-shrink:0}\n.bp-experience .tg-item{min-height:154px;display:flex;flex-direction:column;justify-content:space-between}\n.bp-experience .tg-item button{min-height:40px}\n.bp-experience .tg-store button:focus-visible{outline:2px solid #8bd0ff;outline-offset:2px}\n.bp-experience .bp-account-widget{scroll-margin-top:95px}\n@media(max-width:700px){\n .bp-experience .shell{padding-bottom:calc(112px + env(safe-area-inset-bottom))}\n .bp-experience .topbar{margin-bottom:8px}\n .bp-quick-entry{padding:19px 15px 16px;margin:8px 0 24px;border-radius:24px}\n .bp-quick-entry h1{font-size:24px;letter-spacing:-.4px}\n .bp-intro{font-size:11px;line-height:1.9;margin-bottom:16px}\n .bp-quick-grid{gap:9px}\n .bp-action-card{border-radius:18px;padding:13px 12px;gap:7px;min-height:205px}\n .bp-card-icon{min-width:43px;height:43px;border-radius:13px;font-size:24px}\n .bp-action-card strong{font-size:14px}\n .bp-action-card small{font-size:10px;line-height:1.8}\n .bp-card-cta{font-size:11px}\n .bp-trust-strip{justify-content:flex-start;column-gap:14px;row-gap:4px}\n .bp-trust-strip span{font-size:10px}\n .bp-discover-grid{gap:7px;grid-template-columns:repeat(4,minmax(0,1fr))}\n .bp-category{font-size:10px;border-radius:15px;min-height:93px;padding:9px 3px}\n .bp-category span{width:39px;height:39px;font-size:21px;border-radius:12px}\n .bp-experience .mobile-cta{display:none!important}\n .bp-experience .app-nav{grid-template-columns:repeat(5,minmax(0,1fr));height:70px;z-index:48;background:rgba(8,18,34,.97);border-color:rgba(125,176,244,.22)}\n .bp-experience .app-nav button{font-size:10px;gap:4px}\n .bp-experience .app-nav .ico{width:21px;height:21px}\n .bp-experience .app-nav .bp-stars-nav{font-size:10px}\n .bp-experience .app-nav .bp-stars-nav b{font-size:20px;line-height:1}\n .bp-experience .tg-store{margin:18px 0}\n}\n@media(max-width:360px){.bp-action-card strong{font-size:12px}.bp-action-card small{font-size:9px}.bp-category{font-size:9px}}\n@media(prefers-reduced-motion:reduce){.bp-experience .bp-action-card{transition:none}.bp-experience .bp-action-card:hover{transform:none}}";}

function bpExperienceClient(){
  if(document.body.classList.contains('bp-experience'))return;
  document.body.classList.add('bp-experience');
  const main=document.querySelector('main.shell');
  const header=main?.querySelector('.topbar');
  if(!main||!header)return;
  const hero=document.createElement('section');
  hero.className='bp-quick-entry';hero.setAttribute('aria-label','خرید سریع بلوپرمیوم');
  hero.innerHTML=[
    '<div class="bp-brandline">فروشگاه رسمی بلوپرمیوم</div>',
    '<h1>پرمیوم و استارز، <span>سریع و ساده.</span></h1>',
    '<p class="bp-intro">خرید خدمات تلگرام با قیمت شفاف، پیگیری سفارش و تجربه‌ای یکپارچه در بلوپرمیوم.</p>',
    '<div class="bp-quick-grid">',
    '<button class="bp-action-card premium" type="button" data-bp-target="premium">',
    '<span class="bp-card-icon" aria-hidden="true">👑</span>',
    '<strong>تلگرام پرمیوم</strong><small>پلن دلخواهت رو انتخاب کن و مستقیم خرید کن.</small>',
    '<span class="bp-card-cta">انتخاب پلن</span></button>',
    '<button class="bp-action-card stars" type="button" data-bp-target="stars">',
    '<span class="bp-card-icon" aria-hidden="true">⭐</span>',
    '<strong>استارز تلگرام</strong><small>برای خودت یا دوستات، بسته استارز بخر.</small>',
    '<span class="bp-card-cta">خرید استارز</span></button>',
    '</div>',
    '<div class="bp-trust-strip"><span><i>✓</i>قیمت‌های به‌روز</span><span><i>✓</i>پرداخت امن</span><span><i>✓</i>پیگیری سفارش</span></div>'
  ].join('');
  header.insertAdjacentElement('afterend',hero);
  const discover=document.createElement('section');discover.className='bp-discover';
  discover.setAttribute('aria-label','سایر محصولات دیجیتال');
  discover.innerHTML=[
    '<div class="bp-discover-head"><div><h2>دنیای محصولات دیجیتال</h2><p>خدمات بیشتر، در یک فروشگاه</p></div></div>',
    '<div class="bp-discover-grid">',
    '<button type="button" class="bp-category" data-bp-kind="gift"><span aria-hidden="true">🎁</span>گیفت تلگرام</button>',
    '<button type="button" class="bp-category" data-bp-kind="catalog"><span aria-hidden="true">🎮</span>گیفت‌کارت</button>',
    '<button type="button" class="bp-category" data-bp-kind="nft"><span aria-hidden="true">💎</span>گیفت NFT</button>',
    '<button type="button" class="bp-category" data-bp-kind="steam"><span aria-hidden="true">🎯</span>شارژ Steam</button>',
    '</div>'
  ].join('');
  hero.insertAdjacentElement('afterend',discover);
  const nav=document.querySelector('.app-nav');
  if(nav&&!nav.querySelector('.bp-stars-nav')){
    const btn=document.createElement('button');btn.type='button';btn.className='bp-stars-nav';btn.dataset.nav='stars';
    btn.innerHTML='<b aria-hidden="true">★</b><span>استارز</span>';
    const buy=nav.querySelector('[data-nav="buy"]');
    if(buy)buy.insertAdjacentElement('beforebegin',btn);else nav.appendChild(btn);
    btn.addEventListener('click',()=>openMarket('stars'));
  }
  function jumpTo(id){
    const target=document.getElementById(id);
    if(target)target.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'});
  }
  function openMarket(kind){
    if(typeof window.bpSelectMarketKind==='function')window.bpSelectMarketKind(kind);
    else document.querySelector('#tgCategories button[data-kind="'+kind+'"]')?.click();
    jumpTo('tg-digital-shop');
    document.querySelectorAll('.app-nav button').forEach(x=>x.classList.toggle('active',x.dataset.nav==='stars'));
  }
  hero.addEventListener('click',event=>{
    const btn=event.target.closest('[data-bp-target]');if(!btn)return;
    if(btn.dataset.bpTarget==='premium')jumpTo('plans');
    if(btn.dataset.bpTarget==='stars')openMarket('stars');
  });
  discover.addEventListener('click',event=>{
    const btn=event.target.closest('[data-bp-kind]');
    if(btn)openMarket(btn.dataset.bpKind);
  });
  document.getElementById('tg-digital-shop')?.setAttribute('aria-label','فروشگاه استارز و محصولات دیجیتال');
}