function bpDecorateExperience(html){return html.replace('</head>','<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"><style id="bp-experience-v4">'+bpExperienceCss()+'</style></head>').replace('</body>','<script>('+bpExperienceClient.toString()+')()</script></body>');}

function bpExperienceCss(){return "\n/* BluePremium app shell v3: genuine views instead of scrolling to stacked sections */\nhtml:has(.bp-shell-v3){scroll-padding-top:94px}\nbody.bp-shell-v3{min-height:100dvh;overflow-x:hidden;background:radial-gradient(480px 360px at 80% 0%,#102c4e70,transparent 80%),#060e1b}\n.bp-shell-v3 .shell{max-width:1050px;padding:9px 16px calc(105px + env(safe-area-inset-bottom,0px))}\n.bp-shell-v3 .topbar{position:sticky;top:0;z-index:35;margin:0 -16px;padding:12px 18px 11px;background:rgba(6,14,27,.91);backdrop-filter:blur(20px);border-bottom:1px solid rgba(146,187,245,.09)}\n.bp-shell-v3 .product{display:none!important}\n.bp-shell-v3 .mobile-cta{display:none!important}\n.bp-shell-v3 .bp-tab-view[hidden]{display:none!important}\n.bp-shell-v3 .bp-tab-view{animation:bpTabIn .19s ease-out both;min-height:calc(100dvh - 210px);outline:none}\n@keyframes bpTabIn{from{opacity:.45;transform:translateY(5px)}to{opacity:1;transform:none}}\n.bp-shell-v3 .bp-tab-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:18px 0 17px}\n.bp-shell-v3 .bp-tab-heading h1{font-size:21px;color:#f5faff;margin:0;font-weight:900;line-height:1.6}\n.bp-shell-v3 .bp-tab-heading p{font-size:12px;color:#9cafd0;margin:4px 0 0;line-height:1.85}\n.bp-shell-v3 .bp-tab-symbol{flex:0 0 auto;width:46px;height:46px;border-radius:15px;background:linear-gradient(145deg,#1e4d8c,#132947);display:grid;place-items:center;font-size:22px;border:1px solid rgba(162,201,255,.17)}\n.bp-shell-v3 .bp-hero{position:relative;overflow:hidden;border:1px solid #2b51819e;border-radius:24px;padding:24px 19px 19px;background:radial-gradient(320px 210px at 5% 0%,#3179dc55,transparent),linear-gradient(140deg,#132d51,#0b1c33 76%);box-shadow:0 22px 55px #00000032}\n.bp-shell-v3 .bp-hero:before{content:\"\";position:absolute;left:-72px;top:-89px;width:220px;height:220px;border:1px solid #8dbfff38;border-radius:50%;box-shadow:0 0 0 37px #6cadff0b,0 0 0 72px #6cadff09;pointer-events:none}\n.bp-shell-v3 .bp-eyebrow{display:inline-flex;align-items:center;gap:7px;color:#96d0ff;font-size:11px;font-weight:800}\n.bp-shell-v3 .bp-eyebrow:before{content:\"\";width:6px;height:6px;border-radius:50%;background:#49e2af}\n.bp-shell-v3 .bp-hero h1{font-size:clamp(25px,5vw,39px);line-height:1.43;letter-spacing:-.6px;margin:13px 0 9px}\n.bp-shell-v3 .bp-hero h1 em{color:#72c7ff;font-style:normal}\n.bp-shell-v3 .bp-hero p{font-size:12px;line-height:2;color:#aac1dd;max-width:440px;margin:0 0 19px}\n.bp-shell-v3 .bp-quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}\n.bp-shell-v3 .bp-quick-card{display:flex;position:relative;align-items:flex-start;text-align:right;flex-direction:column;gap:8px;min-height:175px;padding:16px;cursor:pointer;border-radius:20px;border:1px solid #8dbbfb3d;color:#eff7ff;font-family:Tahoma,\"Segoe UI\",sans-serif;transition:transform .2s ease,border-color .2s ease}\n.bp-shell-v3 .bp-quick-card:active{transform:scale(.985)}\n.bp-shell-v3 .bp-quick-card:focus-visible,.bp-shell-v3 .bp-category:focus-visible{outline:2px solid #73caff;outline-offset:3px}\n.bp-shell-v3 .bp-quick-card.premium{background:linear-gradient(145deg,#214778,#142746)}\n.bp-shell-v3 .bp-quick-card.stars{background:linear-gradient(145deg,#205f78,#123445)}\n.bp-shell-v3 .bp-quick-icon{width:49px;height:49px;border:1px solid #ffffff20;border-radius:15px;display:grid;place-items:center;background:#ffffff14;font-size:26px}\n.bp-shell-v3 .bp-quick-card strong{font-size:17px;line-height:1.5}\n.bp-shell-v3 .bp-quick-card small{font-size:11px;color:#a9c7e2;line-height:1.8}\n.bp-shell-v3 .bp-quick-card .bp-inline-arrow{color:#a4dcff;font-size:11px;margin-top:auto;font-weight:800}\n.bp-shell-v3 .bp-discover{margin:23px 0}\n.bp-shell-v3 .bp-discover h2{font-size:17px;margin:0 0 4px}\n.bp-shell-v3 .bp-discover p{font-size:11px;margin:0 0 13px;color:#96b0ce}\n.bp-shell-v3 .bp-discover-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}\n.bp-shell-v3 .bp-category{min-height:95px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;border:1px solid #96bdf52a;border-radius:17px;background:#10213a;color:#e8f5ff;font:800 11px/1.45 Tahoma;cursor:pointer}\n.bp-shell-v3 .bp-category span{display:grid;place-items:center;width:40px;height:40px;border-radius:13px;background:#2677bf22;font-size:22px}\n.bp-shell-v3 .bp-app-nav{position:fixed;z-index:50;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:2px;bottom:calc(8px + env(safe-area-inset-bottom,0px));right:10px;left:10px;max-width:770px;margin:auto;padding:7px 5px;border:1px solid #82b8fb35;border-radius:24px;background:rgba(10,23,42,.97);backdrop-filter:blur(21px);box-shadow:0 16px 40px #0008}\n.bp-shell-v3 .bp-app-nav button{border:none;border-radius:15px;display:flex;flex-direction:column;gap:4px;justify-content:center;align-items:center;min-width:0;height:58px;cursor:pointer;background:transparent;color:#94aecb;font:700 10px Tahoma,\"Segoe UI\",sans-serif}\n.bp-shell-v3 .bp-app-nav button .bp-nav-icon{font-size:20px;height:25px;line-height:25px}\n.bp-shell-v3[data-bp-active=\"home\"] .bp-app-nav [data-bp-tab=\"home\"],\n.bp-shell-v3[data-bp-active=\"premium\"] .bp-app-nav [data-bp-tab=\"premium\"],\n.bp-shell-v3[data-bp-active=\"stars\"] .bp-app-nav [data-bp-tab=\"stars\"],\n.bp-shell-v3[data-bp-active=\"catalog\"] .bp-app-nav [data-bp-tab=\"catalog\"],\n.bp-shell-v3[data-bp-active=\"orders\"] .bp-app-nav [data-bp-tab=\"orders\"],\n.bp-shell-v3[data-bp-active=\"account\"] .bp-app-nav [data-bp-tab=\"account\"]{background:#173a66;color:#f7fbff}\n.bp-shell-v3 .bp-app-nav button:focus-visible{outline:2px solid #78cbff;outline-offset:-2px}\n.bp-shell-v3 .bp-premium-view .section-title{margin:15px 0 12px}\n.bp-shell-v3 .bp-premium-view .section-title h2{font-size:16px}\n.bp-shell-v3 .bp-premium-view .section-title p,.bp-shell-v3 .bp-premium-view .section-title span{font-size:11px}\n.bp-shell-v3 .bp-premium-view .plans{scroll-margin-top:90px}\n.bp-shell-v3 .bp-premium-view .checkout{display:flex;flex-direction:column;gap:13px;margin:12px 0}\n.bp-shell-v3 .bp-premium-view .checkout .box{border-radius:22px}\n.bp-shell-v3 .bp-premium-view .checkout .summary{order:2}\n.bp-shell-v3 .bp-premium-view .checkout .hint{font-size:11px}\n.bp-shell-v3 .bp-premium-view .checkout .field label{font-size:12px}\n.bp-shell-v3 .bp-premium-view .checkout .btn{font-size:12px}\n.bp-shell-v3 .bp-premium-view .checkout .summary-row{font-size:11px}\n.bp-shell-v3 .bp-premium-view .checkout .summary-row b{font-size:12px}\n.bp-shell-v3 .bp-market-view .tg-store{margin:0 0 17px;max-width:none;border-radius:22px;padding:16px}\n.bp-shell-v3 .bp-market-view .tg-store h2{display:none}\n.bp-shell-v3 .bp-market-view .tg-store>p:first-of-type{font-size:11px;line-height:1.8;margin:3px 0 14px}\n.bp-shell-v3 .bp-market-view .tg-items{grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:11px}\n.bp-shell-v3 .bp-market-view .tg-item{min-height:145px;display:flex;flex-direction:column;justify-content:space-between}\n.bp-shell-v3 .bp-market-view .tg-item b{font-size:13px}\n.bp-shell-v3 .bp-market-view .tg-item button{min-height:43px}\n.bp-shell-v3 .bp-market-view .tg-categories{scrollbar-width:none}\n.bp-shell-v3 .bp-market-view .tg-categories button{flex:0 0 auto;min-height:42px;scroll-snap-align:center}\n.bp-shell-v3 .bp-account-view .bp-account-widget{margin:0;max-width:none}\n.bp-shell-v3 .bp-orders-card{padding:16px;border:1px solid #8dadf638;border-radius:21px;background:linear-gradient(155deg,#112642,#0a1829);margin-bottom:13px}\n.bp-shell-v3 .bp-orders-card h2{font-size:14px;margin:0 0 9px;line-height:1.8}\n.bp-shell-v3 .bp-orders-card p{font-size:11px;color:#9db6d1;line-height:1.9;margin:0 0 8px}\n.bp-shell-v3 .bp-orders-card .order{margin-top:13px}\n.bp-shell-v3 .bp-orders-card .tg-order{margin:13px 0 0}\n.bp-shell-v3 .bp-orders-card .bp-empty{padding:14px;border:1px dashed #7997bd50;border-radius:14px;text-align:center;color:#8ca7c3;font-size:12px;line-height:1.9}\n.bp-shell-v3 .bp-orders-card .bp-link-button{border:1px solid #508bc950;border-radius:12px;background:#122b4b;color:#cbe9ff;font:800 11px Tahoma;padding:10px 13px;cursor:pointer}\n@media(max-width:700px){\n .bp-shell-v3 .shell{padding:9px 12px calc(105px + env(safe-area-inset-bottom,0px))}\n .bp-shell-v3 .topbar{margin:0 -12px;padding:9px 14px 12px}\n .bp-shell-v3 .bp-tab-view{min-height:calc(100dvh - 200px)}\n .bp-shell-v3 .bp-hero{padding:20px 15px 17px;border-radius:23px}\n .bp-shell-v3 .bp-hero h1{font-size:26px}\n .bp-shell-v3 .bp-hero p{font-size:11px}\n .bp-shell-v3 .bp-quick-grid{gap:9px}\n .bp-shell-v3 .bp-quick-card{min-height:160px;padding:13px 11px;border-radius:17px;gap:6px}\n .bp-shell-v3 .bp-quick-icon{width:43px;height:43px;font-size:23px;border-radius:13px}\n .bp-shell-v3 .bp-quick-card strong{font-size:14px}\n .bp-shell-v3 .bp-quick-card small{font-size:10px}\n .bp-shell-v3 .bp-quick-card .bp-inline-arrow{font-size:10px}\n .bp-shell-v3 .bp-discover-grid{gap:7px}\n .bp-shell-v3 .bp-category{border-radius:15px;font-size:10px;min-height:86px}\n .bp-shell-v3 .bp-category span{width:36px;height:36px;font-size:21px}\n .bp-shell-v3 .bp-premium-view .plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));overflow:visible;scroll-snap-type:none;gap:8px;margin:0;padding:0}\n .bp-shell-v3 .bp-premium-view .plans .plan{min-width:0;max-width:none;min-height:155px;padding:11px 9px}\n .bp-shell-v3 .bp-premium-view .plans .months{font-size:23px}\n .bp-shell-v3 .bp-premium-view .plans .price{font-size:13px;line-height:1.75;overflow-wrap:anywhere}\n .bp-shell-v3 .bp-premium-view .plans .plan-note{display:none}\n .bp-shell-v3 .bp-premium-view .checkout .actions{grid-template-columns:1fr}\n .bp-shell-v3 .bp-market-view .tg-items{grid-template-columns:repeat(2,minmax(0,1fr))}\n .bp-shell-v3 .bp-app-nav{bottom:calc(7px + env(safe-area-inset-bottom,0px));right:7px;left:7px;padding:6px 3px}\n .bp-shell-v3 .bp-app-nav button{font-size:9px;height:56px}\n .bp-shell-v3 .bp-app-nav button .bp-nav-icon{font-size:19px}\n}\n@media(max-width:360px){.bp-shell-v3 .bp-app-nav button{font-size:8px}.bp-shell-v3 .bp-quick-card strong{font-size:12px}.bp-shell-v3 .bp-category{font-size:9px}}\n@media(prefers-reduced-motion:reduce){.bp-shell-v3 .bp-tab-view{animation:none}.bp-shell-v3 .bp-quick-card{transition:none}}\n\n.bp-shell-v3 .bp-app-nav button .bp-nav-icon{display:grid;place-items:center;height:25px;width:26px}\n.bp-shell-v3 .bp-app-nav button .bp-nav-icon svg{display:block;width:21px;height:21px}\n@media(max-width:360px){.bp-shell-v3 .bp-app-nav button .bp-nav-icon svg{width:19px;height:19px}}\n\n/* ---------------------------------------------------------------------------\n   BLUE PREMIUM / EDITORIAL EDITION\n   An authored visual identity: parchment, charcoal, persimmon and sage.\n   --------------------------------------------------------------------------- */\n:root:has(.bp-shell-v3){color-scheme:light;\n  --bg:#F7F4EE;--surface:#FFFDF8;--surface2:#F2EBE0;--surface3:#EDE4D7;\n  --line:rgba(53,45,38,.12);--text:#292323;--muted:#817A70;--blue:#CE634E;\n  --blue2:#E1AA7A;--gold:#D0A15F;--green:#6A937C;\n  --shadow:0 17px 48px rgba(68,48,29,.065)}\nhtml:has(.bp-shell-v3){background:#F7F4EE!important;color-scheme:light}\nbody.bp-shell-v3{background:#F7F4EE!important;color:#292323!important;\n  font-family:\"Vazirmatn\",\"Noto Sans Arabic\",\"Segoe UI\",Tahoma,sans-serif!important}\nbody.bp-shell-v3:before{display:none!important}\n.bp-shell-v3 *{font-family:inherit}\n.bp-shell-v3 .shell{max-width:980px}\n.bp-shell-v3 .topbar{background:rgba(247,244,238,.96)!important;\n  border-bottom:1px solid #E7DFD2!important;box-shadow:none!important;backdrop-filter:blur(15px)}\n.bp-shell-v3 .brand-name{color:#2A2422!important;letter-spacing:-.4px;font-weight:850}\n.bp-shell-v3 .brand-name small{color:#8C8176!important;font-size:9px!important;letter-spacing:2px}\n.bp-shell-v3 .brand-logo{border-radius:15px;border:1px solid #E7E1D7;box-shadow:0 4px 12px #2E23140C!important}\n.bp-shell-v3 .topbar button,.bp-shell-v3 .topbar .icon-btn{color:#392C27!important}\n.bp-shell-v3 .bp-tab-view{animation:bpNewView .22s cubic-bezier(.2,.75,.2,1) both}\n@keyframes bpNewView{from{opacity:.48;transform:translateY(7px)}to{opacity:1;transform:none}}\n.bp-shell-v3 .bp-hero{background:#30262D!important;border:0!important;border-radius:30px!important;\n  padding:28px 25px 25px!important;box-shadow:0 20px 38px #35222A20!important;min-height:259px;\n  isolation:isolate}\n.bp-shell-v3 .bp-hero:before{display:none}\n.bp-shell-v3 .bp-hero:after{content:\"\";position:absolute;left:-102px;top:-87px;width:330px;height:330px;\n  border:1px solid #FFFFFF28;border-radius:50%;box-shadow:0 0 0 41px #FFFFFF08,0 0 0 84px #FFFFFF08;\n  pointer-events:none;z-index:-1}\n.bp-shell-v3 .bp-hero .bp-editorial-tag{font:600 9px/1.8 \"Vazirmatn\",sans-serif;letter-spacing:2px;\n  color:#F2D9CB;display:flex;gap:10px;align-items:center;direction:ltr;justify-content:flex-end}\n.bp-shell-v3 .bp-led{width:7px;height:7px;display:inline-block;background:#F69B83;border-radius:50%;\n  box-shadow:0 0 0 5px #E7927D22}\n.bp-shell-v3 .bp-tag-divider{width:18px;height:1px;background:#F5E3D477}\n.bp-shell-v3 .bp-hero h1{font-size:clamp(28px,5vw,43px)!important;line-height:1.55!important;\n  margin:32px 0 4px!important;font-weight:900;letter-spacing:-1.3px;color:#FFF7EE;position:relative;z-index:1}\n.bp-shell-v3 .bp-hero h1 em{color:#ECA28A!important;font-style:normal}\n.bp-shell-v3 .bp-hero p{color:#D8C7C7!important;font-size:12px!important;max-width:350px;\n  line-height:2.1!important;margin-bottom:19px!important;position:relative;z-index:1}\n.bp-shell-v3 .bp-hero-art{position:absolute;left:8px;top:18px;width:220px;height:220px;\n  transform:rotate(-16deg);filter:drop-shadow(0 25px 21px #0005);opacity:.97;pointer-events:none}\n.bp-shell-v3 .bp-hero-art .bp-art{width:100%;height:100%}\n.bp-shell-v3 .bp-hero-foot{display:flex;justify-content:space-between;align-items:center;color:#E5CCC1;\n  font:600 9px/1.7 Georgia,serif;letter-spacing:2.5px;direction:ltr;border-top:1px solid #FFFFFF20;\n  padding-top:13px;margin-top:6px}\n.bp-shell-v3 .bp-hero-arrow{display:grid;place-items:center;width:31px;height:31px;border-radius:50%;\n  border:1px solid #FFF9F480;color:#FFF8F3;font-size:16px}\n.bp-shell-v3 .bp-featured,.bp-shell-v3 .bp-discover{margin-top:27px;margin-bottom:23px}\n.bp-shell-v3 .bp-section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:8px;\n  margin-bottom:13px}\n.bp-shell-v3 .bp-section-head h2{margin:2px 0 0!important;font-size:20px!important;font-weight:900;color:#302A29;\n  letter-spacing:-.7px;line-height:1.65}\n.bp-shell-v3 .bp-overline{font:600 9px/1.7 Georgia,serif;letter-spacing:2px;color:#C36D5B;direction:ltr}\n.bp-shell-v3 .bp-section-note{font-size:10px;color:#8B817A}\n.bp-shell-v3 .bp-quick-grid{gap:13px}\n.bp-shell-v3 .bp-quick-card{border:0!important;border-radius:25px!important;min-height:264px;\n  padding:18px 18px 16px!important;gap:5px;box-shadow:none!important;\n  transition:transform .22s ease,box-shadow .22s ease!important}\n.bp-shell-v3 .bp-quick-card:active{transform:translateY(2px) scale(.985)}\n.bp-shell-v3 .bp-quick-card.premium{background:#F5D2C3!important;color:#322622!important}\n.bp-shell-v3 .bp-quick-card.stars{background:#CBDCD0!important;color:#243B31!important}\n.bp-shell-v3 .bp-quick-card:hover{box-shadow:0 13px 23px #6F4E3722!important;transform:translateY(-3px)}\n.bp-shell-v3 .bp-card-label{color:#8D6258;font:700 9px/1.5 Georgia,serif;letter-spacing:1.6px;direction:ltr}\n.bp-shell-v3 .bp-quick-card.stars .bp-card-label{color:#4C7867}\n.bp-shell-v3 .bp-quick-icon{display:block;background:transparent!important;border:0!important;\n  width:100%!important;height:129px!important;padding:0!important;min-width:0!important;\n  border-radius:0!important;box-shadow:none!important;align-self:center;text-align:center}\n.bp-shell-v3 .bp-quick-icon .bp-art{height:135px;width:135px;max-width:100%;filter:drop-shadow(0 7px 8px #644C3A29)}\n.bp-shell-v3 .bp-quick-card strong{font-size:18px!important;font-weight:900;line-height:1.6!important;color:inherit!important}\n.bp-shell-v3 .bp-quick-card small{color:#765F5C!important;min-height:auto;font-size:11px!important;line-height:1.85}\n.bp-shell-v3 .bp-quick-card.stars small{color:#47665B!important}\n.bp-shell-v3 .bp-inline-arrow{display:flex;justify-content:space-between;align-items:center;gap:4px;\n  font-size:11px!important;font-weight:800;color:#543A36!important;margin-top:auto;width:100%;\n  border-top:1px solid #62443526;padding-top:10px}\n.bp-shell-v3 .bp-quick-card.stars .bp-inline-arrow{color:#355F50!important}\n.bp-shell-v3 .bp-discover-grid{gap:10px}\n.bp-shell-v3 .bp-category{background:#FFFFFF!important;border:1px solid #E9E2D9!important;\n  border-radius:21px!important;padding:13px 7px!important;min-height:146px;\n  box-shadow:0 5px 14px #6C57450A;color:#34302D!important;text-align:center;gap:7px!important}\n.bp-shell-v3 .bp-category:nth-child(2){background:#FAEEE0!important}\n.bp-shell-v3 .bp-category:nth-child(3){background:#F1E9F5!important}\n.bp-shell-v3 .bp-category:nth-child(4){background:#E9F1EE!important}\n.bp-shell-v3 .bp-category span{display:flex!important;width:100%!important;height:78px!important;\n  background:transparent!important;border:0!important;border-radius:0!important}\n.bp-shell-v3 .bp-category .bp-art{height:81px;width:83px}\n.bp-shell-v3 .bp-category strong{font-size:12px;font-weight:850;color:#322D2C;white-space:nowrap}\n.bp-shell-v3 .bp-category small{font:600 7px/1.4 Georgia,serif;letter-spacing:.3px;color:#9A8F85;direction:ltr}\n.bp-shell-v3 .bp-category:hover{transform:translateY(-3px);border-color:#C8B6A4!important}\n.bp-shell-v3 .bp-tab-heading{margin:23px 0 20px}\n.bp-shell-v3 .bp-tab-heading h1{font-size:24px!important;color:#2B2826!important;font-weight:900;letter-spacing:-.7px}\n.bp-shell-v3 .bp-tab-heading p{font-size:11px!important;color:#857A72!important}\n.bp-shell-v3 .bp-tab-symbol{background:#F0E6DA!important;border:1px solid #E6D9C9!important;\n  border-radius:18px!important;width:61px;height:61px;padding:5px!important}\n.bp-shell-v3 .bp-tab-symbol .bp-art{height:100%;width:100%}\n.bp-shell-v3 .bp-app-nav{background:rgba(43,36,39,.97)!important;border:1px solid #5C4B4C!important;\n  border-radius:21px!important;box-shadow:0 17px 36px #382E3270!important;max-width:710px;\n  padding:8px 5px}\n.bp-shell-v3 .bp-app-nav button{color:#D4C5BE!important;min-height:60px;transition:background .15s ease}\n.bp-shell-v3[data-bp-active=\"home\"] .bp-app-nav [data-bp-tab=\"home\"],\n.bp-shell-v3[data-bp-active=\"premium\"] .bp-app-nav [data-bp-tab=\"premium\"],\n.bp-shell-v3[data-bp-active=\"stars\"] .bp-app-nav [data-bp-tab=\"stars\"],\n.bp-shell-v3[data-bp-active=\"catalog\"] .bp-app-nav [data-bp-tab=\"catalog\"],\n.bp-shell-v3[data-bp-active=\"orders\"] .bp-app-nav [data-bp-tab=\"orders\"],\n.bp-shell-v3[data-bp-active=\"account\"] .bp-app-nav [data-bp-tab=\"account\"]{\n  background:#F7E8D9!important;color:#3E2B2B!important;border-radius:15px}\n.bp-shell-v3 .bp-app-nav .bp-nav-icon svg{stroke-width:1.7}\n.bp-shell-v3 .bp-premium-view .section-title h2{color:#332C29!important}\n.bp-shell-v3 .bp-premium-view .section-title p,.bp-shell-v3 .bp-premium-view .section-title span{color:#817971!important}\n.bp-shell-v3 .plans .plan{border:1px solid #E5D8C9!important;background:#FFFCF7!important;\n  border-radius:21px!important;box-shadow:0 7px 20px #5546380C!important;min-height:169px}\n.bp-shell-v3 .plans .plan:nth-child(2){background:#F6EBE3!important}\n.bp-shell-v3 .plans .plan:nth-child(3){background:#F0EFE7!important}\n.bp-shell-v3 .plans .plan:after{background:radial-gradient(circle,#DEBE9E41,transparent 74%)!important}\n.bp-shell-v3 .plans .plan.active{border-color:#BA6B52!important;box-shadow:inset 0 0 0 1px #BA6B52,0 12px 29px #B26F5518!important}\n.bp-shell-v3 .plans .selector{border-color:#CBB9AB!important;background:#FEFDFC!important}\n.bp-shell-v3 .plans .plan.active .selector{background:#C96954!important;border-color:#C96954!important}\n.bp-shell-v3 .plans .months,.bp-shell-v3 .plans .months small{color:#3A2F2B!important}\n.bp-shell-v3 .plans .price{color:#B45C48!important;font-weight:900}\n.bp-shell-v3 .plans .type{color:#73665D!important}\n.bp-shell-v3 .plans .plan-label{color:#9C8172!important}\n.bp-shell-v3 .checkout .box,.bp-shell-v3 .bp-orders-card{background:#FFFDFA!important;border:1px solid #E9E0D5!important;\n  box-shadow:0 8px 24px #6E534614!important;border-radius:25px!important;color:#332E2B!important}\n.bp-shell-v3 .checkout .box h3,.bp-shell-v3 .bp-orders-card h2{color:#302B29!important;font-size:16px!important}\n.bp-shell-v3 .checkout .hint,.bp-shell-v3 .bp-orders-card p{color:#8A7E75!important;font-size:11px!important}\n.bp-shell-v3 .checkout .field label{color:#5F5148!important;font-weight:750}\n.bp-shell-v3 .checkout input,.bp-shell-v3 .checkout textarea,.bp-shell-v3 .checkout select{\n  background:#F9F5EE!important;color:#332D2A!important;border:1px solid #DED5C8!important;\n  border-radius:14px!important;font-size:14px!important}\n.bp-shell-v3 .checkout input::placeholder{color:#AC9E92}\n.bp-shell-v3 .checkout .btn.primary{background:#30262D!important;box-shadow:0 11px 21px #43313B30!important;\n  color:#FFF7EC!important;font-size:12px!important;border-radius:14px!important}\n.bp-shell-v3 .checkout .btn.secondary{background:#EEE6DB!important;color:#463B34!important;border-color:#DDD0C0!important}\n.bp-shell-v3 .checkout .step i{background:#EEE7DE!important;color:#7D7067!important;border-color:#E1D5C8!important}\n.bp-shell-v3 .checkout .step.on i{background:#D47560!important;color:#FFF!important;border-color:#D47560!important}\n.bp-shell-v3 .checkout .step,.bp-shell-v3 .checkout .summary-row{color:#625952!important}\n.bp-shell-v3 .checkout .step.on{color:#B86451!important}\n.bp-shell-v3 .checkout .summary-row b,.bp-shell-v3 .checkout .secure{color:#3A322D!important}\n.bp-shell-v3 .checkout .progress{background:#E8DED0!important}\n.bp-shell-v3 .checkout .progress i{background:#C66F55!important}\n.bp-shell-v3 .bp-market-view .tg-store{background:#FFFDF9!important;color:#342F2C!important;\n  border:1px solid #E6DCD0!important;box-shadow:0 8px 24px #69534214!important}\n.bp-shell-v3 .tg-store p,.bp-shell-v3 .tg-store label{color:#84776D!important}\n.bp-shell-v3 .tg-categories button{background:#F1EAE1!important;color:#5F4B43!important;\n  border-color:#E4D6C6!important;border-radius:100px!important;font-weight:750!important}\n.bp-shell-v3 .tg-categories button.selected{background:#33272D!important;color:#FFF7ED!important;border-color:#33272D!important}\n.bp-shell-v3 .tg-item{background:#F8F1E9!important;border:1px solid #E8D9CA!important;border-radius:19px!important;\n  box-shadow:0 5px 12px #5D47320B!important;color:#322D29!important}\n.bp-shell-v3 .tg-item:nth-child(4n+2){background:#EAF2E9!important;border-color:#D9E7D8!important}\n.bp-shell-v3 .tg-item:nth-child(4n+3){background:#F3E9F6!important;border-color:#E9DCEC!important}\n.bp-shell-v3 .tg-item:nth-child(4n+4){background:#F8E9E1!important;border-color:#EDD7CB!important}\n.bp-shell-v3 .tg-item b{font-size:13px!important;color:#332A28!important;font-weight:900}\n.bp-shell-v3 .tg-item small{color:#6D5C51!important;font-weight:750;font-size:12px!important}\n.bp-shell-v3 .tg-item button,.bp-shell-v3 .tg-paychoices button,#tgQuoteButton,.bp-shell-v3 .bp-link-button{\n  background:#3B2B33!important;color:#FFF7EC!important;border:0!important;border-radius:12px!important;\n  min-height:43px!important;font-size:12px!important;font-weight:800!important}\n.bp-shell-v3 .tg-item-art{height:69px;width:100%;display:flex;align-items:center;justify-content:center}\n.bp-shell-v3 .tg-item-art .bp-art{width:67px;height:67px;filter:drop-shadow(0 6px 5px #41332622)}\n.bp-shell-v3 .tg-checkout{background:#F7F2EB!important;border:1px solid #E7DACE!important;\n  padding:16px;border-radius:19px!important;max-width:100%!important}\n.bp-shell-v3 .tg-checkout input,.bp-shell-v3 #tgQuoteFields input,.bp-shell-v3 #tgQuoteFields select{\n  background:#FFFCF8!important;color:#37312E!important;border-color:#DCCFC2!important;\n  font:500 13px \"Vazirmatn\",Tahoma,sans-serif!important}\n.bp-shell-v3 .tg-order,.bp-shell-v3 .bp-orders-card .tg-order{background:#F4EDE3!important;\n  border-color:#DFD2C2!important;color:#443C36!important;border-radius:17px!important}\n.bp-shell-v3 .bp-orders-card .bp-empty{color:#8C7F72!important;border-color:#D8CAB9!important}\n.bp-shell-v3 #bp_account,.bp-shell-v3 .bp-account-widget{color:#342A2D!important}\n.bp-shell-v3 .bp-account-view :is(.card,.panel,.wallet-card){border-radius:20px}\n@media(max-width:700px){\n .bp-shell-v3 .shell{padding-bottom:calc(111px + env(safe-area-inset-bottom,0px))}\n .bp-shell-v3 .bp-hero{padding:21px 16px 18px!important;min-height:245px}\n .bp-shell-v3 .bp-hero h1{font-size:27px!important;max-width:77%;line-height:1.66!important;margin-top:40px!important}\n .bp-shell-v3 .bp-hero-art{width:146px;height:146px;top:35px;left:-32px;opacity:.86}\n .bp-shell-v3 .bp-hero p{font-size:10px!important;max-width:78%;margin-top:10px!important}\n .bp-shell-v3 .bp-hero .bp-editorial-tag{font-size:8px;letter-spacing:1.4px;gap:6px}\n .bp-shell-v3 .bp-section-head h2{font-size:17px!important}\n .bp-shell-v3 .bp-quick-grid{gap:10px}\n .bp-shell-v3 .bp-quick-card{padding:12px!important;min-height:235px}\n .bp-shell-v3 .bp-quick-icon{height:108px!important}\n .bp-shell-v3 .bp-quick-icon .bp-art{width:108px;height:108px}\n .bp-shell-v3 .bp-quick-card strong{font-size:14px!important}\n .bp-shell-v3 .bp-quick-card small{font-size:10px!important}\n .bp-shell-v3 .bp-card-label{font-size:8px}\n .bp-shell-v3 .bp-discover-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px}\n .bp-shell-v3 .bp-category{min-height:117px;padding:10px!important;display:grid;grid-template-columns:69px 1fr;grid-template-rows:auto auto;\n   text-align:right;justify-content:start;gap:2px 8px!important}\n .bp-shell-v3 .bp-category span{width:70px!important;height:78px!important;grid-row:1 / span 2;grid-column:1}\n .bp-shell-v3 .bp-category .bp-art{height:74px;width:74px}\n .bp-shell-v3 .bp-category strong{grid-row:1;grid-column:2;font-size:11px;align-self:end}\n .bp-shell-v3 .bp-category small{grid-row:2;grid-column:2;font-size:7px;align-self:start;white-space:normal}\n .bp-shell-v3 .bp-app-nav{left:8px;right:8px;bottom:calc(9px + env(safe-area-inset-bottom,0px));padding:6px 3px}\n .bp-shell-v3 .bp-app-nav button{font-size:9px!important;color:#E0CDC5!important}\n .bp-shell-v3 .bp-tab-heading h1{font-size:21px!important}\n .bp-shell-v3 .bp-tab-symbol{width:52px;height:52px}\n .bp-shell-v3 .plans .plan{min-height:161px;padding:11px 9px}\n .bp-shell-v3 .plans .months{font-size:23px}\n .bp-shell-v3 .plans .price{font-size:12px!important}\n .bp-shell-v3 .tg-item-art{height:61px}\n .bp-shell-v3 .tg-item-art .bp-art{width:56px;height:56px}\n}\n@media(prefers-reduced-motion:reduce){.bp-shell-v3 .bp-tab-view{animation:none}.bp-shell-v3 .bp-quick-card{transition:none}}\n";}

function bpExperienceClient(){
  const root=document.querySelector('main.shell');
  const header=root?.querySelector('.topbar');
  if(!root||!header||document.body.classList.contains('bp-shell-v3'))return;
  document.body.classList.add('bp-shell-v3');
  document.body.dataset.bpActive='home';
  // Vector illustrations created for BluePremium; no platform emojis or stock icons.
  const art=(type,variant='full')=>{
    const svg=(inner,view='0 0 160 160')=>'<svg class="bp-art bp-art-'+type+'" xmlns="http://www.w3.org/2000/svg" viewBox="'+view+'" fill="none" aria-hidden="true" focusable="false">'+inner+'</svg>';
    if(type==='premium')return svg('<defs><linearGradient id="bpCrownMetal" x1="26" y1="18" x2="130" y2="141"><stop stop-color="#FFF5C7"/><stop offset=".48" stop-color="#E6B768"/><stop offset="1" stop-color="#9B5839"/></linearGradient></defs>'+
      '<circle cx="80" cy="80" r="72" stroke="#FFF2D3" stroke-opacity=".36"/><circle cx="80" cy="80" r="54" stroke="#FFF2D3" stroke-opacity=".18"/>'+
      '<path d="m30 64 26 21 24-40 26 40 24-21-8 54H38L30 64Z" fill="url(#bpCrownMetal)" stroke="#FFE6A9" stroke-width="3" stroke-linejoin="round"/>'+
      '<path d="M44 102h72M50 112h60" stroke="#935534" stroke-opacity=".7" stroke-width="4" stroke-linecap="round"/>'+
      '<path d="M80 49 88 62 80 75 72 62 80 49Z" fill="#FFFBE8"/>'+
      '<circle cx="29" cy="62" r="5" fill="#FFEAC3"/><circle cx="80" cy="44" r="5" fill="#FFF5D9"/><circle cx="131" cy="62" r="5" fill="#FFEAC3"/>'+
      '<path d="M118 23v15M110 31h16" stroke="#FFF3DC" stroke-opacity=".9" stroke-width="3" stroke-linecap="round"/>');
    if(type==='stars')return svg('<defs><linearGradient id="bpStarMetal" x1="28" y1="10" x2="134" y2="148"><stop stop-color="#FFF8BB"/><stop offset=".48" stop-color="#FECF60"/><stop offset="1" stop-color="#DA813D"/></linearGradient></defs>'+
      '<circle cx="80" cy="82" r="65" fill="#A84B4B" fill-opacity=".18" stroke="#FFE9B1" stroke-opacity=".25" stroke-width="2"/>'+
      '<circle cx="80" cy="82" r="52" fill="#FFF2C5" fill-opacity=".10" stroke="#FFFFFF" stroke-opacity=".4" stroke-width="2"/>'+
      '<path d="M80 36 94.5 65.5 127 70 103.5 93 109 126 80 110.5 51 126 56.5 93 33 70 65.5 65.5 80 36Z" fill="url(#bpStarMetal)" stroke="#FFF3CF" stroke-width="3" stroke-linejoin="round"/>'+
      '<path d="m80 50 9 20 21 3-16 15 4 23-18-10-18 10 4-23-16-15 21-3 9-20Z" fill="#FFF5CA" fill-opacity=".28"/>'+
      '<path d="M129 25v22M118 36h22M24 113v16M16 121h16" stroke="#FFF8DD" stroke-width="3" stroke-linecap="round"/>');
    if(type==='gift')return svg('<ellipse cx="81" cy="139" rx="55" ry="12" fill="#713765" fill-opacity=".16"/>'+
      '<rect x="36" y="70" width="88" height="61" rx="9" fill="#D1A6F0" stroke="#633C83" stroke-width="3"/>'+
      '<rect x="28" y="58" width="104" height="24" rx="7" fill="#EEDAFF" stroke="#633C83" stroke-width="3"/>'+
      '<path d="M72 58h16v73H72z" fill="#8557A8"/><path d="M73 57c-24-1-30-10-25-22 7-17 32 0 32 22-1-26 25-38 33-22 7 15-7 23-33 22" stroke="#633C83" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>'+
      '<path d="M112 13v17M103 22h18" stroke="#7C4B92" stroke-width="3" stroke-linecap="round"/>');
    if(type==='catalog')return svg('<rect x="29" y="46" width="102" height="67" rx="17" fill="#F0C792" stroke="#754A37" stroke-width="3"/>'+
      '<rect x="35" y="54" width="90" height="54" rx="12" fill="#FFF1D7"/>'+
      '<path d="M29 70h102" stroke="#DAA572" stroke-width="13"/><circle cx="77" cy="84" r="16" fill="#F6B87C"/>'+
      '<path d="m69 85 6 6 14-16" stroke="#764737" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>'+
      '<rect x="56" y="34" width="87" height="59" rx="11" transform="rotate(-11 56 34)" fill="#B7D6BD" stroke="#537968" stroke-width="3"/>'+
      '<path d="m119 17 5 14M112 23l14-5" stroke="#6F9675" stroke-width="3" stroke-linecap="round"/>');
    if(type==='nft')return svg('<path d="m80 20 50 49-50 72-50-72 50-49Z" fill="#DCCAF0" stroke="#6B517E" stroke-width="3"/>'+
      '<path d="m80 20 17 48-17 73-17-73 17-48Z" fill="#F5E7FF"/>'+
      '<path d="M30 69h100L80 141 30 69Z" fill="#A987CB" fill-opacity=".33" stroke="#6B517E" stroke-width="2"/>'+
      '<path d="M30 69h100L80 20 30 69Z" stroke="#71558A" stroke-width="3" stroke-linejoin="round"/>'+
      '<path d="M130 29v17M121 37h18" stroke="#725783" stroke-width="3" stroke-linecap="round"/>');
    if(type==='steam')return svg('<rect x="20" y="49" width="120" height="72" rx="34" fill="#A8BCBA" stroke="#435F5C" stroke-width="4"/>'+
      '<path d="M50 72v32M34 88h32" stroke="#284B49" stroke-width="9" stroke-linecap="round"/>'+
      '<circle cx="102" cy="79" r="9" fill="#F4EEE4" stroke="#284B49" stroke-width="3"/>'+
      '<circle cx="119" cy="96" r="9" fill="#E8B5A1" stroke="#284B49" stroke-width="3"/>'+
      '<path d="M48 49 57 34h46l9 15" stroke="#607F7B" stroke-width="5" stroke-linecap="round"/>'+
      '<circle cx="25" cy="35" r="5" fill="#E5A98F"/><circle cx="133" cy="25" r="4" fill="#6D8E89"/>');
    const strokes={
      orders:'<rect x="40" y="20" width="80" height="120" rx="13" fill="#F9EBD5" stroke="#4F3D36" stroke-width="5"/><path d="M58 55h43M58 75h43M58 95h24" stroke="#BF7464" stroke-width="6" stroke-linecap="round"/><circle cx="102" cy="111" r="13" fill="#E4BE71"/>',
      account:'<circle cx="80" cy="56" r="27" fill="#F1C69B" stroke="#6E5145" stroke-width="4"/><path d="M32 139c0-28 17-47 48-47s48 19 48 47" fill="#B9D3A9" stroke="#537259" stroke-width="4"/>'
    };
    return svg(strokes[type]||strokes.account);
  };
  const mk=(tag,cls,html)=>{const el=document.createElement(tag);if(cls)el.className=cls;if(html!==undefined)el.innerHTML=html;return el};
  const headings={
    premium:['خرید پرمیوم','انتخاب پلن و فعال‌سازی مستقیم'],
    stars:['خرید استارز','بسته موردنظر رو انتخاب کن'],
    catalog:['دنیای دیجیتال','از گیفت‌کارت تا شارژ بازی'],
    orders:['سفارش‌ها','همه خریدها و مراحل تحویل'],
    account:['حساب من','کیف پول، تراکنش‌ها و دعوت دوستان']
  };
  const panel={};
  for(const name of ['home','premium','market','orders','account']){
    const el=mk('section','bp-tab-view'+(name==='premium'?' bp-premium-view':name==='market'?' bp-market-view':name==='orders'?' bp-orders-view':name==='account'?' bp-account-view':''));
    el.dataset.bpView=name;el.id='bp-view-'+name;el.hidden=name!=='home';el.setAttribute('aria-label',name);
    el.setAttribute('tabindex','-1');panel[name]=el;root.appendChild(el);
  }
  function heading(name){const [title,description]=headings[name];return mk('div','bp-tab-heading','<div><span class="bp-overline">BLUE PREMIUM / '+name.toUpperCase()+'</span><h1>'+title+'</h1><p>'+description+'</p></div><span class="bp-tab-symbol" aria-hidden="true">'+art(name==='catalog'?'catalog':name==='stars'?'stars':name)+'</span>')}
  const home=panel.home;
  home.appendChild(mk('div','bp-hero',[
    '<div class="bp-hero-art" aria-hidden="true">'+art('stars')+'</div>',
    '<div class="bp-editorial-tag"><span class="bp-led"></span>BLUE PREMIUM <span class="bp-tag-divider"></span> DIGITAL GOODS</div>',
    '<h1>فروشگاهت،<br><em>با یک حس متفاوت.</em></h1>',
    '<p>پرمیوم، استارز و هدیه‌های دیجیتال. انتخاب ساده، قیمت شفاف، تجربه‌ای که به‌یاد می‌مونه.</p>',
    '<div class="bp-hero-foot"><span>DISCOVER THE DIFFERENCE</span><span class="bp-hero-arrow" aria-hidden="true">↗</span></div>'
  ].join('')));
  home.appendChild(mk('section','bp-featured',[
    '<div class="bp-section-head"><div><span class="bp-overline">01 / TOP PICKS</span><h2>از اینجا شروع کن</h2></div><span class="bp-section-note">محصولات محبوب</span></div>',
    '<div class="bp-quick-grid">',
    '<button type="button" class="bp-quick-card premium" data-bp-go="premium">',
    '<span class="bp-card-label">PREMIUM / 01</span><span class="bp-quick-icon" aria-hidden="true">'+art('premium')+'</span>',
    '<strong>تلگرام پرمیوم</strong><small>اشتراک ویژه برای تجربه‌ای کامل‌تر</small><span class="bp-inline-arrow">انتخاب اشتراک <span aria-hidden="true">↗</span></span></button>',
    '<button type="button" class="bp-quick-card stars" data-bp-go="stars">',
    '<span class="bp-card-label">STARS / 02</span><span class="bp-quick-icon" aria-hidden="true">'+art('stars')+'</span>',
    '<strong>استارز تلگرام</strong><small>بسته‌های مختلف، قیمت لحظه‌ای</small><span class="bp-inline-arrow">دیدن بسته‌ها <span aria-hidden="true">↗</span></span></button>',
    '</div>'
  ].join('')));
  home.appendChild(mk('section','bp-discover',[
    '<div class="bp-section-head"><div><span class="bp-overline">02 / COLLECTION</span><h2>بیشتر کشف کن</h2></div><span class="bp-section-note">چهار دسته متفاوت</span></div>',
    '<div class="bp-discover-grid">',
    '<button type="button" class="bp-category" data-bp-kind="gift"><span aria-hidden="true">'+art('gift')+'</span><strong>هدیه تلگرام</strong><small>TELEGRAM GIFTS</small></button>',
    '<button type="button" class="bp-category" data-bp-kind="catalog"><span aria-hidden="true">'+art('catalog')+'</span><strong>گیفت‌کارت</strong><small>DIGITAL CARDS</small></button>',
    '<button type="button" class="bp-category" data-bp-kind="nft"><span aria-hidden="true">'+art('nft')+'</span><strong>کلکسیون NFT</strong><small>DIGITAL COLLECTIBLES</small></button>',
    '<button type="button" class="bp-category" data-bp-kind="steam"><span aria-hidden="true">'+art('steam')+'</span><strong>شارژ Steam</strong><small>GAMING CREDIT</small></button>',
    '</div>'
  ].join('')));
  const pTitle=root.querySelector('.section-title');
  if(pTitle)panel.premium.appendChild(pTitle);
  const plans=document.getElementById('plans');if(plans)panel.premium.appendChild(plans);
  const checkout=document.getElementById('checkout');if(checkout)panel.premium.appendChild(checkout);
  const market=document.getElementById('tg-digital-shop');
  if(market)panel.market.appendChild(market);
  const account=document.getElementById('bp_account');
  if(account)panel.account.appendChild(account);
  panel.account.prepend(heading('account'));
  panel.market.prepend(heading('stars'));
  panel.premium.prepend(heading('premium'));
  panel.orders.prepend(heading('orders'));
  const premiumOrder=mk('article','bp-orders-card','<h2>سفارش پرمیوم</h2><p>جزئیات سفارش پرمیوم و وضعیت پرداخت اینجا نمایش داده می‌شه.</p>');
  const legacy=document.getElementById('order');
  if(legacy)premiumOrder.appendChild(legacy);
  const premiumEmpty=mk('div','bp-empty','هنوز سفارش پرمیوم فعالی روی این دستگاه ثبت نشده.');
  premiumOrder.appendChild(premiumEmpty);
  panel.orders.appendChild(premiumOrder);
  const marketOrder=mk('article','bp-orders-card','<h2>سفارش محصولات دیجیتال</h2><p>سفارش استارز، گیفت و محصولات دیگه رو اینجا پیگیری کن.</p>');
  const marketDetails=document.getElementById('tgOrder');
  if(marketDetails)marketOrder.appendChild(marketDetails);
  const marketEmpty=mk('div','bp-empty','هنوز سفارش دیجیتالی روی این دستگاه ثبت نشده.');
  marketOrder.appendChild(marketEmpty);
  panel.orders.appendChild(marketOrder);
  const currentPremium=()=>{try{return !!localStorage.getItem('bp_order')}catch(_){return false}};
  const currentMarket=()=>{try{return !!localStorage.getItem('tg_market_order')}catch(_){return false}};
  function syncOrders(){
    premiumEmpty.hidden=currentPremium()||Boolean(document.getElementById('order')?.classList.contains('show'));
    marketEmpty.hidden=currentMarket()||Boolean(marketDetails&&marketDetails.style.display!=='none');
  }
  const oldNav=document.querySelector('.app-nav');
  const nav=mk('nav','bp-app-nav');
  nav.setAttribute('aria-label','منوی اصلی بلوپرمیوم');
  const iconPaths={
    home:'<path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-7h6v7"/>',
    premium:'<path d="m2 8 5 4 5-7 5 7 5-4-2 12H4L2 8Z"/><path d="M5 17h14"/>',
    stars:'<path d="m12 2 3.1 6.4 7 1-5.05 4.9 1.2 7-6.25-3.3-6.25 3.3 1.2-7L2 9.4l7-1L12 2Z"/>',
    catalog:'<path d="M3 10h18v11H3z"/><path d="M3 10 5 3h14l2 7"/><path d="M9 21v-7h6v7"/>',
    orders:'<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
    account:'<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>'
  };
  const icon=name=>'<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+iconPaths[name]+'</svg>';
  const tabs=[['home','خانه'],['premium','پرمیوم'],['stars','استارز'],['catalog','فروشگاه'],['orders','سفارش‌ها'],['account','حساب']];
  nav.innerHTML=tabs.map(([id,label])=>'<button type="button" data-bp-tab="'+id+'" aria-label="'+label+'" aria-controls="bp-view-'+(id==='stars'||id==='catalog'?'market':id)+'" aria-current="'+(id==='home'?'page':'false')+'"><span class="bp-nav-icon" aria-hidden="true">'+icon(id)+'</span><span>'+label+'</span></button>').join('');
  if(oldNav)oldNav.replaceWith(nav);else document.body.appendChild(nav);
  const switchHeading=(kind)=>{
    const v=kind==='stars'?'stars':'catalog',el=panel.market.querySelector('.bp-tab-heading');
    if(el)el.replaceWith(heading(v));
  };
  function activate(tab,{kind,keepPosition=false}={}){
    const name=['home','premium','stars','catalog','orders','account'].includes(tab)?tab:'home';
    if(name==='stars'||name==='catalog'){
      switchHeading(name==='stars'?'stars':kind||'gift');
      if(!keepPosition){
        const selectedKind=name==='stars'?'stars':kind||'gift';
        if(typeof window.bpSelectMarketKind==='function')window.bpSelectMarketKind(selectedKind);
      }
    }
    const target=name==='stars'||name==='catalog'?'market':name;
    for(const [key,view] of Object.entries(panel)){view.hidden=key!==target;view.setAttribute('aria-hidden',key===target?'false':'true')}
    document.body.dataset.bpActive=name;
    nav.querySelectorAll('button').forEach(x=>x.setAttribute('aria-current',x.dataset.bpTab===name?'page':'false'));
    if(name==='orders')syncOrders();
    if(!keepPosition)window.scrollTo({top:0,behavior:'instant'});
  }
  window.bpOpenTab=(tab,kind)=>activate(tab,{kind});
  nav.addEventListener('click',e=>{const btn=e.target.closest('button[data-bp-tab]');if(btn)activate(btn.dataset.bpTab)});
  home.addEventListener('click',e=>{
    const target=e.target.closest('[data-bp-go],[data-bp-kind]');
    if(!target)return;
    if(target.dataset.bpGo)activate(target.dataset.bpGo);
    else if(target.dataset.bpKind)activate('catalog',{kind:target.dataset.bpKind});
  });
  market?.addEventListener('click',e=>{
    const category=e.target.closest('#tgCategories [data-kind]');
    if(!category)return;
    const kind=category.dataset.kind;
    activate(kind==='stars'?'stars':'catalog',{kind,keepPosition:true});
  },true);
  const topOrder=header.querySelector('button[onclick*="goOrder"]');
  if(topOrder){topOrder.removeAttribute('onclick');topOrder.addEventListener('click',()=>activate('orders'))}
  // Existing order code still updates original DOM IDs. This only selects a tab
  // when a new purchase is placed, never on recurring order polling.
  if(typeof window.showOrder==='function'){
    const originalShow=window.showOrder;
    let lastCode='';
    window.showOrder=function(order){
      const fresh=String(order?.code||'');
      const firstNew=fresh&&fresh!==lastCode;
      lastCode=fresh;
      const result=originalShow.apply(this,arguments);
      if(firstNew&&document.body.dataset.bpActive==='premium')activate('orders');
      syncOrders();
      return result;
    };
  }
  if(typeof window.goOrder==='function')window.goOrder=function(){activate('orders')};
  if(typeof window.navTo==='function')window.navTo=function(id){
    if(id==='plans'||id==='checkout'||id==='buy')activate('premium');
    else if(id==='order')activate('orders');else activate('home');
  };
  if(typeof window.resetOrder==='function'){
    const oldReset=window.resetOrder;
    window.resetOrder=function(){const result=oldReset.apply(this,arguments);activate('premium');syncOrders();return result};
  }
  window.addEventListener('bp:market-order-created',()=>{activate('orders');syncOrders()});
  syncOrders();
  // Preserve an intentionally selected screen when navigating Back in Telegram.
  if(window.Telegram?.WebApp?.BackButton){
    try{
      window.Telegram.WebApp.BackButton.onClick(()=>activate('home'));
    }catch(_){}
  }
}
