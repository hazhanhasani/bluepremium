n svgIcon() {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#41a0ff"/><stop offset="1" stop-color="#0644d9"/></linearGradient></defs><rect width="512" height="512" rx="120" fill="#061020"/><circle cx="256" cy="256" r="178" fill="url(#g)"/><path d="M151 151h112c70 0 109 30 109 81 0 31-17 55-47 68 39 11 59 38 59 79 0 61-45 91-126 91H151V151zm86 63v61h27c29 0 44-10 44-30s-15-31-44-31h-27zm0 119v73h34c33 0 50-12 50-36 0-25-17-37-50-37h-34z" fill="white"/></svg>`;
  return new Response(svg, { headers: { 'content-type': 'image/svg+xml', 'cache-control': 'public,max-age=86400' } });
}

function serviceWorkerJs() {
  return `const C='bp-v6-static';
self.addEventListener('install',e=>{self.skipWaiting();e.waitUntil(caches.open(C).then(c=>c.addAll(['/brandmark.webp?v=6','/manifest.webmanifest?v=6'])).catch(()=>{}))});
self.addEventListener('activate',e=>e.waitUntil(Promise.all([caches.keys().then(keys=>Promise.all(keys.filter(k=>k!==C).map(k=>caches.delete(k)))),self.clients.claim()])));
self.addEventListener('fetch',e=>{if(e.request.method!=='GET')return;const u=new URL(e.request.url);if(u.pathname==='/brandmark.webp'||u.pathname==='/manifest.webmanifest'){e.respondWith(caches.match(e.request).then(r=>r||fetch(e.request).then(x=>{const y=x.clone();caches.open(C).then(c=>c.put(e.request,y));return x})));}});
`;
}

function storeHtml() {
  return `<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0a67ff"><link rel="manifest" href="/manifest.webmanifest"><link rel="icon" href="/icon.svg"><title>${BRAND_FA} | ${BRAND}</title><style>
  :root{color-scheme:dark;--bg:#050b16;--card:#0d1728;--card2:#111e34;--text:#f4f8ff;--muted:#91a3bd;--blue:#1682ff;--blue2:#4bb1ff;--line:#20304a;--ok:#39d98a;--warn:#ffca5c}*{box-sizing:border-box}body{margin:0;font-family:Tahoma,"Segoe UI",sans-serif;background:radial-gradient(circle at 80% -20%,#153d80 0,transparent 42%),radial-gradient(circle at -20% 100%,#092a61 0,transparent 35%),var(--bg);color:var(--text);min-height:100vh}.wrap{width:min(940px,100%);margin:auto;padding:24px 16px 110px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:flex;align-items:center;gap:12px}.logo{width:54px;height:54px;border-radius:17px;background:linear-gradient(145deg,#4bb1ff,#0b55e9);display:grid;place-items:center;font-weight:900;font-size:24px;box-shadow:0 12px 30px #0966ff44}.brand h1{font-size:20px;margin:0}.brand small{color:var(--muted)}.pill{border:1px solid var(--line);background:#0b1424aa;border-radius:999px;padding:9px 12px;color:#b9c9df;font-size:12px}.hero{padding:55px 0 28px;text-align:center}.hero h2{font-size:clamp(30px,8vw,52px);line-height:1.35;margin:0}.hero h2 span{background:linear-gradient(90deg,#7bc6ff,#2d76ff);-webkit-background-clip:text;color:transparent}.hero p{color:var(--muted);line-height:2;max-width:620px;margin:14px auto}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.plan{border:1px solid var(--line);background:linear-gradient(160deg,#101c30,#0a1322);border-radius:24px;padding:20px;cursor:pointer;transition:.2s;position:relative;overflow:hidden}.plan:hover,.plan.active{transform:translateY(-3px);border-color:#317fff;box-shadow:0 18px 45px #075cff25}.plan.active:before{content:"";position:absolute;inset:0 0 auto;height:3px;background:linear-gradient(90deg,#2d76ff,#5bc3ff)}.months{font-size:28px;font-weight:900}.sub{color:var(--muted);font-size:13px;margin-top:6px}.price{font-size:22px;font-weight:800;margin-top:26px}.price small{font-size:12px;color:var(--muted)}.checkout{margin-top:18px;border:1px solid var(--line);border-radius:26px;padding:20px;background:#091321d9}.checkout h3{margin:0 0 6px}.checkout p{margin:0 0 16px;color:var(--muted);font-size:13px}.row{display:grid;grid-template-columns:1fr auto;gap:10px}.input{width:100%;border:1px solid var(--line);background:#07101e;color:#fff;border-radius:16px;padding:15px 16px;font:inherit;outline:0;direction:ltr;text-align:left}.input:focus{border-color:#2f7cff;box-shadow:0 0 0 4px #2f7cff18}.btn{border:0;border-radius:16px;background:linear-gradient(100deg,#0c66ff,#28a4ff);color:white;font:700 14px Tahoma;padding:0 22px;cursor:pointer;box-shadow:0 12px 30px #0b67ff42}.btn:disabled{opacity:.5;cursor:not-allowed}.notice{margin-top:14px;padding:12px 14px;border-radius:15px;background:#0c1a2d;color:#adc0d9;font-size:12px;line-height:1.9}.status{display:none;margin-top:16px;padding:18px;border-radius:18px;border:1px solid var(--line);background:#07111f}.status.show{display:block}.status strong{display:block;margin-bottom:7px}.status .meta{color:var(--muted);font-size:12px;line-height:1.9}.pay{display:inline-flex;margin-top:12px;text-decoration:none}.foot{padding:30px 0 0;text-align:center;color:#647a98;font-size:11px}@media(max-width:700px){.plans{grid-template-columns:1fr}.row{grid-template-columns:1fr}.btn{min-height:50px}.hero{padding-top:38px}.top .pill{display:none}}
  </style></head><body><main class="wrap"><header class="top"><div class="brand"><div class="logo">B</div><div><h1>${BRAND_FA}</h1><small>${BRAND}</small></div></div><div class="pill">فعال‌سازی خودکار • پرداخت امن</div></header><section class="hero"><h2>تلگرام پرمیوم، <span>سریع و ساده</span></h2><p>پلن را انتخاب کن، یوزرنیم تلگرام را وارد کن و بعد از پرداخت، سفارش به‌صورت خودکار برای فعال‌سازی ارسال می‌شود.</p></section><section id="plans" class="plans"><div class="plan"><div class="sub">در حال دریافت قیمت‌ها...</div></div></section><section class="checkout"><h3>ثبت سفارش</h3><p>یوزرنیم بدون @ وارد شود. قبل از پرداخت، حساب تلگرام بررسی می‌شود.</p><div class="row"><input id="username" class="input" placeholder="telegram_username" maxlength="32" autocomplete="off"><button id="buy" class="btn">ادامه و پرداخت</button></div><div class="notice">🔒 مبلغ نهایی قبل از ساخت فاکتور مشخص است. اطلاعات تأمین‌کننده و کلیدهای API در اپ نمایش داده نمی‌شوند.</div><div id="status" class="status"></div></section><div class="foot">${BRAND_FA} · Premium delivery powered by secure server-side integrations</div></main><script>
  let plans=[],selected=null,current=null;const el=id=>document.getElementById(id);const money=n=>new Intl.NumberFormat('fa-IR').format(n)+' تومان';
  async function load(){try{const r=await fetch('/api/plans').then(r=>r.json());plans=r.plans||[];render();const saved=localStorage.getItem('bp_order');if(saved){current=JSON.parse(saved);check()}}catch(e){el('plans').innerHTML='<div class="plan"><div class="sub">دریافت قیمت‌ها ناموفق بود.</div