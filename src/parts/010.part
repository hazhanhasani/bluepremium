
function adminHtmlV2() {
  return `<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07111f">
<title>مدیریت ${BRAND_FA}</title>
<style>
:root{color-scheme:dark;--bg:#060b13;--panel:#0c1625;--panel2:#101d2f;--line:rgba(143,180,226,.13);--text:#f5f9ff;--muted:#8fa2ba;--blue:#2f86ff;--cyan:#55c7ff;--green:#42d99a;--red:#ff7080;--gold:#f5c86b}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(650px 340px at 90% -5%,rgba(47,134,255,.18),transparent 65%),var(--bg);color:var(--text);font-family:Tahoma,"Segoe UI",system-ui,sans-serif;min-height:100vh}.app{display:grid;grid-template-columns:235px 1fr;min-height:100vh}.side{border-left:1px solid var(--line);background:rgba(7,14,24,.86);backdrop-filter:blur(18px);padding:18px;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:10px}.logo{width:42px;height:42px;border-radius:14px;background:#fff;display:grid;place-items:center;overflow:hidden;box-shadow:0 12px 28px rgba(34,116,255,.25)}.logo img{width:100%;height:100%;object-fit:cover;display:block}.brand b{font-size:13px}.brand small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.nav{display:grid;gap:6px;margin-top:28px}.nav button{width:100%;height:43px;border:0;border-radius:13px;background:transparent;color:#8ea2bc;text-align:right;padding:0 12px;font:700 10px Tahoma;cursor:pointer;display:flex;align-items:center;gap:9px}.nav button .ico{width:17px;height:17px;flex:0 0 auto}.nav button.on,.nav button:hover{background:#10213a;color:#dcecff}.sidefoot{position:absolute;bottom:18px;right:18px;left:18px;color:#5f748f;font-size:8px;line-height:1.8}.main{padding:24px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px}.top h1{font-size:22px;margin:0}.top p{color:var(--muted);font-size:9px;margin:5px 0 0}.top-actions{display:flex;gap:8px}.btn{border:0;border-radius:13px;background:linear-gradient(100deg,#156df8,#2aa8ff);color:#fff;height:42px;padding:0 15px;font:800 10px Tahoma;cursor:pointer}.btn.secondary{background:#101d2e;border:1px solid var(--line);box-shadow:none;color:#cfe0f5}.btn.danger{background:rgba(255,112,128,.12);border:1px solid rgba(255,112,128,.2);color:#ff9ca7}.btn:disabled{opacity:.5}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px;margin-top:18px}.card{grid-column:span 12;border:1px solid var(--line);background:linear-gradient(155deg,rgba(14,26,43,.95),rgba(8,16,28,.96));border-radius:21px;padding:16px}.kpi{grid-column:span 3;min-height:106px}.provider{grid-column:span 6}.half{grid-column:span 6}.card h3{margin:0 0 5px;font-size:13px}.sub{color:var(--muted);font-size:9px;line-height:1.8}.kpi b{display:block;font-size:26px;margin-top:13px}.kpi span{font-size:8px;color:#7990aa}.dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-left:5px}.ok{background:var(--green);box-shadow:0 0 0 5px rgba(66,217,154,.08)}.bad{background:var(--red);box-shadow:0 0 0 5px rgba(255,112,128,.07)}.provider-head{display:flex;justify-content:space-between;align-items:center}.provider-state{font-size:9px;color:#afc1d6}.provider-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:11px}.chip{padding:7px 9px;border-radius:11px;background:#0b1524;border:1px solid var(--line);font-size:8px;color:#9eb1c8}.field{margin-top:12px}.field label{display:block;color:#9eb0c5;font-size:9px;margin:0 2px 6px}.input{width:100%;height:44px;border:1px solid #203754;border-radius:13px;background:#07101c;color:white;padding:0 12px;font:500 11px Tahoma;outline:0}.input:focus{border-color:#368cff;box-shadow:0 0 0 4px rgba(54,140,255,.08)}.row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.provider-actions{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end}.endpoint-box{margin-top:12px;padding:11px;border:1px solid var(--line);background:#081321;border-radius:14px}.endpoint-row{display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center;margin-top:8px}.endpoint-row:first-child{margin-top:0}.endpoint-label{font-size:8px;color:#7f96af;margin-bottom:5px}.endpoint-url{height:39px;border:1px solid #1d324d;border-radius:11px;background:#06101c;color:#bad0e7;padding:0 10px;font:500 9px "Segoe UI",Tahoma;direction:ltr;text-align:left;width:100%}.copybtn{height:39px;border-radius:11px;border:1px solid var(--line);background:#10213a;color:#dcecff;padding:0 11px;font:700 8px Tahoma;cursor:pointer}.provider-note{margin-top:8px;color:#7289a3;font-size:8px;line-height:1.8}.mode-box{margin-top:12px;padding:12px;border:1px solid var(--line);background:#081321;border-radius:14px}.mode-box .mode-row{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end}.mode-box .input{height:40px}.approve-btn{height:32px;border:0;border-radius:10px;background:linear-gradient(100deg,#176ff5,#2aa9ff);color:#fff;padding:0 10px;font:800 8px Tahoma;cursor:pointer;white-space:nowrap}.approve-btn:disabled{opacity:.5}.plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.plan{border:1px solid var(--line);background:#091321;border-radius:17px;padding:13px}.plan h4{margin:0;font-size:12px}.plan .price{font-weight:900;font-size:16px;margin:10px 0 3px}.plan .auto{color:#7390ad;font-size:8px}.plan .controls{display:flex;gap:7px;margin-top:10px}.plan .controls .input{height:39px}.orders{overflow:auto;margin-top:10px;border:1px solid var(--line);border-radius:15px}.orders table{width:100%;border-collapse:collapse;min-width:760px}.orders th,.orders td{padding:11px 10px;border-bottom:1px solid rgba(143,180,226,.08);text-align:right;font-size:9px}.orders th{color:#7187a1;font-weight:600;background:#091321}.orders td{color:#c7d5e6}.status{display:inline-flex;padding:5px 7px;border-radius:9px;background:#101e31;border:1px solid var(--line);font-size:8px}.status.delivered{color:#78e7b3;background:rgba(66,217,154,.08);border-color:rgba(66,217,154,.16)}.status.awaiting_approval{color:#f7d37b;background:rgba(245,200,107,.08);border-color:rgba(245,200,107,.18)}.status.provider_uncertain{color:#ff9ca7;background:rgba(255,112,128,.08);border-color:rgba(255,112,128,.16)}.status.failed,.status.payment_error,.status.payment_mismatch{color:#ff9ca7;background:rgba(255,112,128,.08);border-color:rgba(255,112,128,.16)}.loginwrap{min-height:100vh;display:grid;place-items:center;padding:20px}.login{width:min(420px,100%);padding:26px;border-radius:25px;border:1px solid var(--line);background:linear-gradient(155deg,#0e1a2c,#08111f);box-shadow:0 30px 90px rgba(0,0,0,.34)}.login .logo{width:58px;height:58px;border-radius:19px;margin:auto;font-size:22px}.login h2{text-align:center;margin:15px 0 4px}.login p{text-align:center;color:var(--muted);font-size:9px;margin-bottom:17px}.loginmsg{font-size:9px;color:#ff94a0;margin-top:9px}.section{display:none}.section.on{display:block}.mobilebar{display:none}
@media(max-width:980px){.app{grid-template-columns:1fr}.side{display:none}.main{padding:16px;padding-bottom:90px}.kpi{grid-column:span 6}.provider,.half{grid-column:span 12}.mobilebar{display:flex;position:fixed;z-index:20;bottom:10px;right:10px;left:10px;height:62px;padding:7px;border-radius:20px;border:1px solid var(--line);background:rgba(7,15,26,.9);backdrop-filter:blur(18px);box-shadow:0 20px 50px rgba(0,0,0,.4)}.mobilebar button{flex:1;border:0;background:transparent;color:#7f94ad;font:700 8px Tahoma;border-radius:13px;display:grid;place-items:center;gap:2px}.mobilebar button .ico{width:17px;height:17px}.mobilebar button.on{background:#11223c;color:#e1efff}}
@media(max-width:650px){.kpi{grid-column:span 12}.row,.plan-grid{grid-template-columns:1fr}.top{align-items:flex-start}.top-actions{flex-direction:column}.provider-actions{grid-template-columns:1fr}.btn{width:100%}}
</style>
<style id="mobile-admin-v3">
@media(max-width:700px){
  .loginwrap{padding:16px}.login{width:100%;max-width:430px;padding:24px 20px;border-radius:27px}
  .login .logo{width:70px;height:70px;border-radius:22px}.login h2{font-size:20px;margin-top:17px}.login p{font-size:10px;line-height:1.8;margin-bottom:20px}
  .field label{font-size:9px;margin-bottom:7px}.input{height:49px;border-radius:14px;font-size:11px;padding:0 12px}.btn{min-height:45px;border-radius:14px;font-size:9px;padding:0 14px}
  .main{padding:14px 13px 94px}.top{margin-bottom:13px}.top h1{font-size:19px}.top p{font-size:9px;line-height:1.8}.top-actions{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:7px}.top-actions .btn{width:100%}
  .grid{gap:9px}.card{padding:15px;border-radius:20px}.card h3,.provider h3{font-size:13px}.sub,.provider .sub{font-size:8px;line-height:1.8}
  .kpi b{font-size:25px;margin-top:7px}.kpi span{font-size:8px}.provider-head{gap:8px}.provider-state{font-size:8px}.provider-meta{gap:5px}.chip{font-size:7px;padding:5px 7px}
  .provider-actions{gap:8px}.endpoint-box,.mode-box{padding:12px;border-radius:16px}.endpoint-label{font-size:8px}.endpoint-url{height:43px;font-size:9px}.copybtn{height:43px}
  .mode-box .mode-row{grid-template-columns:1fr}.mode-box .btn{width:100%}.provider-note{font-size:8px}
  .plan-grid{display:flex;overflow-x:auto;gap:9px;margin:0 -2px;padding:10px 2px 5px;scroll-snap-type:x mandatory}.plan{min-width:78vw;scroll-snap-align:center;padding:14px;border-radius:18px}.plan h4{font-size:12px}.plan .price{font-size:18px}
  .orders{border-radius:16px}.orders th,.orders td{padding:12px 10px;font-size:9px}.status{font-size:8px;padding:6px 8px}.approve-btn{height:36px;font-size:8px}
  .mobilebar{height:68px;right:9px;left:9px;bottom:max(8px,env(safe-area-inset-bottom));padding:6px;border-radius:22px}.mobilebar button{font-size:7px}.mobilebar button .ico{width:19px;height:19px}
}
</style>
<style id="bp-mobile-admin-20261008">
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
@media(max-width:980px){
 .main{padding-bottom:calc(135px + env(safe-area-inset-bottom,0px))!important}
 .mobilebar{overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;
   scroll-snap-type:x proximity;gap:4px;justify-content:flex-start}
 .mobilebar::-webkit-scrollbar{display:none}
 .mobilebar button{flex:0 0 71px!important;min-width:71px;scroll-snap-align:center}
 .mobilebar button span{white-space:nowrap}
 .orders{max-width:100%;overflow:auto}
 .card{min-width:0}
 .kpi{min-height:112px}
 .kpi b{font-variant-numeric:tabular-nums}
}
@media(max-width:650px){.main{padding-bottom:calc(150px + env(safe-area-inset-bottom,0px))!important}}
</style>
</head>
<body>
<section id="loginWrap" class="loginwrap">
  <div class="login">
    <div class="logo"><img src="/brandmark.webp?v=8" alt=""></div><h2>مدیریت ${BRAND_FA}</h2><p>ورود امن به مرکز کنترل فروش پرمیوم</p>
    <div class="field"><label>رمز عبور مدیر</label><input id="pass" type="password" class="input" placeholder="••••••••••"></div>
    <button class="btn" style="width:100%;margin-top:10px" onclick="login()">ورود به پنل</button>
    <div id="loginmsg" class="loginmsg"></div>
  </div>
</section>

<div id="app" class="app" style="display:none">
<aside class="side">
  <div class="brand"><div class="logo"><img src="/brandmark.webp?v=8" alt=""></div><div><b>${BRAND_FA}</b><small>ADMIN CENTER</small></div></div>
  <nav class="nav">
    <button class="on" data-tab="dashboard" onclick="tab('dashboard',this)" >${iconV4('home')}<span>داشبورد</span></button>
    <button data-tab="providers" onclick="tab('providers',this)" >${iconV4('plug')}<span>اتصال‌ها</span></button>
    <button data-tab="plans" onclick="tab('plans',this)" >${iconV4('crown')}<span>پلن و قیمت</span></button>
    <button data-tab="orders" onclick="tab('orders',this)" >${iconV4('list')}<span>سفارش‌ها</span></button>
    <button data-tab="settings" onclick="tab('settings',this)" >${iconV4('sliders')}<span>تنظیمات</span></button>
  </nav>
  <div class="sidefoot">Blue Premium<br>Cloudflare Worker + D1</div>
</aside>

<main class="main">
<header class="top">
  <div><h1 id="pageTitle">داشبورد</h1><p id="pageSub">وضعیت لحظه‌ای فروش و اتصال سرویس‌ها</p></div>
  <div class="top-actions"><button class="btn secondary" onclick="sync()">همگام‌سازی قیمت</button><button class="btn" onclick="reconcile()">بررسی سفارش‌ها</button></div>
</header>

<section id="dashboard" class="section on">
<div class="grid">
  <article class="card kpi"><div class="sub">کل سفارش‌ها</div><b id="kOrders">0</b><span>تمام وضعیت‌ها</span></article>
  <article class="card kpi"><div class="sub">تحویل موفق</div><b id="kDelivered">0</b><span>فعال‌سازی تکمیل‌شده</span></article>
  <article class="card kpi"><div class="sub">در انتظار رسیدگی</div><b id="kPending">0</b><span id="kPendingHint">پرداخت یا تحویل</span></article>
  <article class="card kpi"><div class="sub">فروش موفق</div><b id="kRevenue">0</b><span>تومان</span></article>
  <article class="card provider" id="dashTg"></article>
  <article class="card provider" id="dashBp"></article>
  <article class="card"><div class="provider-head"><div><h3>آخرین سفارش‌ها</h3><div class="sub">پرمیوم، استارز و سایر محصولات دیجیتال</div></div><button class="btn secondary" onclick="tab('orders')">مشاهده همه</button></div><div class="orders"><table><thead><tr><th>کد</th><th>مقصد</th><th>محصول</th><th>مبلغ</th><th>وضعیت</th></tr></thead><tbody id="dashOrders"></tbody></table></div></article>
</div>
</section>

<section id="providers" class="section">
<div class="grid">
  <article class="card provider"><div class="provider-head"><div><h3>TG Tools</h3><div class="sub">فعال‌سازی Telegram Premium</div></div><div id="tgState" class="provider-state"></div></div><div id="tgMeta" class="provider-meta"></div><div class="provider-actions"><div class="field"><label>API Key جدید</label><input id="tgkey" type="password" class="input" placeholder="TG Tools API Key"></div><button class="btn" onclick="saveProviders('tg')">ذخیره</button></div><div class="mode-box"><div class="mode-row"><div class="field" style="margin-top:0"><label>شیوه ارسال سفارش به TG Tools</label><select id="fulfillmentMode" class="input"><option value="auto">خودکار بعد از تایید پرداخت</option><option value="manual">تایید دستی مدیر</option></select></div><button class="btn secondary" onclick="saveFulfillmentMode()">ذخیره حالت</button></div><div id="modeHelp" class="provider-note">در حالت دستی، سفارش بعد از پرداخت تا تایید شما به TG Tools ارسال نمی‌شود.</div></div></article>
  <article class="card provider"><div class="provider-head"><div><h3>ربات تلگرام</h3><div class="sub">فروشگاه، پیگیری سفارش و اعلان‌های مدیریت</div></div><div id="botState" class="provider-state"></div></div><div id="botMeta" class="provider-meta"></div><div class="field"><label>Bot Token جدید</label><input id="botToken" type="password" class="input" autocomplete="off" placeholder="123456789:AA..."></div><div class="row" style="margin-top:8px"><div class="field"><label>Telegram Admin ID</label><input id="botAdminId" class="input" inputmode="numeric" placeholder="مثلاً 123456789"></div><div class="field"><label>وضعیت ربات</label><select id="botEnabled" class="input"><option value="1">فعال</option><option value="0">غیرفعال</option></select></div></div><div class="endpoint-box"><div class="endpoint-label">Webhook</div><div class="endpoint-row"><input id="botWebhook" class="endpoint-url" readonly><button class="copybtn" onclick="copyEndpoint('botWebhook')">کپی</button></div></div><div class="row" style="margin-top:10px"><button class="btn" onclick="saveTelegramBot()">ذخیره + ثبت Webhook</button><button class="btn secondary" onclick="testTelegramBot()">ارسال پیام تست</button></div><div class="provider-note">توکن به‌صورت رمزگذاری‌شده ذخیره می‌شود و در پنل دوباره نمایش داده نمی‌شود. با فعال‌سازی، Webhook و دستورات ربات خودکار تنظیم می‌شوند.</div></article>
  <article class="card provider"><div class="provider-head"><div><h3>BluePal</h3><div class="sub">درگاه مشترک اپ، مینی‌اپ و ربات</div></div><div id="bpState" class="provider-state"></div></div><div class="provider-actions"><div class="field"><label>API Key جدید</label><input id="bpkey" type="password" class="input" autocomplete="off" placeholder="BluePal API Key"></div><button class="btn" onclick="saveProviders('bp')">ذخیره</button></div><div class="endpoint-box"><div class="endpoint-label">Callback URL</div><div class="endpoint-row"><input id="bpCallback" class="endpoint-url" readonly><button class="copybtn" onclick="copyEndpoint('bpCallback')">کپی</button></div><div class="endpoint-label" style="margin-top:10px">Webhook URL</div><div class="endpoint-row"><input id="bpWebhook" class="endpoint-url" readonly><button class="copybtn" onclick="copyEndpoint('bpWebhook')">کپی</button></div><div class="provider-note">همین یک API Key برای اپ، مینی‌اپ و ربات استفاده می‌شود. Callback و Webhook مشترک هستند.</div></div></article>
  <article class="card provider" style="opacity:.62"><div class="provider-head"><div><h3>کافه‌بازار</h3><div class="sub">فعلاً غیرفعال — تنظیمات برای استفاده بعدی نگه داشته می‌شود</div></div><div class="provider-state"><i class="dot bad"></i>غیرفعال</div></div><div class="field"><label>RSA Public Key</label><textarea id="bazaarRsa" class="input" style="height:92px;padding:10px;resize:vertical" placeholder="RSA Public Key"></textarea></div><div class="row" style="margin-top:8px"><div class="field"><label>Product ID پلن ۳ ماهه</label><input id="bazaarSku3" class="input" placeholder="premium_3m"></div><div class="field"><label>Product ID پلن ۶ ماهه</label><input id="bazaarSku6" class="input" placeholder="premium_6m"></div></div><div class="field"><label>Product ID پلن ۱۲ ماهه</label><input id="bazaarSku12" class="input" placeholder="premium_12m"></div><button class="btn secondary" style="margin-top:10px;width:100%" onclick="saveBazaar()">فقط ذخیره تنظیمات برای بعد</button></article>
</div>
</section>

<section id="plans" class="section">
<div class="grid"><article class="card"><div class="provider-head"><div><h3>پلن‌ها و قیمت‌گذاری</h3><div class="sub">قیمت خودکار از TG Tools + نرخ TON و درصد سود</div></div><button class="btn secondary" onclick="sync()">دریافت قیمت جدید</button></div><div id="planGrid" class="plan-grid"></div></article></div>
</section>

<section id="orders" class="section">
<div class="grid"><article class="card"><div class="provider-head"><div><h3>سفارش‌ها</h3><div class="sub">۱۰۰ سفارش اخیر</div></div><button class="btn secondary" onclick="loadOrders()">بروزرسانی</button></div><div class="orders"><table><thead><tr><th>کد</th><th>یوزرنیم</th><th>پلن</th><th>مبلغ</th><th>وضعیت</th><th>زمان</th><th>عملیات</th></tr></thead><tbody id="ordersBody"></tbody></table></div></article></div>
</section>

<section id="settings" class="section">
<div class="grid">
  <article class="card half"><h3>تنظیم قیمت</h3><div class="row"><div class="field"><label>درصد سود</label><input id="profit" class="input" type="number" min="0" max="500"></div><div class="field"><label>گرد کردن قیمت</label><input id="rounding" class="input" type="number" min="100"></div></div><div class="field"><label>پشتیبانی</label><input id="support" class="input" placeholder="@username یا لینک"></div><button class="btn" style="margin-top:10px" onclick="saveSettings()">ذخیره تنظیمات</button></article>
  <article class="card half"><h3>امنیت پنل</h3><div class="sub">رمز جدید حداقل ۱۰ کاراکتر باشد.</div><div class="field"><label>رمز جدید مدیر</label><input id="newpass" class="input" type="password" placeholder="رمز جدید"></div><button class="btn" style="margin-top:10px" onclick="saveSettings(true)">تغییر رمز</button></article>
</div>
</section>
</main>

<nav class="mobilebar"><button class="on" data-tab="dashboard" onclick="tab('dashboard',this)">${iconV4('home')}<span>خانه</span></button><button data-tab="providers" onclick="tab('providers',this)">${iconV4('plug')}<span>اتصال‌ها</span></button><button data-tab="plans" onclick="tab('plans',this)">${iconV4('crown')}<span>پلن‌ها</span></button><button data-tab="orders" onclick="tab('orders',this)">${iconV4('list')}<span>سفارش‌ها</span></button><button data-tab="settings" onclick="tab('settings',this)">${iconV4('sliders')}<span>تنظیمات</span></button></nav>
</div>

<script>
let token=sessionStorage.getItem('bp_admin')||'',summary=null;
const H=()=>({'content-type':'application/json','authorization':'Bearer '+token});
const money=n=>new Intl.NumberFormat('fa-IR').format(Number(n||0));
const titles={dashboard:['داشبورد','وضعیت لحظه‌ای فروش و اتصال سرویس‌ها'],providers:['اتصال‌ها','TG Tools، ربات تلگرام و BluePal مشترک'],plans:['پلن و قیمت','کنترل قیمت‌گذاری خودکار و دستی'],orders:['سفارش‌ها','پیگیری وضعیت فعال‌سازی‌ها'],settings:['تنظیمات','پیکربندی فروشگاه و امنیت']};
async function login(){
  const msg=document.getElementById('loginmsg');msg.textContent='در حال ورود...';
  try{
    const r=await fetch('/api/admin/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({password:document.getElementById('pass').value}),cache:'no-store'});
    const d=await r.json();
    if(!d.ok){msg.textContent=d.error==='invalid_credentials'?'رمز عبور صحیح نیست.':'ورود انجام نشد.';return}
    token=d.token;sessionStorage.setItem('bp_admin',token);msg.textContent='';await load();
  }catch(e){msg.textContent='ارتباط با سرور برقرار نشد.'}
}
document.getElementById('pass').addEventListener('keydown',e=>{if(e.key==='Enter')login()});
function tab(name,button){document.querySelectorAll('.section').forEach(x=>x.classList.toggle('on',x.id===name));document.querySelectorAll('.nav button,.mobilebar button').forEach(x=>x.classList.toggle('on',x.dataset.tab===name||(button&&x===button)));document.getElementById('pageTitle').textContent=titles[name][0];document.getElementById('pageSub').textContent=titles[name][1];if(name==='orders')loadOrders()}
async function load(){if(!token)return;const r=await fetch('/api/admin/summary',{headers:H()});if(r.status===401){sessionStorage.removeItem('bp_admin');token='';return}const d=await r.json();summary=d;document.getElementById('loginWrap').style.display='none';document.getElementById('app').style.display='grid';renderSummary();loadOrders()}
function statusCount(name){const x=(summary.orders||[]).find(o=>o.status===name);return Number(x?.count||0)}
function statusTotal(name){const x=(summary.orders||[]).find(o=>o.status===name);return Number(x?.total||0)}
function renderSummary(){
  const total=(summary.orders||[]).reduce((a,b)=>a+Number(b.count||0),0);
  const needsAttention=['paid','awaiting_approval','provider_submitting','provider_pending','provider_uncertain','refund_required']
    .reduce((a,state)=>a+statusCount(state),0);
  const unpaid=['awaiting_payment','awaiting_bazaar_payment','creating_payment'].reduce((a,state)=>a+statusCount(state),0);
  document.getElementById('kOrders').textContent=money(total);
  document.getElementById('kDelivered').textContent=money(statusCount('delivered'));
  document.getElementById('kPending').textContent=money(needsAttention);
  document.getElementById('kPendingHint').textContent=money(unpaid)+' فاکتور در انتظار پرداخت';
  document.getElementById('kRevenue').textContent=money(statusTotal('delivered'));
  const tg=summary.providers.tgtools||{},bazaar=summary.providers.cafebazaar||{},bp=summary.providers.blupal||{},bot=summary.providers.telegram_bot||{};
  document.getElementById('dashTg').innerHTML=providerCard('TG Tools','فعال‌سازی Premium',tg.ok,tg.configured,(tg.balance_ton!=null?'موجودی: '+tg.balance_ton+' TON':''));
  document.getElementById('dashBp').innerHTML=providerCard('BluePal','درگاه مشترک اپ و ربات',bp.ok,bp.configured,bp.active?'درگاه پیش‌فرض':'غیرفعال');
  document.getElementById('tgState').innerHTML=stateHtml(tg.ok,tg.configured,Number(tg.http_status||0),tg.error||'');
  document.getElementById('bpState').innerHTML=bp.active&&bp.configured?'<i class="dot ok"></i>فعال و پیش‌فرض':'<i class="dot bad"></i>'+(bp.configured?'غیرفعال':'تنظیم نشده');
  document.getElementById('bpCallback').value=location.origin+'/payment/blupal/callback';
  document.getElementById('bpWebhook').value=location.origin+'/api/webhooks/blupal';
  document.getElementById('botState').innerHTML=bot.enabled?(bot.ok?'<i class="dot ok"></i>فعال و متصل':'<i class="dot bad"></i>'+(bot.configured?'خطا در اتصال':'تنظیم نشده')):'<i class="dot bad"></i>غیرفعال';
  document.getElementById('botMeta').innerHTML=(bot.username?'<span class="chip">@'+String(bot.username).replace(/[<>&]/g,'')+'</span>':'')+(bot.configured?'<span class="chip">توکن ذخیره شده</span>':'')+(bot.blupal_enabled&&bot.blupal_configured?'<span class="chip">BluePal مشترک فعال</span>':'<span class="chip">BluePal نیاز به تنظیم</span>');
  document.getElementById('botAdminId').value=summary.settings.telegram_admin_id||bot.admin_id||'';
  document.getElementById('botEnabled').value=String(summary.settings.telegram_bot_enabled||'0')==='1'?'1':'0';
  document.getElementById('botWebhook').value=bot.webhook_url||summary.settings.telegram_bot_webhook_url||location.origin+'/api/telegram/bot/webhook';
  document.getElementById('tgMeta').innerHTML=(tg.balance_ton!=null?'<span class="chip">موجودی '+tg.balance_ton+' TON</span>':'')+(tg.wallet_address?'<span class="chip">آدرس کیف پول ثبت شده</span>':'')+(!tg.ok&&tg.configured?'<span class="chip">HTTP '+Number(tg.http_status||0)+'</span>':'')+(!tg.ok&&tg.error?'<span class="chip">'+String(tg.error).replace(/[<>&]/g,'')+'</span>':'');
  document.getElementById('bazaarRsa').value=summary.settings.bazaar_rsa_public_key||'';
  document.getElementById('bazaarSku3').value=summary.settings.bazaar_sku_3||'';
  document.getElementById('bazaarSku6').value=summary.settings.bazaar_sku_6||'';
  document.getElementById('bazaarSku12').value=summary.settings.bazaar_sku_12||'';
  document.getElementById('profit').value=summary.settings.profit_percent||15;document.getElementById('rounding').value=summary.settings.rounding||1000;document.getElementById('support').value=summary.settings.support||'';document.getElementById('fulfillmentMode').value=summary.settings.tgtools_fulfillment_mode||'auto';
  document.getElementById('botToken').value='';document.getElementById('bpkey').value='';
  document.getElementById('planGrid').innerHTML=(summary.plans||[]).map(p=>'<div class="plan"><h4>'+p.months+' ماهه</h4><div class="price">'+money(p.price_toman)+' تومان</div><div class="auto">قیمت خودکار: '+money(p.auto_price_toman||0)+' تومان</div><div class="controls"><input id="price-'+p.id+'" class="input" type="number" value="'+(p.manual_price_toman||'')+'" placeholder="قیمت دستی"><button class="btn" onclick="savePlan('+p.id+')">ذخیره</button></div></div>').join('');
}
function providerCard(name,desc,ok,configured,meta){return '<div class="provider-head"><div><h3>'+name+'</h3><div class="sub">'+desc+'</div></div><div class="provider-state"><i class="dot '+(ok?'ok':'bad')+'"></i>'+(configured?(ok?'متصل':'نیاز به بررسی'):'تنظیم نشده')+'</div></div>'+(meta?'<div class="provider-meta"><span class="chip">'+meta+'</span></div>':'')}
function stateHtml(ok,configured,httpStatus=0,error=''){
  if(!configured)return '<i class="dot bad"></i>تنظیم نشده';
  if(ok)return '<i class="dot ok"></i>اتصال سالم';
  if(httpStatus===401||httpStatus===403)return '<i class="dot bad"></i>کلید API نامعتبر یا غیرفعال';
  if(httpStatus===429)return '<i class="dot bad"></i>محدودیت تعداد درخواست';
  if(httpStatus>=500||httpStatus===0)return '<i class="dot bad"></i>اختلال ارتباط با TG Tools';
  return '<i class="dot bad"></i>خطای اتصال ('+httpStatus+')';
}
function statusLabel(s){return ({awaiting_payment:'در انتظار پرداخت',awaiting_bazaar_payment:'در انتظار پرداخت بازار',paid:'پرداخت‌شده',awaiting_approval:'منتظر تایید مدیر',provider_submitting:'در حال ارسال به TG Tools',provider_uncertain:'نیازمند بررسی ارسال',processing:'در حال فعال‌سازی',provider_pending:'در حال پردازش',delivered:'تحویل‌شده',payment_error:'خطای پرداخت',payment_mismatch:'مغایرت پرداخت',creating_payment:'در حال صدور فاکتور',refund_required:'در انتظار استرداد',refunded:'بازپرداخت‌شده',failed:'ناموفق'})[s]||s}
async function loadOrders(){
  if(!token)return;
  const d=await fetch('/api/admin/orders',{headers:H(),cache:'no-store'}).then(r=>r.json());
  const rows=(d.orders||[]);
  const action=o=>o.status==='awaiting_approval'?'<button class="approve-btn" data-code="'+o.order_code+'" onclick="approveOrder(this.dataset.code,this)">ارسال به TG Tools</button>':'—';
  const html=rows.map(o=>'<tr><td>'+o.order_code+'</td><td>@'+o.username+'</td><td>'+o.months+' ماه</td><td>'+money(o.price_toman)+'</td><td><span class="status '+o.status+'">'+statusLabel(o.status)+'</span></td><td>'+String(o.created_at||'').replace('T',' ').slice(0,16)+'</td><td>'+action(o)+'</td></tr>').join('');
  document.getElementById('ordersBody').innerHTML=html||'<tr><td colspan="7">سفارشی ثبت نشده است.</td></tr>';
  const recent=(summary?.recent_orders||[]).length?summary.recent_orders:rows.slice(0,10).map(o=>({
    ...o,target:o.username,category:'premium'
  }));
  const labels={stars:'⭐ استارز',gift:'🎁 گیفت',catalog:'🎮 گیفت‌کارت',smm:'📣 خدمات',nft:'💎 NFT',steam:'🎮 Steam'};
  const escapeText=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  document.getElementById('dashOrders').innerHTML=recent.map(o=>{
    const product=o.category==='premium'?money(o.months)+' ماه پرمیوم':labels[o.category]||'محصول دیجیتال';
    const destination=o.category==='premium'?'@'+String(o.target||'').replace(/^@/,''):o.target;
    return '<tr><td>'+escapeText(o.order_code)+'</td><td>'+escapeText(destination)+'</td>'+
      '<td>'+escapeText(product)+'</td><td>'+money(o.price_toman)+'</td>'+
      '<td><span class="status '+escapeText(o.status)+'">'+escapeText(statusLabel(o.status))+'</span></td></tr>';
  }).join('')||'<tr><td colspan="5">سفارشی ثبت نشده است.</td></tr>';
}
async function approveOrder(code,button){
  if(button)button.disabled=true;
  const r=await fetch('/api/admin/orders/'+encodeURIComponent(code)+'/approve',{method:'POST',headers:H()});
  const d=await r.json();
  if(!d.ok){alert(d.error==='order_not_waiting_approval'?'این سفارش قبلاً پردازش شده است.':'ارسال سفارش انجام نشد.');if(button)button.disabled=false;return}
  alert('سفارش برای TG Tools ارسال شد.');
  await load();
}
async function saveFulfillmentMode(){
  const mode=document.getElementById('fulfillmentMode').value;
  const r=await fetch('/api/admin/settings',{method:'PATCH',headers:H(),body:JSON.stringify({tgtools_fulfillment_mode:mode})});
  const d=await r.json();
  if(!d.ok){alert('ذخیره حالت ارسال انجام نشد.');return}
  summary.settings=d.settings||summary.settings;
  document.getElementById('fulfillmentMode').value=summary.settings.tgtools_fulfillment_mode||mode;
  alert(mode==='auto'?'ارسال خودکار فعال شد.':'تایید دستی فعال شد. سفارش‌های پرداخت‌شده منتظر تایید شما می‌مانند.');
}
async function saveTelegramBot(){
  const body={
    token:document.getElementById('botToken').value.trim(),
    admin_id:document.getElementById('botAdminId').value.trim(),
    enabled:document.getElementById('botEnabled').value==='1'
  };
  if(!body.admin_id){alert('Telegram Admin ID را وارد کن.');return}
  const r=await fetch('/api/admin/telegram-bot',{method:'POST',headers:H(),body:JSON.stringify(body)});
  const d=await r.json();
  if(!d.ok){
    const map={invalid_bot_token:'فرمت Bot Token معتبر نیست.',bot_token_rejected:'توکن توسط تلگرام تایید نشد.',invalid_admin_id:'Telegram Admin ID معتبر نیست.',bot_token_required:'ابتدا Bot Token را وارد کن.',set_webhook_failed:'ثبت Webhook در تلگرام ناموفق بود.'};
    alert(map[d.error]||d.message||'ذخیره تنظیمات ربات انجام نشد.');return
  }
  document.getElementById('botToken').value='';
  await load();
  alert(body.enabled?'ربات فعال شد و Webhook با موفقیت ثبت شد.':'ربات غیرفعال شد.');
}
async function testTelegramBot(){
  const r=await fetch('/api/admin/telegram-bot/test',{method:'POST',headers:H()});
  const d=await r.json();
  alert(d.ok?'پیام تست برای ادمین ارسال شد.':'ارسال پیام تست ناموفق بود. ابتدا ربات را فعال و Admin ID را بررسی کن.');
}
async function saveBazaar(){
  const body={
    bazaar_rsa_public_key:document.getElementById('bazaarRsa').value.trim(),
    bazaar_sku_3:document.getElementById('bazaarSku3').value.trim(),
    bazaar_sku_6:document.getElementById('bazaarSku6').value.trim(),
    bazaar_sku_12:document.getElementById('bazaarSku12').value.trim()
  };
  if(!body.bazaar_rsa_public_key||!body.bazaar_sku_3||!body.bazaar_sku_6||!body.bazaar_sku_12){alert('RSA Public Key و Product ID هر سه پلن را کامل وارد کن.');return}
  const r=await fetch('/api/admin/settings',{method:'PATCH',headers:H(),body:JSON.stringify(body)});
  const d=await r.json();
  if(!d.ok){alert(d.error==='invalid_bazaar_sku'?'Product ID کافه‌بازار معتبر نیست.':'ذخیره تنظیمات کافه‌بازار انجام نشد.');return}
  await load();alert('تنظیمات کافه‌بازار ذخیره شد؛ درگاه همچنان غیرفعال است.');
}
async function copyEndpoint(id){const input=document.getElementById(id);const value=input.value;try{await navigator.clipboard.writeText(value);alert('آدرس کپی شد.')}catch(e){input.select();document.execCommand('copy');alert('آدرس کپی شد.')}}
async function saveProviders(which){
  const body={};
  if(which==='tg'){
    const value=document.getElementById('tgkey').value.trim();
    if(!value){alert('کلید TG Tools را وارد کن.');return}
    body.tgtools_api_key=value;
  }
  if(which==='bp'){
    const value=document.getElementById('bpkey').value.trim();
    if(!value){alert('کلید BluePal را وارد کن.');return}
    body.blupal_api_key=value;
  }

  const r=await fetch('/api/admin/providers',{method:'POST',headers:H(),body:JSON.stringify(body)});
  const d=await r.json();
  if(!d.ok){alert('ذخیره اتصال انجام نشد.');return}
  document.getElementById('tgkey').value='';if(document.getElementById('bpkey'))document.getElementById('bpkey').value='';
  await load();
  if(which==='tg'){
    const tg=d.providers?.tgtools||{};
    if(tg.ok) alert('اتصال TG Tools با موفقیت تایید شد.');
    else if(Number(tg.http_status)===401||Number(tg.http_status)===403) alert('کلید TG Tools معتبر نیست یا غیرفعال شده است.');
    else alert('کلید ذخیره شد اما تست اتصال ناموفق بود. کد HTTP: '+Number(tg.http_status||0)+(tg.error?'\\n'+tg.error:''));
  }
}
async function saveSettings(passwordOnly=false){const body={};if(!passwordOnly){body.profit_percent=Number(document.getElementById('profit').value);body.rounding=Number(document.getElementById('rounding').value);body.support=document.getElementById('support').value}const np=document.getElementById('newpass').value;if(np)body.new_password=np;const r=await fetch('/api/admin/settings',{method:'PATCH',headers:H(),body:JSON.stringify(body)});const d=await r.json();if(!d.ok){alert(d.error==='weak_password'?'رمز باید حداقل ۱۰ کاراکتر باشد.':'ذخیره انجام نشد.');return}document.getElementById('newpass').value='';await load();alert(passwordOnly?'رمز مدیریت تغییر کرد.':'تنظیمات ذخیره شد.')}
async function savePlan(id){const v=document.getElementById('price-'+id).value;await fetch('/api/admin/plans/'+id,{method:'PATCH',headers:H(),body:JSON.stringify({manual_price_toman:v?Number(v):0})});await load()}
async function sync(){const b=event?.target;if(b)b.disabled=true;await fetch('/api/admin/sync',{method:'POST',headers:H()});await load();if(b)b.disabled=false}
async function reconcile(){const b=event?.target;if(b)b.disabled=true;await fetch('/api/admin/reconcile',{method:'POST',headers:H()});await loadOrders();if(b)b.disabled=false}
if(token)load();
</script>
</body></html>`;
}
