 of result.results || []) {
    try {
      await reconcileOrder(env, order, ctx);
      touched++;
    } catch (error) {
      console.error('reconcile order failed', order.order_code, error);
    }
  }
  return { touched };
}

async function reconcileOrder(env, order, ctx) {
  let current = order;
  if (current.status === 'awaiting_payment') {
    const blupalEnabled = String(await getSetting(env.DB, 'blupal_enabled', '0')) === '1';
    if (!blupalEnabled || String(current.payment_provider || 'blupal') !== 'blupal') return;
    const key = await getProviderSecret(env, 'blupal_api_key');
    if (!key || !current.blupal_invoice_id) return;
    const remote = await blupalRequest(key, 'GET', `/v1/invoices/${encodeURIComponent(current.blupal_invoice_id)}`);
    if (!remote.ok) return;
    const data = remote.data || remote.raw || {};
    const status = String(data.status || data.data?.status || '').toUpperCase();
    if (status !== 'PAID') return;
    const amount = Number(data.amount ?? data.data?.amount ?? 0);
    const expected = Number(current.price_toman) * 10;
    if (amount && amount !== expected) {
      await env.DB.prepare(`UPDATE orders SET status='payment_mismatch', provider_error='amount_mismatch', updated_at=? WHERE id=? AND status='awaiting_payment'`)
        .bind(new Date().toISOString(), current.id).run();
      return;
    }
    const fulfillmentMode = await getSetting(env.DB, 'tgtools_fulfillment_mode', 'auto');
    const paidStatus = fulfillmentMode === 'manual' ? 'awaiting_approval' : 'paid';
    await env.DB.prepare(`UPDATE orders SET status=?, paid_at=?, updated_at=? WHERE id=? AND status='awaiting_payment'`)
      .bind(paidStatus, new Date().toISOString(), new Date().toISOString(), current.id).run();
    current = await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(current.id).first();
  }

  if (current.status === 'paid') {
    const fulfillmentMode = await getSetting(env.DB, 'tgtools_fulfillment_mode', 'auto');
    if (fulfillmentMode === 'manual') {
      await env.DB.prepare(`UPDATE orders SET status='awaiting_approval', updated_at=? WHERE id=? AND status='paid'`)
        .bind(new Date().toISOString(), current.id).run();
      return;
    }
    const claim = await env.DB.prepare(`UPDATE orders SET status='provider_submitting', updated_at=? WHERE id=? AND status='paid'`)
      .bind(new Date().toISOString(), current.id).run();
    if (!claim.meta?.changes) return;
    current = await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(current.id).first();
    ctx?.waitUntil?.(deliverPremium(env, current));
    if (!ctx?.waitUntil) await deliverPremium(env, current);
    return;
  }

    if (current.status === 'provider_pending' && current.tg_transaction_id) {
    const key = await getProviderSecret(env, 'tgtools_api_key');
    if (!key) return;
    const remote = await tgRequest(key, 'GET', `/api/transaction/${encodeURIComponent(current.tg_transaction_id)}`);
    if (!remote.ok) return;
    const state = tgState(remote.data || {});
    if (state === 'completed') {
      await env.DB.prepare(`UPDATE orders SET status='delivered', delivered_at=?, updated_at=?, provider_error=NULL WHERE id=? AND status='provider_pending'`)
        .bind(new Date().toISOString(), new Date().toISOString(), current.id).run();
    } else if (state === 'failed') {
      await env.DB.prepare(`UPDATE orders SET status='failed', provider_error=?, updated_at=? WHERE id=? AND status='provider_pending'`)
        .bind(safeProviderMessage(remote.message || 'provider_failed'), new Date().toISOString(), current.id).run();
    }
  }
}

async function deliverPremium(env, order) {
  if (!order || order.status !== 'provider_submitting') return;
  const key = await getProviderSecret(env, 'tgtools_api_key');
  if (!key) {
    await markOrderError(env.DB, order.id, 'provider_not_configured');
    return;
  }
  const username = normalizeUsername(order.username);
  const months = Number(order.months);
  if (!username || !ALLOWED_MONTHS.includes(months)) {
    await markOrderError(env.DB, order.id, 'invalid_order_data');
    return;
  }

  const lookup = await tgRequest(key, 'GET', `/api/purchase/user/${encodeURIComponent(username)}`);
  if (!lookup.ok || lookup.data?.found === false || lookup.data?.premiumEligible === false) {
    await markOrderError(env.DB, order.id, 'telegram_account_not_eligible');
    return;
  }

  const purchase = await tgRequest(key, 'POST', '/api/purchase/premium', {
    recipientUsername: username,
    months,
    paymentMethod: 'ton',
    payFromBalance: true,
    trackingCode: order.order_code,
  });
  if (!purchase.ok) {
    const msg = safeProviderMessage(purchase.message || 'provider_request_failed');
    const uncertain = purchase.http_status === 0 || purchase.http_status >= 500;
    await env.DB.prepare(`UPDATE orders SET status=?, provider_error=?, updated_at=? WHERE id=? AND status='provider_submitting'`)
      .bind(uncertain ? 'provider_uncertain' : 'failed', msg, new Date().toISOString(), order.id).run();
    return;
  }

  const data = purchase.data || {};
  const tx = String(data.transactionId || data.id || '').trim();
  if (!tx) {
    await env.DB.prepare(`UPDATE orders SET status='provider_pending', provider_error='missing_transaction_id', updated_at=? WHERE id=? AND status='provider_submitting'`)
      .bind(new Date().toISOString(), order.id).run();
    return;
  }
  const state = tgState(data);
  if (state === 'failed') {
    await env.DB.prepare(`UPDATE orders SET status='failed', tg_transaction_id=?, provider_error=?, updated_at=? WHERE id=? AND status='provider_submitting'`)
      .bind(tx, safeProviderMessage(data.message || purchase.message || 'provider_failed'), new Date().toISOString(), order.id).run();
  } else if (state === 'completed') {
    await env.DB.prepare(`UPDATE orders SET status='delivered', tg_transaction_id=?, delivered_at=?, provider_error=NULL, updated_at=? WHERE id=? AND status='provider_submitting'`)
      .bind(tx, new Date().toISOString(), new Date().toISOString(), order.id).run();
  } else {
    await env.DB.prepare(`UPDATE orders SET status='provider_pending', tg_transaction_id=?, provider_error=NULL, updated_at=? WHERE id=? AND status='provider_submitting'`)
      .bind(tx, new Date().toISOString(), order.id).run();
  }
}

async function syncPricing(env) {
  const tgKey = await getProviderSecret(env, 'tgtools_api_key');
  const prices = tgKey
    ? await tgRequest(tgKey, 'GET', '/api/purchase/prices')
    : await tgRequest(null, 'GET', '/api/purchase/prices', null, false);
  if (!prices.ok) return { ok: false, error: 'tgtools_prices_failed', message: prices.message };
  const pd = prices.data || {};

