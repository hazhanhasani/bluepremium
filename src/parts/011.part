
async function verifyGitHubOidc(request) {
  const header = String(request.headers.get('authorization') || '');
  if (!header.startsWith('Bearer ')) return null;
  const token = header.slice(7).trim();
  if (token.length < 100 || token.length > 12000) return null;
  const parts = token.split('.');
  if (parts.length !== 3) return null;

  let jose, claims;
  try {
    jose = JSON.parse(dec.decode(base64UrlToBytes(parts[0])));
    claims = JSON.parse(dec.decode(base64UrlToBytes(parts[1])));
  } catch (_) {
    return null;
  }

  if (jose.alg !== 'RS256' || !jose.kid) return null;
  if (claims.iss !== 'https://token.actions.githubusercontent.com') return null;

  const aud = Array.isArray(claims.aud) ? claims.aud : [claims.aud];
  if (!aud.includes('bluepremium-signing')) return null;

  const now = Math.floor(Date.now() / 1000);
  if (!Number.isFinite(Number(claims.exp)) || Number(claims.exp) < now - 15) return null;
  if (claims.nbf != null && Number(claims.nbf) > now + 30) return null;
  if (claims.iat != null && Number(claims.iat) < now - 900) return null;

  if (String(claims.repository_id || '') !== '1404200937') return null;
  if (String(claims.repository_owner_id || '') !== '311383112') return null;
  if (String(claims.repository || '') !== 'hazhanhasani/bluepremium') return null;
  if (String(claims.ref || '') !== 'refs/heads/main') return null;
  if (String(claims.workflow_ref || '') !== 'hazhanhasani/bluepremium/.github/workflows/android.yml@refs/heads/main') return null;

  try {
    const response = await fetch('https://token.actions.githubusercontent.com/.well-known/jwks', {
      headers: { accept: 'application/json' },
      cf: { cacheTtl: 3600, cacheEverything: true },
    });
    if (!response.ok) return null;
    const jwks = await response.json();
    const jwk = (jwks.keys || []).find(k => k.kid === jose.kid && k.kty === 'RSA');
    if (!jwk) return null;
    const key = await crypto.subtle.importKey(
      'jwk',
      jwk,
      { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },
      false,
      ['verify']
    );
    const signed = enc.encode(parts[0] + '.' + parts[1]);
    const valid = await crypto.subtle.verify(
      'RSASSA-PKCS1-v1_5',
      key,
      base64UrlToBytes(parts[2]),
      signed
    );
    return valid ? claims : null;
  } catch (_) {
    return null;
  }
}
