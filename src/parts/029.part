function bpRefineDecorate(html){return html.replace("</head>",'<style id="bp-refine-v51">'+bpRefineCss()+"</style></head>").replace("</body>",'<script>('+bpRefineClient.toString()+')()</script></body>');}
function bpRefineCss(){return "\n/* Mobile storefront composition v5.1. One hero, four service cards, five visible tabs. */\nbody.bp-shell-v3.bp-home-reboot[data-bp-active=\"home\"] .topbar{display:none!important}\nbody.bp-shell-v3.bp-home-reboot .shell{padding-top:8px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-intro{\n display:flex;direction:rtl;align-items:center;justify-content:space-between;gap:8px;\n margin:6px 2px 17px;min-height:63px\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-user{display:flex;align-items:center;gap:9px;min-width:0}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-avatar{\n width:54px;height:54px;flex:0 0 54px;border-radius:50%;border:3px solid #719ffc;\n background:#e3e9ff;display:grid;place-items:center;overflow:hidden;box-shadow:0 0 0 3px #112341\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-avatar img{height:100%;width:100%;object-fit:cover}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-user strong{display:block;font-size:15px;line-height:1.75;color:#fafbff}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-user small{display:block;font-size:10px;line-height:1.7;color:#98a8c8;letter-spacing:.03em}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-wallet{\n flex:0 0 auto;display:inline-flex;gap:6px;align-items:center;justify-content:center;\n min-height:45px;border:1px solid #41659c;border-radius:16px;\n background:linear-gradient(135deg,#19375b,#11223e);color:#f6f9ff;\n font:800 12px/1.6 \"Vazirmatn\",Tahoma,sans-serif;padding:9px 11px;\n box-shadow:inset 0 1px #ffffff21;cursor:pointer\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-wallet svg{width:18px;height:18px}\nbody.bp-shell-v3.bp-home-reboot .bp-hero{\n min-height:180px!important;margin:0 0 25px!important;border-radius:23px!important;\n padding:20px 18px!important;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;\n background:radial-gradient(170px 150px at 17% 49%,#355aaf55,transparent 78%),linear-gradient(112deg,#0a1533,#10153e 86%)!important;\n box-shadow:inset 0 1px #ffffff19,0 9px 22px #0003!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-hero .bp-editorial-tag{justify-content:flex-start;direction:ltr;font-size:9px;letter-spacing:.9px;margin:0 0 4px;position:relative;z-index:2}\nbody.bp-shell-v3.bp-home-reboot .bp-hero h1{\n font-size:22px!important;line-height:1.5!important;max-width:60%;\n margin:5px 0!important;color:#fff!important;letter-spacing:-.4px!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-hero h1 em{color:#a8bbff!important}\nbody.bp-shell-v3.bp-home-reboot .bp-hero p{\n font-size:10px!important;line-height:1.95!important;max-width:57%!important;\n margin:5px 0 0!important;color:#b3c0de!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-hero-art{\n left:1px!important;top:13px!important;width:161px!important;height:161px!important;\n opacity:1!important;transform:rotate(-13deg)!important;\n filter:drop-shadow(0 0 14px #496de38c) drop-shadow(0 12px 11px #060e20)!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-hero .bp-hero-foot{display:none!important}\nbody.bp-shell-v3.bp-home-reboot .bp-featured{margin:0 0 22px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-section-head{margin-bottom:12px!important;display:flex;justify-content:space-between;align-items:center}\nbody.bp-shell-v3.bp-home-reboot .bp-section-head h2{font-size:17px!important;line-height:1.7!important;margin:0!important;color:#f5f7ff!important}\nbody.bp-shell-v3.bp-home-reboot .bp-section-head .bp-overline{font-size:9px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-featured .bp-section-note{font-size:10px!important;color:#a3b0c9!important}\nbody.bp-shell-v3.bp-home-reboot .bp-quick-grid{\n display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important;align-items:stretch\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card{\n height:236px!important;min-height:236px!important;max-height:236px!important;\n padding:13px 12px 12px!important;border-radius:21px!important;border:1px solid #687bb943!important;\n display:flex!important;flex-direction:column!important;align-items:center!important;\n justify-content:flex-start!important;gap:4px!important;text-align:center!important;\n position:relative!important;overflow:hidden!important;min-width:0;isolation:isolate;\n box-shadow:0 8px 16px #0004,inset 0 1px #ffffff1c!important;\n font-family:\"Vazirmatn\",Tahoma,sans-serif!important;color:#f9faff!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card[data-service=\"premium\"]{\n background:radial-gradient(95px 100px at 50% 22%,#6657ca68,transparent),linear-gradient(155deg,#191a3b,#211633)!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card[data-service=\"stars\"]{\n background:radial-gradient(95px 100px at 50% 22%,#b58b326a,transparent),linear-gradient(155deg,#232034,#261f10)!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card[data-service=\"gift\"]{\n background:radial-gradient(95px 100px at 50% 22%,#ae4e9d5c,transparent),linear-gradient(155deg,#20162c,#2c1427)!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card[data-service=\"catalog\"]{\n background:radial-gradient(95px 100px at 50% 22%,#368fd26d,transparent),linear-gradient(155deg,#14223b,#102b34)!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card .bp-card-label{\n align-self:flex-start;font-size:8px!important;line-height:1.5!important;color:#b8b3dc!important;\n font-family:\"Vazirmatn\",sans-serif!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card .bp-quick-icon,\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card.bp-category>span:first-child{\n width:89px!important;height:87px!important;max-width:none!important;min-width:0;\n background:transparent!important;border:0!important;padding:0!important;\n display:grid!important;place-items:center!important;margin:0 auto 2px!important;\n filter:drop-shadow(0 6px 9px #02061788)!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card .bp-art{\n display:block!important;width:88px!important;height:88px!important;max-width:none!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card>strong{\n display:block!important;width:100%;font-size:14px!important;line-height:1.7!important;\n margin:1px 0 0!important;color:#fff!important;min-height:24px;font-weight:900;text-align:center!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card>small{\n display:-webkit-box!important;width:100%;max-width:100%;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;\n font-size:10px!important;line-height:1.8!important;min-height:36px;\n margin:0!important;color:#aab4cb!important;white-space:normal;text-align:center!important;\n font-weight:500!important\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card .bp-inline-arrow,\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card .bp-v5-cta{\n display:flex!important;align-items:center;justify-content:center;gap:4px;\n background:linear-gradient(95deg,#48308d,#6946ab)!important;\n border-radius:11px!important;color:#fff!important;font-size:11px!important;font-weight:850!important;\n padding:8px 5px!important;margin:auto 0 0!important;width:100%;min-height:37px;\n text-align:center!important;box-sizing:border-box;line-height:1.55\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card[data-service=\"stars\"] .bp-inline-arrow{background:linear-gradient(95deg,#856126,#a9832c)!important}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card[data-service=\"gift\"] .bp-v5-cta{background:linear-gradient(95deg,#813260,#a3447a)!important}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card[data-service=\"catalog\"] .bp-v5-cta{background:linear-gradient(95deg,#146783,#246b9e)!important}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-service-card:active{transform:scale(.985)!important}\nbody.bp-shell-v3.bp-home-reboot .bp-discover{margin-top:23px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-discover-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-discover .bp-category{min-height:124px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-discover .bp-category .bp-art{width:59px!important;height:59px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-overview{margin-top:23px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-overview .bp-overview-card{min-height:102px!important}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-trust{\n display:flex;gap:6px;flex-wrap:wrap;justify-content:center;align-items:center;\n margin:12px 0 6px;padding:11px 9px;border:1px solid #51668b70;border-radius:15px;\n background:#15223a;font-size:10px;color:#becbed\n}\nbody.bp-shell-v3.bp-home-reboot .bp-v5-trust span+span::before{content:\"•\";margin-inline-end:7px;color:#8e7cda}\nbody.bp-shell-v3.bp-home-reboot .bp-app-nav{grid-template-columns:repeat(5,minmax(0,1fr))!important}\nbody.bp-shell-v3.bp-home-reboot .bp-app-nav [data-bp-tab=\"catalog\"]{display:none!important}\nbody.bp-shell-v3.bp-home-reboot .bp-app-nav button{\n font-size:10px!important;min-height:59px!important;min-width:0!important;line-height:1.35!important\n}\n@media(max-width:355px){\n body.bp-shell-v3.bp-home-reboot .bp-hero-art{width:126px!important;height:126px!important;top:29px!important}\n body.bp-shell-v3.bp-home-reboot .bp-v5-service-card{padding:11px 9px!important;height:227px!important;min-height:227px!important}\n body.bp-shell-v3.bp-home-reboot .bp-v5-service-card>strong{font-size:12px!important}\n body.bp-shell-v3.bp-home-reboot .bp-v5-service-card>small{font-size:9px!important}\n body.bp-shell-v3.bp-home-reboot .bp-v5-intro{gap:6px}\n body.bp-shell-v3.bp-home-reboot .bp-v5-user strong{font-size:12px}\n}\n@media(prefers-reduced-motion:reduce){\n body.bp-shell-v3.bp-home-reboot .bp-v5-service-card{transition:none!important;animation:none!important}\n}\n";}

function bpRefineClient(){
 if(document.body.classList.contains('bp-home-reboot'))return;
 const home=document.querySelector('.bp-tab-view[data-bp-view="home"]');
 const hero=home?.querySelector('.bp-hero');
 const featured=home?.querySelector('.bp-featured');
 const discover=home?.querySelector('.bp-discover');
 const grid=featured?.querySelector('.bp-quick-grid');
 if(!home||!hero||!featured||!discover||!grid)return;
 document.body.classList.add('bp-home-reboot');
 // Navigation, checkout, provider and wallet logic still belong to original app.
 const intro=document.createElement('div');intro.className='bp-v5-intro';
 const user=document.createElement('div');user.className='bp-v5-user';
 const avatar=document.createElement('span');avatar.className='bp-v5-avatar';
 const logo=document.createElement('img');logo.src='/brandmark.webp?v=8';logo.alt='لوگوی بلوپرمیوم';logo.loading='eager';avatar.appendChild(logo);
 const userCopy=document.createElement('span');
 const title=document.createElement('strong');title.textContent='سلام، خوش آمدی 👋';
 const subtitle=document.createElement('small');subtitle.textContent='BLUE PREMIUM';
 userCopy.append(title,subtitle);user.append(avatar,userCopy);
 const wallet=document.createElement('button');wallet.type='button';wallet.className='bp-v5-wallet';
 wallet.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="3"/><path d="M3 10h18M16 15h2"/></svg><span>کیف پول</span>';
 wallet.addEventListener('click',()=>{if(typeof window.bpOpenTab==='function')window.bpOpenTab('account')});
 intro.append(user,wallet);hero.before(intro);
 const telegramUser=window.Telegram?.WebApp?.initDataUnsafe?.user;
 if(telegramUser?.first_name)title.textContent='سلام، '+String(telegramUser.first_name).slice(0,26);
 const badge=hero.querySelector('.bp-editorial-tag');
 if(badge)badge.textContent='PREMIUM SERVICES';
 const heading=hero.querySelector('h1');
 if(heading)heading.innerHTML='خدمات ویژه<br><em>بلوپرمیوم</em>';
 const desc=hero.querySelector('p');
 if(desc)desc.textContent='پرمیوم، استارز و هدیه‌های دیجیتال در یک فروشگاه.';
 const caption=featured.querySelector('.bp-section-head h2');if(caption)caption.textContent='انتخاب سرویس';
 const kicker=featured.querySelector('.bp-section-head .bp-overline');if(kicker)kicker.textContent='OUR SERVICES';
 const note=featured.querySelector('.bp-section-note');if(note)note.textContent='خرید ساده و امن';
 const entries=[
  {element:grid.querySelector('[data-bp-go="premium"]'),kind:'premium',description:'اشتراک اختصاصی با فعال‌سازی آسان',cta:'خرید پرمیوم'},
  {element:grid.querySelector('[data-bp-go="stars"]'),kind:'stars',description:'حمایت از سازندگان و خرید بسته‌های استارز',cta:'خرید استارز'},
  {element:discover.querySelector('[data-bp-kind="gift"]'),kind:'gift',description:'هدیه‌های دیجیتال برای دوستان شما',cta:'مشاهده هدیه‌ها'},
  {element:discover.querySelector('[data-bp-kind="catalog"]'),kind:'catalog',description:'گیفت کارت و محصولات منتخب',cta:'مشاهده محصولات'}
 ];
 for(const entry of entries){
  const card=entry.element;
  if(!card)continue;
  card.classList.add('bp-v5-service-card');
  card.dataset.service=entry.kind;
  const small=card.querySelector('small');if(small)small.textContent=entry.description;
  const action=card.querySelector('.bp-inline-arrow');
  if(action){action.textContent=entry.cta}
  else{const span=document.createElement('span');span.className='bp-v5-cta';span.textContent=entry.cta;card.appendChild(span)}
  // Reuse the original buttons instead of cloning: preserves event behavior.
  grid.appendChild(card);
 }
 const overview=home.querySelector('.bp-overview');
 const hint=home.querySelector('.bp-overview-status');
 if(overview){discover.insertAdjacentElement('afterend',overview);if(hint)overview.insertAdjacentElement('afterend',hint)}
 const trust=document.createElement('div');trust.className='bp-v5-trust';trust.setAttribute('aria-label','مزیت‌های فروشگاه');
 for(const label of ['خرید امن','پیگیری سفارش','پشتیبانی']){const item=document.createElement('span');item.textContent=label;trust.appendChild(item)}
 featured.insertAdjacentElement('afterend',trust);
 const nav=document.querySelector('.bp-app-nav');
 const homeTab=nav?.querySelector('[data-bp-tab="home"] span:last-child');
 if(homeTab)homeTab.textContent='فروشگاه';
}
