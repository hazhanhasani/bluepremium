
// Quote-based TG Tools products. Quotes are never extrapolated from collection floor prices.
const TG_STEAM_AMOUNTS=[100,200,500,1000];
const TG_STEAM_CURRENCIES=['RUB','USD','EUR','TRY','KZT','UAH','ARS'];
function tgTonAddress(v) {
  const s=String(v||'').trim();
  return /^(?:[EU]Q[A-Za-z0-9_-]{46}|0:[0-9a-fA-F]{64})$/.test(s)?s:'';
}
function tgQuotedTon(d) {
  const value=d?.totalPriceTon??d?.totalTon??d?.tonAmount??d?.quote?.totalPriceTon??d?.priceTon??d?.costTon;
  const n=Number(value);
  return Number.isFinite(n)&&n>0&&n<100000?n:0;
}
async function tgLiveQuote(env,kind,sku) {
  const key=await getProviderSecret(env,'tgtools_api_key');
  if(!key)return null;
  let remote,details;
  if(kind==='nft'){
    if(!tgTonAddress(sku))return null;
    remote=await tgRequest(key,'GET','/api/marketplace/quote?address='+encodeURIComponent(sku));
    details=remote.data;
    if(details?.canBuy!==true)return null;
  }else if(kind==='steam'){
    const match=String(sku).match(/^([A-Z]{3}):(\d{1,5})$/);
    if(!match||!TG_STEAM_CURRENCIES.includes(match[1]))return null;
    const amount=Number(match[2]);
    if(!Number.isSafeInteger(amount)||amount<10||amount>10000)return null;
    remote=await tgRequest(key,'GET','/api/steam-topup/quote?currency='+match[1]+'&amount='+amount);
    details=remote.data;
    if(details?.available===false||details?.canBuy===false)return null;
  }else return null;
  if(!remote.ok)return null;
  const ton=tgQuotedTon(details);
  const price=await tgPrice(env,kind,ton);
  if(!ton||!price)return null;
  return {kind,sku,title:kind==='nft'?'گیفت NFT تلگرام':'شارژ Steam '+sku,
    quantity:1,ton,price_toman:price,target_type:kind==='nft'?'ton_wallet':'steam_login',
    quote_time:new Date().toISOString()};
}
async function tgQuoteBySku(env,kind,sku) {
  if(!TG_TYPES.includes(kind))return null;
  if(String(await getSetting(env.DB,'market_'+kind+'_enabled','0'))!=='1')return null;
  if(kind==='nft'||kind==='steam')return tgLiveQuote(env,kind,sku);
  return (await tgProducts(env,kind)).find(p=>p.sku===sku)||null;
}
function tgFulfillmentInput(order) {
  if(order.kind==='nft')return {
    path:'/api/marketplace/buy/auto',
    body:{nftAddress:order.sku,recipientTonAddress:order.target,clientOrderId:order.order_code}
  };
  if(order.kind==='steam'){
    const [currency,amount]=order.sku.split(':');
    return {path:'/api/steam-topup/buy',body:{steamLogin:order.target,currency,amount:Number(amount)}};
  }
  if(order.kind==='stars')return {path:'/api/purchase/stars',body:{
    recipientUsername:order.target,amount:order.quantity,paymentMethod:'ton',trackingCode:order.order_code}};
  if(order.kind==='gift')return {path:'/api/Purchase/gift',body:{
    recipientUsername:order.target,giftId:order.sku,trackingCode:order.order_code}};
  if(order.kind==='smm'){
    const info=JSON.parse(order.provider_payload||'{}');
    return {path:'/api/Purchase/smm',body:{serviceId:Number(info.serviceId||order.sku),link:order.target,
      quantity:order.quantity,bundleKey:info.bundleKey||null}};
  }
  if(order.kind==='catalog')return {path:'/api/catalog/buy',body:{
    productId:Number(order.sku),quantity:order.quantity,...(order.target?{playerId:order.target}:{})}};
  return null;
}
function tgOrderDetailRoute(order) {
  const id=encodeURIComponent(order.provider_transaction_id||'');
  if(!/^\d{1,20}$/.test(String(order.provider_transaction_id||'')))return '';
  if(order.kind==='nft')return '/api/marketplace/orders/'+id;
  if(order.kind==='catalog')return '/api/catalog/orders/'+id;
  if(order.kind==='steam')return '/api/fazer/orders/'+id;
  return '/api/Purchase/'+id;
}
async function tgPreflightDelivery(env,order){
  if(!['nft','steam'].includes(order.kind))return {ok:true};
  const updated=await tgLiveQuote(env,order.kind,order.sku);
  const quoteBase=Number(order.quoted_ton);
  // A pre-paid order must NOT execute on a stale/higher quote.
  if(!updated||updated.ton>quoteBase*1.005)return {ok:false,error:'reprice_or_sold_out'};
  if(order.kind==='nft'&&!tgTonAddress(order.target))return {ok:false,error:'invalid_ton_wallet'};
  if(order.kind==='steam'){
    const key=await getProviderSecret(env,'tgtools_api_key');
    const result=await tgRequest(key,'POST','/api/steam-topup/check-login',{steamLogin:order.target});
    if(!result.ok||result.data?.valid===false||result.data?.found===false)
      return {ok:false,error:'invalid_steam_login'};
  }
  return {ok:true};
}


async function tgStopBeforeProvider(env,order,reason){
  const now=new Date().toISOString(),why=String(reason||'preflight_failed').slice(0,100);
  if(order.payment_provider==='wallet'&&order.telegram_user_id){
    const result=await env.DB.batch([
      env.DB.prepare("UPDATE bp_market_orders SET status='refunded',provider_error=?,updated_at=? WHERE id=? AND status='paid'")
        .bind(why,now,order.id),
      env.DB.prepare(
        "INSERT OR IGNORE INTO bp_wallet_ledger(telegram_id,delta_toman,kind,actor,reason,order_code,idempotency_key) "+
        "SELECT ?,?,'refund','system',?,?,? "+
        "WHERE EXISTS(SELECT 1 FROM bp_market_orders WHERE id=? AND status='refunded')")
        .bind(order.telegram_user_id,Number(order.price_toman),
          'TG Tools checkout unavailable',order.order_code,'refund:'+order.order_code,order.id)
    ]);
    if(result[0]?.meta?.changes)await telegramSendMessage(env,order.telegram_user_id,
      '⚠️ سفارش '+telegramEscapeHtml(order.order_code)+' قبل از ارسال به سرویس‌دهنده متوقف شد. مبلغ به کیف پول شما برگشت.').catch(()=>{});
  }else{
    await env.DB.prepare("UPDATE bp_market_orders SET status='refund_required',provider_error=?,updated_at=? WHERE id=? AND status='paid'")
      .bind(why,now,order.id).run();
    await notifyTelegramAdmin(env,'⚠️ سفارش '+telegramEscapeHtml(order.order_code)+
      ' قبل از ارسال متوقف شد و بررسی/استرداد وجه لازم است: '+telegramEscapeHtml(why)).catch(()=>{});
  }
}


async function tgRefundSoldOutGift(env,order) {
  if(order.kind!=='gift'||order.payment_provider!=='wallet'||!order.telegram_user_id)return false;
  const ledgerSql="INSERT OR IGNORE INTO bp_wallet_ledger(telegram_id,delta_toman,kind,actor,reason,order_code,idempotency_key) "+
    "SELECT telegram_user_id,price_toman,'refund','system','Provider confirmed gift sold out',order_code,'refund:'||order_code "+
    "FROM bp_market_orders WHERE id=? AND kind='gift' AND status='failed' "+
    "AND payment_provider='wallet' AND provider_transaction_id IS NULL AND lower(provider_error) LIKE '%sold out%'";
  const result=await env.DB.batch([
    env.DB.prepare(ledgerSql).bind(order.id),
    env.DB.prepare("UPDATE bp_market_orders SET status='refunded',updated_at=? WHERE id=? AND status='failed' "+
      "AND kind='gift' AND payment_provider='wallet' AND provider_transaction_id IS NULL "+
      "AND lower(provider_error) LIKE '%sold out%' "+
      "AND EXISTS(SELECT 1 FROM bp_wallet_ledger WHERE idempotency_key=?)")
      .bind(new Date().toISOString(),order.id,'refund:'+order.order_code)
  ]);
  const credited=Number(result[0]?.meta?.changes||0)===1;
  if(credited)await telegramSendMessage(env,order.telegram_user_id,
    '✅ مبلغ سفارش گیفت '+telegramEscapeHtml(order.order_code)+
    ' به‌دلیل ناموجودبودن محصول به کیف پول شما برگردانده شد.').catch(()=>{});
  return credited;
}


async function tgNftBrowse(env){
  if(String(await getSetting(env.DB,'market_nft_enabled','0'))!=='1')return [];
  const key=await getProviderSecret(env,'tgtools_api_key');
  if(!key)return [];
  const response=await tgRequest(key,'GET','/api/marketplace/browse?limit=40',null,true);
  if(!response.ok)return [];
  const d=response.data||{};
  const candidates=Array.isArray(d)?d:
    d.items||d.listings||d.results||d.nfts||d.data?.items||d.data?.listings||[];
  if(!Array.isArray(candidates))return [];
  const seen=new Set(),out=[];
  for(const row of candidates.slice(0,100)){
    const a=tgTonAddress(row.nftAddress||row.nft?.address||row.address||row.itemAddress);
    if(!a||seen.has(a)||row.sold===true||row.isForSale===false||row.listed===false)continue;
    seen.add(a);
    out.push({kind:'nft',sku:a,title:bpName(row.nftName||row.name||row.title||'گیفت NFT تلگرام',90),
      target_type:'ton_wallet'});
    if(out.length>=30)break;
  }
  return out;
}
