  const orderMatch = path.match(/^\/api\/orders\/([A-Za-z0-9-]{6,40})(?:\/(check))?$/);
  if (orderMatch && request.method === 'GET') {
    const code = orderMatch[1];
    const token = sanitizeToken(url.searchParams.get('token'), 128);
    if (!token) return api({ ok: false, error: 'unauthorized' }, 401);
    const order = await getAuthorizedOrder(env.DB, code, token);
    if (!order) return api({ ok: false, error: 'not_found' }, 404);
    if (orderMatch[2] === 'check') await reconcileOrder(env, order, ctx);
    const fresh = await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(order.id).first();
    return api({ ok: true, order: publicOrder(fresh || order) });
  }

  if (path.startsWith('/api/orders/') && path.endsWith('/bazaar/confirm') && request.method === 'POST') {
    const code = sanitizeToken(path.slice('/api/orders/'.length, -'/bazaar/confirm'.length), 40);
    const body = await readJson(request, 131072);
    const token = sanitizeToken(body.token, 128);
    if (!code || !token) return api({ ok: false, error: 'unauthorized' }, 401);
    const order = await getAuthorizedOrder(env.DB, code, token);
    if (!order) return api({ ok: false, error: 'not_found' }, 404);

    const result = await confirmBazaarPurchase(env, order, body, ctx);
    if (!result.ok) return api({ ok: false, error: result.error }, result.status || 400);
    const fresh = result.order || await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(order.id).first();
    return api({
      ok: true,
      order: publicOrder(fresh || order),
      consume_purchase_token: String((fresh || order).bazaar_purchase_token || body.purchase_token || body.purchaseToken || ''),
    });
  }

  if (path.startsWith('/api/orders/') && path.endsWith('/bazaar/consumed') && request.method === 'POST') {
    const code = sanitizeToken(path.slice('/api/orders/'.length, -'/bazaar/consumed'.length), 40);
    const body = await readJson(request);
    const token = sanitizeToken(body.token, 128);
    const purchaseToken = normalizeBazaarReceiptToken(body.purchase_token || body.purchaseToken);
    if (!code || !token || !purchaseToken) return api({ ok: false, error: 'invalid_request' }, 400);
    const order = await getAuthorizedOrder(env.DB, code, token);
    if (!order || String(order.bazaar_purchase_token || '') !== purchaseToken) return api({ ok: false, error: 'not_found' }, 404);
    await env.DB.prepare(`UPDATE orders SET bazaar_consumed=1, updated_at=? WHERE id=?`)
      .bind(new Date().toISOString(), order.id).run();
    return api({ ok: true });
  }

  if (path === '/payment/blupal/callback' && (request.method === 'GET' || request.method === 'POST')) {
    const body = await readLoosePayload(request, 65536);
    const invoiceId = sanitizeToken(
      url.searchParams.get('invoice_id') ||
      url.searchParams.get('invoiceId') ||
      url.searchParams.get('invoice') ||
      url.searchParams.get('id') ||
      callbackField(body, ['invoice_id','invoiceId','invoice','id']),
      128
    );
    const orderCode = sanitizeToken(
      url.searchParams.get('order_id') ||
      url.searchParams.get('order') ||
      callbackField(body, ['order_id','order']),
      40
    );

    let order = invoiceId
      ? await env.DB.prepare(`SELECT * FROM orders WHERE blupal_invoice_id=? LIMIT 1`).bind(invoiceId).first()
      : null;
    if (!order && orderCode) {
      order = await env.DB.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(orderCode).first();
    }
    if (!order) return blupalCallbackResponse(null, 'error', 404);
    if (String(await getSetting(env.DB, 'blupal_enabled', '1')) !== '1' || String(order.payment_provider || '') !== 'blupal') {
      return api({ ok: false, error: 'blupal_disabled' }, 410);
    }

    await reconcileOrder(env, order, ctx);
    const fresh = await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(order.id).first() || order;
    if (fresh.status === 'payment_mismatch' || fresh.status === 'payment_error' || fresh.status === 'failed') {
      return blupalCallbackResponse(fresh, 'error', 409);
    }
    if (fresh.status === 'awaiting_payment' || fresh.status === 'creating_payment') {
      return blupalCallbackResponse(fresh, 'pending', 200);
    }
    return blupalCallbackResponse(fresh, 'success', 200);
  }

  if (path === '/api/webhooks/blupal' && request.method === 'POST') {
    const body = await readJson(request, 65536);
    const event = String(body.event || '').trim();
    const remoteStatus = String(body.status || '').trim().toUpperCase();
    if (event && event !== 'payment.completed') return api({ ok: true, ignored: 'event' });
    if (remoteStatus && remoteStatus !== 'PAID') return api({ ok: true, ignored: 'status' });

    const invoiceId = sanitizeToken(body.invoice_id || body.invoiceId || body.invoice || body.id, 128);
    if (!invoiceId) return api({ ok: false, error: 'invalid_invoice' }, 400);
    const order = await env.DB.prepare(`SELECT * FROM orders WHERE blupal_invoice_id=? LIMIT 1`).bind(invoiceId).first();
    if (!order) return api({ ok: false, error: 'not_found' }, 404);
    if (String(await getSetting(env.DB, 'blupal_enabled', '1')) !== '1' || String(order.payment_provider || '') !== 'blupal') {
      return api({ ok: false, error: 'blupal_disabled' }, 410);
    }

    // Webhook data is only a trigger. Status and amount are always re-fetched from BluePal.
    await reconcileOrder(env, order, ctx);
    const fresh = await env.DB.prepare(`SELECT status FROM orders WHERE id=?`).bind(order.id).first();
    return api({ ok: true, status: fresh?.status || order.status });
  }

  if (path === '/api/telegram/bot/webhook' && request.method === 'POST') {
    const enabled = String(await getSetting(env.DB, 'telegram_bot_enabled', '0')) === '1';
    if (!enabled) return api({ ok: true, disabled: true });

    const expectedSecret = await getSetting(env.DB, 'internal_telegram_webhook_secret', '');
    const suppliedSecret = String(request.headers.get('x-telegram-bot-api-secret-token') || '');
    if (!expectedSecret || !timingSafeEqual(suppliedSecret, expectedSecret)) {
      return api({ ok: false, error: 'invalid_webhook_secret' }, 403);
    }

    const update = await readJson(request, 131072);
    const task = handleTelegramBotUpdate(env, update, url.origin, ctx);
    if (ctx?.waitUntil) ctx.waitUntil(task);
    else await task;
    return api({ ok: true });
  }

  if (path === '/api/admin/login' && request.method === 'POST') {
    const body = await readJson(request);
    const password = String(body.password || '');
    const candidate = await sha256Hex(password);
    const adminHash = await getSetting(env.DB, 'admin_password_hash', env.ADMIN_PASSWORD_HASH || '');
    if (!timingSafeEqual(candidate, adminHash)) return api({ ok: false, error: 'invalid_credentials' }, 401);
    const token = await signAdminToken(env, { exp: Date.now() + 12 * 60 * 60 * 1000 });
    return api({ ok: true, token, expires_in: 43200 });
  }

  if (path.startsWith('/api/admin/')) {
    const auth = await requireAdmin(request, env);
    if (!auth) return api({ ok: false, error: 'unauthorized' }, 401);

    if (path === '/api/admin/summary' && request.method === 'GET') {
      const [orders, providers, settings, plans] = await Promise.all([
        env.DB.prepare(`SELECT status, COUNT(*) count, COALESCE(SUM(price_toman),0) total FROM orders GROUP BY status`).all(),
        providerHealth(env),
        adminSettings(env.DB),
        env.DB.prepare(`SELECT * FROM plans ORDER BY months`).all(),
      ]);
      return api({ ok: true, orders: orders.results || [], providers, settings, plans: plans.results || [] });
    }

    if (path === '/api/admin/orders' && request.method === 'GET') {
      const result = await env.DB.prepare(`SELECT order_code, months, username, price_toman, status, payment_provider, bazaar_product_id, bazaar_order_id, bazaar_consumed, blupal_invoice_id, tg_transaction_id, provider_error, paid_at, created_at, updated_at FROM orders ORDER BY id DESC LIMIT 100`).all();
      return api({ ok: true, orders: result.results || [] });
    }

    if (path === '/api/admin/telegram-bot' && request.method === 'POST') {
      const body = await readJson(request);
      const result = await configureTelegramBot(env, url.origin, {
        token: String(body.token || ''),
        adminId: String(body.admin_id || ''),
        enabled: body.enabled !== false,
      });
      if (!result.ok) {
        const status = ['invalid_bot_token','invalid_admin_id','bot_token_required'].includes(result.error) ? 400 : 502;
        return api({ ok: false, error: result.error, message: result.message || '' }, status);
      }
      return api({ ok: true, bot: result.health || await telegramBotHealth(env) });
    }

    if (path === '/api/admin/telegram-bot/test' && request.method === 'POST') {
      const adminId = String(await getSetting(env.DB, 'telegram_admin_id', ''));
      if (!telegramAdminIdLooksValid(adminId)) return api({ ok: false, error: 'invalid_admin_id' }, 400);
      const sent = await telegramSendMessage(env, adminId, '✅ <b>اتصال ربات بلوپرمیوم سالم است.</b>\n\nاین پیام از پنل مدیریت ارسال شد.');
      return api({ ok: !!sent.ok, result: sent }, sent.ok ? 200 : 502);
    }

    if (path === '/api/admin/providers' && request.method === 'POST') {
      const body = await readJson(request);
      if (Object.prototype.hasOwnProperty.call(body, 'tgtools_api_key')) {
        const value = String(body.tgtools_api_key || '').trim();
        if (value) await setProviderSecret(env, 'tgtools_api_key', value);
      }
      if (Object.prototype.hasOwnProperty.call(body, 'blupal_api_key')) {
        const value = String(body.blupal_api_key || '').trim();
        if (value) await setProviderSecret(env, 'blupal_api_key', value);
      }
      return api({ ok: true, providers: await providerHealth(env) });
    }

    if (path === '/api/admin/settings' && request.method === 'PATCH') {
      const body = await readJson(request);
      if (body.profit_percent != null) await setSetting(env.DB, 'profit_percent', clampNumber(body.profit_percent, 0, 500).toString());
      if (body.support != null) await setSetting(env.DB, 'support', String(body.support).slice(0, 120));
      if (body.rounding != null) await setSetting(env.DB, 'rounding', String(Math.max(100, Math.min(100000, Math.round(Number(body.rounding) || 1000)))));
      if (body.tgtools_fulfillment_mode != null) {
        const mode = String(body.tgtools_fulfillment_mode || '').toLowerCase();
        if (!['auto','manual'].includes(mode)) return api({ ok: false, error: 'invalid_fulfillment_mode' }, 400);
        await setSetting(env.DB, 'tgtools_fulfillment_mode', mode);
      }
      if (body.bazaar_rsa_public_key != null) {
        const value = String(body.bazaar_rsa_public_key || '').trim().slice(0, 8192);
        await setSetting(env.DB, 'bazaar_rsa_public_key', value);
      }
      for (const key of ['bazaar_sku_3','bazaar_sku_6','bazaar_sku_12']) {
        if (body[key] != null) {
          const value = String(body[key] || '').trim();
          if (value && !/^[A-Za-z0-9_.-]{1,160}$/.test(value)) return api({ ok: false, error: 'invalid_bazaar_sku' }, 400);
          await setSetting(env.DB, key, value);
        }
      }
      await setSetting(env.DB, 'payment_provider', 'blupal');
      await setSetting(env.DB, 'cafebazaar_enabled', '0');
      await setSetting(env.DB, 'blupal_enabled', '1');
      if (body.new_password != null) {
        const newPassword = String(body.new_password || '');
        if (newPassword.length < 10 || newPassword.length > 128) return api({ ok: false, error: 'weak_password' }, 400);
        await setSetting(env.DB, 'admin_password_hash', await sha256Hex(newPassword));
      }
      return api({ ok: true, settings: await adminSettings(env.DB) });
    }

    const planPatch = path.match(/^\/api\/admin\/plans\/(\d+)$/);
    if (planPatch && request.method === 'PATCH') {
      const body = await readJson(request);
      const id = Number(planPatch[1]);
      const plan = await env.DB.prepare(`SELECT * FROM plans WHERE id=?`).bind(id).first();
      if (!plan) return api({ ok: false, error: 'not_found' }, 404);
      const active = body.active == null ? Number(plan.active) : (body.active ? 1 : 0);
      let manualPrice = plan.manual_price_toman;
      if (Object.prototype.hasOwnProperty.call(body, 'manual_price_toman')) {
        const n = Number(body.manual_price_toman || 0);
        manualPrice = n > 0 ? Math.round(n) : null;
      }
      const price = manualPrice || plan.auto_price_toman || plan.price_toman || 0;
      await env.DB.prepare(`UPDATE plans SET active=?, manual_price_toman=?, price_toman=?, updated_at=? WHERE id=?`)
        .bind(active, manualPrice, price, new Date().toISOString(), id).run();
      return api({ ok: true });
    }

    if (path.startsWith('/api/admin/orders/') && path.endsWith('/approve') && request.method === 'POST') {
      const code = sanitizeToken(path.slice('/api/admin/orders/'.length, -'/approve'.length), 40);
      if (!code) return api({ ok: false, error: 'invalid_order' }, 400);
      const order = await env.DB.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(code).first();
      if (!order) return api({ ok: false, error: 'not_found' }, 404);
      if (order.status !== 'awaiting_approval') {
        return api({ ok: false, error: 'order_not_waiting_approval', status: order.status }, 409);
      }
      const claim = await env.DB.prepare(`UPDATE orders SET status='provider_submitting', provider_error=NULL, updated_at=? WHERE id=? AND status='awaiting_approval'`)
        .bind(new Date().toISOString(), order.id).run();
      if (!claim.meta?.changes) return api({ ok: false, error: 'already_claimed' }, 409);
      const fresh = await env.DB.prepare(`SELECT * FROM orders WHERE id=?`).bind(order.id).first();
      ctx?.waitUntil?.(deliverPremium(env, fresh));
      if (!ctx?.waitUntil) await deliverPremium(env, fresh);
      return api({ ok: true, order_code: code });
    }

    if (path === '/api/admin/sync' && request.method === 'POST') {
      const result = await syncPricing(env);
      return api({ ok: result.ok, result }, result.ok ? 200 : 502);
    }

    if (path === '/api/admin/reconcile' && request.method === 'POST') {
      const result = await reconcileOpenOrders(env, ctx, 30);
      return api({ ok: true, result });
    }
  }

  return api({ ok: false, error: 'not_found' }, 404);
}

async function runMaintenance(env) {
  await syncPricing(env).catch(error => console.error('price sync failed', error));
  await tgMarketMaintenance(env).catch(error => console.error('market cron failed', error));
  await reconcileOpenOrders(env, { waitUntil: p => p }, 40).catch(error => console.error('reconcile failed', error));
}

async function reconcileOpenOrders(env, ctx, limit = 30) {
  const result = await env.DB.prepare(`SELECT * FROM orders WHERE status IN ('awaiting_payment','paid','processing','provider_pending') ORDER BY id ASC LIMIT ?`).bind(limit).all();
  let touched = 0;
  for (const order