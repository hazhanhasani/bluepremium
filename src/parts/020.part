
const TG_TYPES=['stars','gift','smm','catalog','nft','steam'];
const TG_LABELS={stars:'⭐ استارز',gift:'🎁 گیفت تلگرام',smm:'📣 خدمات شبکه‌های اجتماعی',catalog:'🎮 گیفت‌کارت و شارژ بازی',nft:'💎 گیفت NFT',steam:'💻 شارژ استیم'};
const tgCache=new Map();
function tgList(data){
  if(Array.isArray(data))return data;
  for(const v of [data?.packages,data?.items,data?.products,data?.gifts,data?.bundles,
    data?.services,data?.data?.items,data?.data?.products,data?.data?.bundles,
    data?.data?.services,data?.results])
    if(Array.isArray(v))return v;
  return [];
}
function tgTon(row){const n=Number(row?.ton??row?.totalPriceTon??row?.priceTon??row?.price_ton??row?.costTon??row?.quotedTotalTon);return Number.isFinite(n)&&n>0?n:0}
function tgSku(row){const s=String(row?.productId??row?.giftId??row?.serviceId??row?.id??row?.key??'');return /^[a-z0-9:._-]{1,110}$/i.test(s)?s:''}
const tgPriceConfigCache=new Map();
async function tgPrice(env,kind,ton){
  let cfg=tgPriceConfigCache.get(kind);
  if(!cfg||cfg.until<Date.now()){
    const [exchange,percent,rounding]=await Promise.all([
      getSetting(env.DB,'last_ton_toman','0'),
      getSetting(env.DB,'market_'+kind+'_profit','15'),
      getSetting(env.DB,'rounding','1000')
    ]);
    cfg={exchange:Number(exchange),percent:Number(percent),round:Number(rounding)||1000,until:Date.now()+10000};
    tgPriceConfigCache.set(kind,cfg);
  }
  const {exchange,percent,round}=cfg;
  const n=Math.ceil(ton*exchange*(1+percent/100)/round)*round;
  return exchange>0&&ton>0&&percent>=0&&percent<=500&&Number.isSafeInteger(n)&&n>=10000&&n<=1e9?n:0;
}
async function tgProducts(env,kind,options={}){
  if(!TG_TYPES.includes(kind)||['steam','nft'].includes(kind))return [];
  if(String(await getSetting(env.DB,'market_'+kind+'_enabled',kind==='stars'?'1':'0'))!=='1')return [];
  const query=kind==='catalog'?String(options.q||'').trim().slice(0,55):'';
  const page=kind==='catalog'?Math.max(1,Math.min(100,Number(options.page)||1)):1;
  const cacheKey=kind==='catalog'?kind+':'+query.toLowerCase()+':'+page:kind;
  const cached=tgCache.get(cacheKey);if(cached&&cached.exp>Date.now())return cached.items;
  const apiKey=await getProviderSecret(env,'tgtools_api_key');
  const paths=kind==='catalog'?
    ['giftcards','topups'].map(category=>
      '/api/catalog?category='+category+'&pageSize=24&page='+page+
      (query?'&q='+encodeURIComponent(query):'')) :
    [({stars:'/api/purchase/prices',gift:'/api/purchase/gifts?lang=fa',
       smm:'/api/Purchase/smm/bundles?lang=fa'})[kind]];
  const items=[],seen=new Set();
  for(const path of paths){
    const remote=await tgRequest(apiKey,'GET',path,null,kind==='smm');
    if(!remote.ok)continue;
    const rows=tgList(remote.data||{});
    for(const row of rows.slice(0,300)){
      if(kind==='catalog'&&Array.isArray(row.variants)){
        for(const v of row.variants.slice(0,75)){
          const sku=String(v.productId||'');
          if(!/^\d{1,12}$/.test(sku)||seen.has(sku)||v.available===false||v.active===false)continue;
          const ton=tgTon(v),price=await tgPrice(env,kind,ton);
          if(!price)continue;
          seen.add(sku);
          items.push({kind,sku,catalog_key:String(row.catalogKey||''),
            title:bpName(row.name+' · '+String(v.label||v.denomination||v.region||sku),110),
            quantity:1,ton,price_toman:price,
            target_type:row.requiresPlayerId?'player':'none'});
        }
        continue;
      }
      if(row.soldOut===true||row.available===false||row.active===false||
         row.remainingCount===0&&kind==='gift')continue;
      const quantity=kind==='stars'?Number(row.qty??row.quantity??row.amount):
        kind==='smm'?Number(row.quantity??row.count??1):1;
      const sku=kind==='stars'?String(quantity):tgSku(row);
      if(kind==='smm'&&!/^\d{1,10}$/.test(sku))continue;
      const ton=tgTon(row);
      if(!sku||!ton||seen.has(sku)||!Number.isSafeInteger(quantity)||quantity<1||
         kind==='stars'&&(quantity<50||quantity>100000))continue;
      const price=await tgPrice(env,kind,ton);if(!price)continue;
      seen.add(sku);
      items.push({kind,sku,title:kind==='stars'?quantity+' استارز تلگرام':
        bpName(row.titleFa||row.nameFa||row.title||row.name||TG_LABELS[kind],110),
        quantity,ton,price_toman:price,target_type:kind==='smm'?'link':
        kind==='catalog'?(row.requiresPlayerId?'player':'none'):'username',
        ...(kind==='smm'&&row.bundleKey?{bundleKey:String(row.bundleKey)}:{})});
    }
    if(items.length>=150)break;
  }
  tgCache.set(cacheKey,{exp:Date.now()+60000,items:items.slice(0,150)});
  return items.slice(0,150);
}
function tgDestination(kind,value){
  const v=String(value||'').trim();
  if(['stars','gift'].includes(kind))return normalizeUsername(v);
  if(kind==='nft')return tgTonAddress(v);
  if(kind==='steam')return /^[A-Za-z0-9_.-]{3,64}$/.test(v)?v:'';
  if(kind==='catalog')return v.length<=120&&/^[a-z0-9@_.+: -]*$/i.test(v)?v:'';
  if(kind==='smm'){try{const u=new URL(v);return u.protocol==='https:'&&v.length<=320?v:''}catch(e){return ''}}
  return '';
}
function tgPublic(order,token=''){
  const obj={code:order.order_code,kind:order.kind,title:order.title,quantity:order.quantity,price_toman:order.price_toman,
    status:order.status,target:order.target,delivery_code:order.status==='delivered'?order.delivery_code:null};
  if(token)obj.token=token;
  if(order.status==='awaiting_payment'&&/^\d{16}$/.test(order.blupal_card_number||'')&&Number(order.blupal_final_amount_rial)>0)
    obj.payment_instructions={type:'card_transfer',card_number:order.blupal_card_number,amount_rial:order.blupal_final_amount_rial};
  return obj;
}
async function tgCreateOrder(env,input,user,ctx){
  const kind=String(input.kind||''),sku=String(input.sku||''),wallet=input.payment==='wallet';
  if(!TG_TYPES.includes(kind))return {ok:false,error:'product_unavailable',http:409};
  if(wallet&&!user)return {ok:false,error:'telegram_auth_required',http:401};
  if(user?.blocked)return {ok:false,error:'account_blocked',http:403};
  const required=await env.DB.prepare('SELECT COUNT(*) AS count FROM bp_forced_channels WHERE enabled=1').first();
  if(Number(required?.count||0)){
    if(!user)return {ok:false,error:'telegram_auth_required',http:401};
    if((await bpMissingChannels(env,user.telegram_id)).length)return {ok:false,error:'join_required',http:403};
  }
  const item=kind==='catalog'&&input.catalog_key?
    await tgCatalogLiveQuote(env,sku,input.catalog_key):await tgQuoteBySku(env,kind,sku);
  if(!item)return {ok:false,error:'price_unavailable',http:409};
  const customerQuoted=Number(input.expected_price_toman||0);
  if(customerQuoted&&(!Number.isSafeInteger(customerQuoted)||customerQuoted!==item.price_toman))
    return {ok:false,error:'price_changed',http:409};
  const dest=tgDestination(kind,input.target);
  if(!dest&&item.target_type!=='none')return {ok:false,error:'invalid_target',http:400};
  if(item.target_type==='none'&&dest)return {ok:false,error:'invalid_target',http:400};
  if(['stars','gift'].includes(kind)){
    const key=await getProviderSecret(env,'tgtools_api_key');
    if(!key)return {ok:false,error:'provider_not_configured',http:503};
    const lookup=await tgRequest(key,'GET','/api/purchase/user/'+encodeURIComponent(dest));
    if(!lookup.ok||lookup.data?.found===false)return {ok:false,error:'telegram_user_not_found',http:422};
  }
  const code='BP-'+crypto.randomUUID().replaceAll('-','').slice(0,14).toUpperCase();
  const token=randomToken(24),hash=await sha256Hex(token),now=new Date().toISOString(),userId=user?.telegram_id||null;
  const status=wallet?'paid':'creating_payment';
  const sql="INSERT INTO bp_market_orders(order_code,public_token_hash,telegram_user_id,kind,sku,title,target,quantity,price_toman,quoted_ton,provider_payload,payment_provider,status,created_at,updated_at,paid_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";
  const fields=[code,hash,userId,kind,sku,item.title,dest,item.quantity,item.price_toman,item.ton,
    JSON.stringify({sku,kind,catalog_key:item.catalog_key||null,quantity:item.quantity,target:dest,requires_delivery_code:kind==='catalog'&&item.target_type==='none',serviceId:kind==='smm'?Number(sku):null,bundleKey:item.bundleKey||null}),wallet?'wallet':'blupal',status,now,now,wallet?now:null];
  if(wallet){
    const balance=await env.DB.prepare('SELECT balance_toman FROM bp_wallet_balances WHERE telegram_id=?').bind(userId).first();
    if(Number(balance?.balance_toman||0)<item.price_toman)return {ok:false,error:'insufficient_wallet_balance',http:409};
    const q="INSERT INTO bp_wallet_ledger(telegram_id,delta_toman,kind,actor,reason,order_code,idempotency_key) "+
      "SELECT ?,?,'purchase','system',?,?,? WHERE (SELECT balance_toman FROM bp_wallet_balances WHERE telegram_id=?)>=?";
    const conditional=sql.replace("VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
      "SELECT ?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,? WHERE EXISTS(SELECT 1 FROM bp_wallet_ledger WHERE idempotency_key=?)");
    try{
      const writes=await env.DB.batch([
        env.DB.prepare(q).bind(userId,-item.price_toman,item.title,code,'purchase:'+code,userId,item.price_toman),
        env.DB.prepare(conditional).bind(...fields,'purchase:'+code)
      ]);
      if(!writes[0].meta?.changes||!writes[1].meta?.changes)return {ok:false,error:'insufficient_wallet_balance',http:409};
    }catch(e){return {ok:false,error:'wallet_purchase_failed',http:409}}
  }else{
    const key=await getProviderSecret(env,'blupal_api_key');
    if(!key||String(await getSetting(env.DB,'blupal_enabled','1'))!=='1')return {ok:false,error:'payment_not_configured',http:503};
    await env.DB.prepare(sql).bind(...fields).run();
    const amount=item.price_toman*10;
    const invoice=await blupalRequest(key,'POST','/v1/invoices/create',{amount});
    let details=blupalInvoiceFields(invoice.raw||invoice.data||{},amount);
    if(invoice.ok&&details.invoice_id&&(!details.card_number||!details.final_amount_rial)){
      const fresh=await blupalRequest(key,'GET','/v1/invoices/'+encodeURIComponent(details.invoice_id));
      if(fresh.ok){const p=blupalInvoiceFields(fresh.raw||fresh.data||{},amount);details={...details,...p,invoice_id:details.invoice_id,
        payment_link:p.payment_link||details.payment_link,card_number:p.card_number||details.card_number,
        final_amount_rial:p.final_amount_rial||details.final_amount_rial};}
    }
    if(invoice.ok&&details.invoice_id&&(!details.card_number||!details.final_amount_rial)&&details.payment_link){
      const hosted=await blupalHostedPaymentDetails(details.payment_link,amount,details.final_amount_rial);
      if(hosted)details={...details,...hosted};
    }
    if(!invoice.ok||!details.invoice_id||!/^\d{16}$/.test(details.card_number||'')||
      !blupalAmountIsReasonable(amount,details.final_amount_rial)){
      await env.DB.prepare("UPDATE bp_market_orders SET status='payment_error',updated_at=? WHERE order_code=?")
        .bind(new Date().toISOString(),code).run();
      return {ok:false,error:'payment_details_unavailable',http:502};
    }
    await env.DB.prepare("UPDATE bp_market_orders SET status='awaiting_payment',blupal_invoice_id=?,payment_url=?,blupal_card_number=?,blupal_final_amount_rial=?,updated_at=? WHERE order_code=?")
      .bind(details.invoice_id,details.payment_link||null,details.card_number,details.final_amount_rial,new Date().toISOString(),code).run();
  }
  const order=await env.DB.prepare('SELECT * FROM bp_market_orders WHERE order_code=?').bind(code).first();
  if(wallet){
    const work=tgReconcileOrder(env,order);
    if(ctx?.waitUntil)ctx.waitUntil(work);else await work;
  }
  return {ok:true,order:tgPublic(order,token)};
}
async function tgMarketNotify(env,order){
  if(!order.telegram_user_id)return;
  const text='✅ سفارش '+telegramEscapeHtml(order.title)+' تحویل شد.\nکد: <code>'+order.order_code+'</code>'+
    (order.delivery_code?'\nکد تحویل: <code>'+telegramEscapeHtml(order.delivery_code)+'</code>':'');
  await telegramSendMessage(env,order.telegram_user_id,text).catch(()=>{});
}
async function tgMarketDeliver(env,order){
  if(order.status!=='paid')return;
  const preflight=await tgPreflightDelivery(env,order);
  if(!preflight.ok){
    await tgStopBeforeProvider(env,order,preflight.error);
    return;
  }
  // Validate everything before claiming/submitting. A missing key or invalid
  // payload must never strand a wallet debit in provider_submitting.
  const apiKey=await getProviderSecret(env,'tgtools_api_key');
  if(!apiKey){await tgStopBeforeProvider(env,order,'provider_not_configured');return}
  const action=tgFulfillmentInput(order);
  if(!action||!action.path||!action.body){
    await tgStopBeforeProvider(env,order,'unsupported_product');return;
  }
  const claimed=await env.DB.prepare("UPDATE bp_market_orders SET status='provider_submitting',updated_at=? WHERE id=? AND status='paid'")
    .bind(new Date().toISOString(),order.id).run();
  if(!claimed.meta?.changes)return;
  const remote=await tgRequest(apiKey,'POST',action.path,action.body);
  const data=remote.data||{},tx=String(data.transactionId??data.orderId??data.purchaseId??data.id??'');
  if(!remote.ok){
    const uncertain=remote.http_status===0||remote.http_status>=500||remote.http_status===409;
    const error=safeProviderMessage(remote.message||'provider_failed');
    await env.DB.prepare("UPDATE bp_market_orders SET status=?,provider_error=?,updated_at=? WHERE id=?")
      .bind(uncertain?'provider_uncertain':'failed',error,new Date().toISOString(),order.id).run();
    if(!uncertain&&order.kind==='gift'&&/sold out/i.test(error))
      await tgRefundSoldOutGift(env,{...order,status:'failed',provider_error:error});
    return;
  }
  if(!/^\d{1,20}$/.test(tx)){
    await env.DB.prepare("UPDATE bp_market_orders SET status='provider_uncertain',provider_error='missing_provider_id',updated_at=? WHERE id=?")
      .bind(new Date().toISOString(),order.id).run();return;
  }
  const state=tgState(data);
  const requiresCode=order.kind==='catalog'&&!order.target;
  const delivery=order.kind==='catalog'?String(data.deliveryCode||data.code||'').slice(0,300):null;
  const status=state==='completed'&&(!requiresCode||delivery)?'delivered':
    state==='failed'?'failed':'provider_pending';
  const changed=await env.DB.prepare("UPDATE bp_market_orders SET status=?,provider_transaction_id=?,delivery_code=?,updated_at=?,delivered_at=? WHERE id=?")
    .bind(status,tx,delivery,new Date().toISOString(),status==='delivered'?new Date().toISOString():null,order.id).run();
  if(changed.meta?.changes&&status==='delivered')await tgMarketNotify(env,{...order,status,delivery_code:delivery});
}
async function tgReconcileOrder(env,order){
  if(!order)return;
  if(order.status==='awaiting_payment'){
    const key=await getProviderSecret(env,'blupal_api_key');
    if(!key||!order.blupal_invoice_id)return;
    const remote=await blupalRequest(key,'GET','/v1/invoices/'+encodeURIComponent(order.blupal_invoice_id));
    if(!remote.ok)return;
    const detail=blupalInvoiceFields(remote.raw||remote.data||{},order.price_toman*10);
    if(detail.status!=='PAID')return;
    // Require a real invoice amount from the provider; never accept the expected fallback.
    const actual=Number(remote.raw?.data?.amount??remote.raw?.amount??remote.data?.amount??0);
    if(!Number.isSafeInteger(actual)||actual!==order.price_toman*10)return;
    const update=await env.DB.prepare("UPDATE bp_market_orders SET status='paid',paid_at=?,updated_at=? WHERE id=? AND status='awaiting_payment'")
      .bind(new Date().toISOString(),new Date().toISOString(),order.id).run();
    if(!update.meta?.changes)return;
    order={...order,status:'paid'};
  }
  if(order.status==='paid'){await tgMarketDeliver(env,order);return}
  if(order.status==='provider_pending'&&order.provider_transaction_id){
    const key=await getProviderSecret(env,'tgtools_api_key');if(!key)return;
    const route=tgOrderDetailRoute(order);
    if(!route)return;
    const remote=await tgRequest(key,'GET',route);
    if(!remote.ok)return;
    const state=tgState(remote.data||{});
    if(state!=='completed'&&state!=='failed')return;
    const requiresCode=order.kind==='catalog'&&!order.target;
    const delivery=order.kind==='catalog'?String(remote.data?.deliveryCode||remote.data?.code||'').slice(0,300):null;
    if(state==='completed'&&requiresCode&&!delivery)return;
    const status=state==='completed'?'delivered':'failed';
    const change=await env.DB.prepare("UPDATE bp_market_orders SET status=?,delivery_code=?,updated_at=?,delivered_at=? WHERE id=? AND status='provider_pending'")
      .bind(status,delivery,new Date().toISOString(),status==='delivered'?new Date().toISOString():null,order.id).run();
    if(change.meta?.changes&&status==='delivered')await tgMarketNotify(env,{...order,status,delivery_code:delivery});
  }
}
async function tgMarketMaintenance(env){
  const r=await env.DB.prepare("SELECT * FROM bp_market_orders WHERE status IN ('awaiting_payment','paid','provider_pending') ORDER BY id ASC LIMIT 25").all();
  for(const row of r.results||[])try{await tgReconcileOrder(env,row)}catch(e){console.error('market_cron',row.order_code,String(e?.message||e))}
}
