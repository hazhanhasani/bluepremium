const BRAND = 'Blue Premium';
const BRAND_FA = 'بلوپرمیوم';
const TG_BASE = 'https://api.tg-tools.shop';
const BLUPAL_BASE = 'https://blupal.top/api';
const NOBITEX_ORDERBOOK = 'https://apiv2.nobitex.ir/v3/orderbook/GRAMIRT';
const ALLOWED_MONTHS = [3, 6, 12];
const enc = new TextEncoder();
const dec = new TextDecoder();

export default {
  async fetch(request, env, ctx) {
    try {
      return await route(request, env, ctx);
    } catch (error) {
      console.error('Unhandled error', error);
      return json({ ok: false, error: 'internal_error' }, 500);
    }
  },

  async scheduled(_event, env, ctx) {
    ctx.waitUntil(runMaintenance(env));
  },
};

async function route(request, env, ctx) {
  const url = new URL(request.url);
  const path = url.pathname;

  if (request.method === 'OPTIONS') return cors(new Response(null, { status: 204 }));
  const marketFeature = await tgMarketApi(request, env, url, ctx);
  if (marketFeature) return marketFeature;
  const bpFeature = await bpFeatureApi(request, env, url, ctx);
  if (bpFeature) return bpFeature;


  if (path === '/' && request.method === 'GET') return html(bpDecorateExperience(tgDecorateStore(bpDecorateStoreHtml(storeHtmlV4()))));
  if (path === '/admin' && request.method === 'GET') return html(tgDecorateAdmin(bpDecorateAdminHtml(adminHtmlV2())));
  if (path === '/manifest.webmanifest' && request.method === 'GET') {
    return new Response(JSON.stringify({
      name: `${BRAND_FA} | ${BRAND}`,
      short_name: BRAND_FA,
      start_url: '/',
      scope: '/',
      display: 'standalone',
      background_color: '#06101f',
      theme_color: '#0a67ff',
      lang: 'fa',
      dir: 'rtl',
      icons: [
        { src: '/brandmark.webp?v=8', sizes: '256x256', type: 'image/webp', purpose: 'any maskable' },
      ],
    }), { headers: { 'content-type': 'application/manifest+json; charset=utf-8', 'cache-control': 'public,max-age=3600' } });
  }
  if (path === '/brandmark.webp' && request.method === 'GET') return brandmarkWebpResponse();
  if (path === '/icon.svg' && request.method === 'GET') return svgIcon();
  if (path === '/sw.js' && request.method === 'GET') {
    return new Response(serviceWorkerJs(), { headers: { 'content-type': 'application/javascript; charset=utf-8', 'cache-control': 'no-cache' } });
  }
  if (path === '/health' && request.method === 'GET') return json({ ok: true, service: 'bluepremium', version: '1.8.0' });

  if (path === '/api/build/android-signing' && request.method === 'GET') {
    const claims = await verifyGitHubOidc(request);
    if (!claims) return json({ ok: false, error: 'unauthorized' }, 401);
    const [keystoreBase64, storePassword, keyPassword, fingerprint] = await Promise.all([
      getSetting(env.DB, 'internal_android_keystore_b64', ''),
      getSetting(env.DB, 'internal_android_store_password', ''),
      getSetting(env.DB, 'internal_android_key_password', ''),
      getSetting(env.DB, 'internal_android_cert_sha256', ''),
    ]);
    if (!keystoreBase64 || !storePassword || !keyPassword || !fingerprint) {
      return json({ ok: false, error: 'signing_material_unavailable' }, 503);
    }
    return json({
      ok: true,
      keystore_base64: keystoreBase64,
      store_password: storePassword,
      key_alias: 'bluepremium',
      key_password: keyPassword,
      cert_sha256: fingerprint,
    });
  }

  if (path === '/api/config' && request.method === 'GET') {
    const settings = await publicSettings(env.DB);
    const paymentMethod = settings.payment_provider || 'blupal';
    const bazaarConfigured = settings.cafebazaar_enabled === '1' &&
      !!settings.bazaar_rsa_public_key &&
      !!settings.bazaar_sku_3 && !!settings.bazaar_sku_6 && !!settings.bazaar_sku_12;
    return api({
      ok: true,
      brand: BRAND,
      brand_fa: BRAND_FA,
      support: settings.support || '',
      currency: 'TOMAN',
      payment_method: paymentMethod === 'blupal' ? 'card_transfer' : paymentMethod,
      card_payment_enabled: paymentMethod === 'blupal' && settings.blupal_enabled === '1',
      cafebazaar_enabled: settings.cafebazaar_enabled === '1',
      cafebazaar_configured: bazaarConfigured,
      cafebazaar: bazaarConfigured ? {
        rsa_public_key: settings.bazaar_rsa_public_key,
        products: {
          3: settings.bazaar_sku_3,
          6: settings.bazaar_sku_6,
          12: settings.bazaar_sku_12,
        },
      } : null,
    });
  }

  if (path === '/api/plans' && request.method === 'GET') {
    const result = await env.DB.prepare(`SELECT id, months, title, price_toman, auto_price_toman, manual_price_toman, wholesale_ton, active, updated_at FROM plans WHERE active = 1 ORDER BY months`).all();
    const plans = (result.results || []).map(p => ({
      id: p.id,
      months: Number(p.months),
      title: p.title,
      price_toman: Number(p.manual_price_toman || p.price_toman || p.auto_price_toman || 0),
      wholesale_ton: p.wholesale_ton == null ? null : Number(p.wholesale_ton),
      updated_at: p.updated_at,
    })).filter(p => p.price_toman > 0);
    return api({ ok: true, plans });
  }

  if (path === '/api/telegram/lookup' && request.method === 'GET') {
    const username = normalizeUsername(url.searchParams.get('username'));
    if (!username) return api({ ok: false, error: 'invalid_username' }, 400);
    const tgKey = await getProviderSecret(env, 'tgtools_api_key');
    if (!tgKey) return api({ ok: false, error: 'provider_not_configured' }, 503);
    const lookup = await tgRequest(tgKey, 'GET', `/api/purchase/user/${encodeURIComponent(username)}`);
    if (!lookup.ok) return api({ ok: false, error: 'lookup_failed', message: safeProviderMessage(lookup.message) }, 502);
    const profile = lookup.data || {};
    return api({
      ok: true,
      username,
      found: profile.found !== false,
      premium_eligible: profile.premiumEligible !== false,
      display_name: String(profile.name || profile.displayName || profile.firstName || username).slice(0, 80),
    });
  }

  if (path === '/api/orders' && request.method === 'POST') {
    const body = await readJson(request);
    const planId = Number(body.plan_id || 0);
    const username = normalizeUsername(body.username);
    const claimedDevice = sanitizeToken(body.device_id, 128) || 'web';
    const deviceId = claimedDevice.startsWith('tg:') ? 'web' : claimedDevice;
    if (!planId || !username) return api({ ok: false, error: 'invalid_request' }, 400);

    const customer = request.headers.has('X-Telegram-Init-Data')
      ? await bpValidateTelegramInitData(env, request) : null;
    if (request.headers.has('X-Telegram-Init-Data') && !customer)
      return api({ ok: false, error: 'telegram_auth_required' }, 401);
    if (customer?.blocked) return api({ ok: false, error: 'account_blocked' }, 403);
    const mandatory = await env.DB.prepare("SELECT COUNT(*) AS total FROM bp_forced_channels WHERE enabled=1").first();
    if (Number(mandatory?.total || 0)) {
      if (!customer) return api({ ok:false,error:'telegram_auth_required' },401);
      const missing = await bpMissingChannels(env,customer.telegram_id);
      if (missing.length) return api({ok:false,error:'join_required',channels:missing},403);
    }


    const plan = await env.DB.prepare(`SELECT * FROM plans WHERE id = ? AND active = 1`).bind(planId).first();
    if (!plan) return api({ ok: false, error: 'plan_not_found' }, 404);
    const months = Number(plan.months);
    if (!ALLOWED_MONTHS.includes(months)) return api({ ok: false, error: 'invalid_plan' }, 400);
    const priceToman = Number(plan.manual_price_toman || plan.price_toman || plan.auto_price_toman || 0);
    if (!Number.isFinite(priceToman) || priceToman < 10000) return api({ ok: false, error: 'plan_unavailable' }, 409);

    const tgKey = await getProviderSecret(env, 'tgtools_api_key');
    if (!tgKey) return api({ ok: false, error: 'provider_not_configured' }, 503);
    const lookup = await tgRequest(tgKey, 'GET', `/api/purchase/user/${encodeURIComponent(username)}`);
    if (!lookup.ok) return api({ ok: false, error: 'telegram_lookup_failed', message: safeProviderMessage(lookup.message) }, 502);
    const profile = lookup.data || {};
    if (profile.found === false) return api({ ok: false, error: 'telegram_user_not_found' }, 422);
    if (profile.premiumEligible === false) return api({ ok: false, error: 'not_premium_eligible' }, 422);

    const paymentProvider = String(await getSetting(env.DB, 'payment_provider', 'blupal'));
    const bluePalEnabled = String(await getSetting(env.DB, 'blupal_enabled', '1')) === '1';
    const blupalKey = await getProviderSecret(env, 'blupal_api_key');
    if (paymentProvider !== 'blupal' || !bluePalEnabled || !blupalKey) {
      return api({ ok: false, error: 'payment_not_configured' }, 503);
    }

    const orderCode = `BP-${crypto.randomUUID().replaceAll('-', '').slice(0, 14).toUpperCase()}`;
    const publicToken = randomToken(24);
    const publicTokenHash = await sha256Hex(publicToken);
    const now = new Date().toISOString();

    await env.DB.prepare(`
      INSERT INTO orders(
        order_code, public_token_hash, plan_id, months, username, price_toman, status,
        device_id, payment_provider, created_at, updated_at, telegram_user_id
      )
      VALUES (?, ?, ?, ?, ?, ?, 'creating_payment', ?, 'blupal', ?, ?, ?)
    `).bind(
      orderCode,
      publicTokenHash,
      planId,
      months,
      username,
      Math.round(priceToman),
      deviceId,
      now,
      now,
      customer?.telegram_id || null
    ).run();

    const expectedRial = Math.round(priceToman) * 10;
    const invoice = await blupalRequest(blupalKey, 'POST', '/v1/invoices/create', {
      amount: expectedRial,
    });
    let details = blupalInvoiceFields(invoice.raw || invoice.data || {}, expectedRial);

    if (!invoice.ok || !details.invoice_id) {
      await env.DB.prepare(`UPDATE orders SET status='payment_error', provider_error=?, updated_at=? WHERE order_code=?`)
        .bind(safeProviderMessage(invoice.message || 'invoice_create_failed'), new Date().toISOString(), orderCode).run();
      return api({ ok: false, error: 'invoice_create_failed' }, 502);
    }

    if (!details.card_number || !details.final_amount_rial) {
      const freshInvoice = await blupalRequest(blupalKey, 'GET', `/v1/invoices/${encodeURIComponent(details.invoice_id)}`);
      if (freshInvoice.ok) {
        const refreshed = blupalInvoiceFields(freshInvoice.raw || freshInvoice.data || {}, expectedRial);
        details = {
          ...details,
          ...refreshed,
          invoice_id: refreshed.invoice_id || details.invoice_id,
          payment_link: refreshed.payment_link || details.payment_link,
          card_number: refreshed.card_number || details.card_number,
          final_amount_rial: refreshed.final_amount_rial || details.final_amount_rial,
          expires_at: refreshed.expires_at || details.expires_at,
        };
      }
    }

    if (details.amount_rial && details.amount_rial !== expectedRial) {
      await env.DB.prepare(`UPDATE orders SET status='payment_error', provider_error='invoice_amount_mismatch', updated_at=? WHERE order_code=?`)
        .bind(new Date().toISOString(), orderCode).run();
      return api({ ok: false, error: 'invoice_amount_mismatch' }, 502);
    }

    if ((!details.card_number || !details.final_amount_rial) && details.payment_link) {
      const hosted = await blupalHostedPaymentDetails(details.payment_link, expectedRial, details.final_amount_rial);
      if (hosted) details = { ...details, ...hosted };
    }

    if (
      !details.card_number ||
      details.card_number.length !== 16 ||
      !details.final_amount_rial ||
      !blupalAmountIsReasonable(expectedRial, details.final_amount_rial)
    ) {
      await env.DB.prepare(`UPDATE orders SET status='payment_error', provider_error='payment_details_unavailable', updated_at=? WHERE order_code=?`)
        .bind(new Date().toISOString(), orderCode).run();
      return api({ ok: false, error: 'payment_details_unavailable' }, 502);
    }

    await env.DB.prepare(`
      UPDATE orders
      SET status='awaiting_payment', blupal_invoice_id=?, payment_url=?,
          blupal_final_amount_rial=?, blupal_card_number=?, blupal_expires_at=?, updated_at=?
      WHERE order_code=? AND status='creating_payment'
    `).bind(
      details.invoice_id,
      details.payment_link || null,
      details.final_amount_rial,
      details.card_number,
      details.expires_at || null,
      new Date().toISOString(),
      orderCode
    ).run();

    const created = await env.DB.prepare(`SELECT * FROM orders WHERE order_code=? LIMIT 1`).bind(orderCode).first();
    const publicCreated = publicOrder(created);
    publicCreated.token = publicToken;
    return api({
      ok: true,
      payment_method: 'card_transfer',
      order: publicCreated,
      payment_instructions: publicCreated.payment_instructions,
    }, 201);
  }

