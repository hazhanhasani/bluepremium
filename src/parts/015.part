
function callbackField(source, names) {
  for (const name of names) {
    const value = source?.[name];
    if (value != null && String(value).trim()) return String(value).trim();
  }
  return '';
}

async function readLoosePayload(request, maxBytes = 65536) {
  if (request.method === 'GET' || request.method === 'HEAD') return {};
  const len = Number(request.headers.get('content-length') || 0);
  if (len > maxBytes) return {};
  const raw = await request.text();
  if (!raw || raw.length > maxBytes) return {};
  const type = String(request.headers.get('content-type') || '').toLowerCase();
  try {
    if (type.includes('application/json')) return JSON.parse(raw);
    if (type.includes('application/x-www-form-urlencoded')) return Object.fromEntries(new URLSearchParams(raw));
    return JSON.parse(raw);
  } catch (_) {
    try { return Object.fromEntries(new URLSearchParams(raw)); } catch (_) { return {}; }
  }
}

function blupalCallbackResponse(order, state = 'pending', status = 200) {
  const safe = value => String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
  })[ch]);

  const isSuccess = state === 'success';
  const isPending = state === 'pending';
  const title = isSuccess ? 'پرداخت با موفقیت تأیید شد' : (isPending ? 'پرداخت در حال بررسی است' : 'پرداخت نیاز به بررسی دارد');
  const detail = isSuccess
    ? 'پرداخت از API بلوپال دوباره بررسی شد. سفارش شما برای فعال‌سازی تلگرام پرمیوم ثبت شده است.'
    : (isPending
      ? 'هنوز وضعیت PAID از بلوپال دریافت نشده است. چند لحظه بعد دوباره بررسی می‌شود.'
      : 'وضعیت پرداخت یا مبلغ با سفارش مطابقت ندارد. لطفاً با پشتیبانی در ارتباط باشید.');

  const statusLabel = order ? customerStatusMessage(order.status) : 'فاکتور پیدا نشد';
  const code = order?.order_code || '';
  const invoice = order?.blupal_invoice_id || '';
  const amount = order?.price_toman ? new Intl.NumberFormat('fa-IR').format(Number(order.price_toman)) + ' تومان' : '';
  const icon = isSuccess
    ? '<svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>'
    : (isPending
      ? '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'
      : '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>');

  const html = `<!doctype html><html lang="fa" dir="rtl"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#06101f"><title>${safe(title)} | ${BRAND_FA}</title>
<style>
:root{color-scheme:dark;--bg:#050a12;--card:#0c1727;--line:rgba(136,181,235,.14);--text:#f6fbff;--muted:#8298b1;--blue:#338cff;--green:#43d99e;--red:#ff7886}
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:18px;font-family:Tahoma,"Segoe UI",sans-serif;color:var(--text);background:radial-gradient(700px 380px at 90% -5%,rgba(47,134,255,.26),transparent 65%),linear-gradient(180deg,#081220,#050a12)}
.wrap{width:min(520px,100%)}.brand{display:flex;align-items:center;justify-content:center;gap:9px;margin-bottom:14px;color:#a8bbd0;font-size:11px}.brand img{width:36px;height:36px;border-radius:12px;object-fit:cover}
.card{border:1px solid var(--line);background:linear-gradient(155deg,rgba(15,29,48,.97),rgba(7,14,24,.98));border-radius:27px;padding:25px;box-shadow:0 28px 75px rgba(0,24,70,.38)}
.icon{width:72px;height:72px;margin:auto;border-radius:50%;display:grid;place-items:center;background:${isSuccess?'rgba(67,217,158,.09)':isPending?'rgba(51,140,255,.10)':'rgba(255,120,134,.09)'};color:${isSuccess?'var(--green)':isPending?'#78bcff':'var(--red)'};border:1px solid currentColor}.icon svg{width:34px;height:34px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
h1{text-align:center;font-size:20px;margin:18px 0 7px}.desc{text-align:center;color:var(--muted);font-size:11px;line-height:2;margin:0}.rows{margin-top:19px;border-top:1px solid var(--line)}
.row{display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px dashed var(--line);font-size:9px;color:#7288a2}.row b{color:#e8f2ff;direction:ltr;text-align:left;word-break:break-all}
.actions{display:grid;gap:8px;margin-top:18px}.btn{min-height:48px;border-radius:15px;display:flex;align-items:center;justify-content:center;text-decoration:none;font:800 10px Tahoma}.primary{background:linear-gradient(100deg,#176ff5,#2aa9ff);color:#fff}.secondary{border:1px solid var(--line);background:#0d1a2c;color:#cfe0f4}
.note{text-align:center;color:#60758f;font-size:8px;margin-top:13px;line-height:1.8}
</style></head><body><main class="wrap">
<div class="brand"><img src="/brandmark.webp?v=6" alt=""><b>${BRAND_FA}</b></div>
<section class="card"><div class="icon">${icon}</div><h1>${safe(title)}</h1><p class="desc">${safe(detail)}</p>
<div class="rows">
${code?'<div class="row"><span>کد سفارش</span><b>'+safe(code)+'</b></div>':''}
${invoice?'<div class="row"><span>شناسه فاکتور</span><b>'+safe(invoice)+'</b></div>':''}
${amount?'<div class="row"><span>مبلغ</span><b>'+safe(amount)+'</b></div>':''}
<div class="row"><span>وضعیت سفارش</span><b>${safe(statusLabel)}</b></div>
</div>
<div class="actions"><a class="btn primary" href="bluepremium://payment-return">بازگشت به اپ بلوپرمیوم</a><a class="btn secondary" href="/">بازگشت به فروشگاه</a></div>
<div class="note">وضعیت پرداخت فقط با استعلام مستقیم از API بلوپال تأیید می‌شود.</div>
</section></main></body></html>`;

  return new Response(html, {
    status,
    headers: {
      'content-type':'text/html; charset=utf-8',
      'cache-control':'no-store, no-cache, must-revalidate, max-age=0',
      'pragma':'no-cache',
      'x-content-type-options':'nosniff',
      'referrer-policy':'no-referrer',
      'content-security-policy':"default-src 'self'; img-src 'self' data:; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'"
    }
  });
}
