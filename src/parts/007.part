></div>'}}
  function render(){if(!plans.length){el('plans').innerHTML='<div class="plan"><div class="sub">فعلاً پلن فعالی وجود ندارد.</div></div>';return}selected=selected||plans[0].id;el('plans').innerHTML=plans.map(p=>'<div class="plan '+(p.id===selected?'active':'')+'" data-id="'+p.id+'"><div class="months">'+p.months+' ماهه</div><div class="sub">Telegram Premium</div><div class="price">'+money(p.price_toman)+' <small>نهایی</small></div></div>').join('');document.querySelectorAll('.plan').forEach(x=>x.onclick=()=>{selected=Number(x.dataset.id);render()})}
  el('buy').onclick=async()=>{const username=el('username').value.trim().replace(/^@+/,'');if(!/^[A-Za-z0-9_]{5,32}$/.test(username)){show('یوزرنیم معتبر نیست.');return}el('buy').disabled=true;show('در حال بررسی حساب و ساخت فاکتور...');try{let did=localStorage.getItem('bp_device');if(!did){did=crypto.randomUUID();localStorage.setItem('bp_device',did)}const r=await fetch('/api/orders',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({plan_id:selected,username,device_id:did})});const d=await r.json();if(!d.ok){show(errorText(d.error));return}current={code:d.order.code,token:d.order.token};localStorage.setItem('bp_order',JSON.stringify(current));showOrder(d.order,d.payment_url);setTimeout(()=>location.href=d.payment_url,700)}catch(e){show('خطا در ارتباط با سرور. دوباره تلاش کن.')}finally{el('buy').disabled=false}}
  async function check(){if(!current)return;try{const d=await fetch('/api/orders/'+encodeURIComponent(current.code)+'/check?token='+encodeURIComponent(current.token)).then(r=>r.json());if(d.ok){showOrder(d.order,d.order.payment_url);if(!['delivered','failed','payment_mismatch'].includes(d.order.status))setTimeout(check,5000)}}catch(e){}}
  function showOrder(o,pay){let extra=pay?'<a class="btn pay" href="'+pay+'">رفتن به صفحه پرداخت</a>':'';el('status').className='status show';el('status').innerHTML='<strong>'+o.message+'</strong><div class="meta">کد سفارش: '+o.code+'<br>مقصد: @'+o.username+'<br>پلن: '+o.months+' ماهه<br>مبلغ: '+money(o.price_toman)+'</div>'+extra}
  function show(t){el('status').className='status show';el('status').innerHTML='<strong>'+t+'</strong>'}
  function errorText(e){return ({invalid_username:'یوزرنیم معتبر نیست.',telegram_user_not_found:'این یوزرنیم در تلگرام پیدا نشد.',not_premium_eligible:'این حساب در حال حاضر امکان دریافت پرمیوم ندارد.',payment_not_configured:'درگاه پرداخت هنوز توسط مدیر فعال نشده است.',plan_unavailable:'این پلن فعلاً قابل خرید نیست.'})[e]||'ثبت سفارش انجام نشد. دوباره تلاش کن.'}
  if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{});load();
  </script></body></html>`;
}

function adminHtml() {
  return `<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Blue Premium Admin</title><style>body{margin:0;background:#07101d;color:#eef5ff;font-family:Tahoma,"Segoe UI"}.w{max-width:920px;margin:auto;padding:24px}.c{background:#0d1828;border:1px solid #20314b;border-radius:20px;padding:18px;margin-bottom:14px}input{width:100%;box-sizing:border-box;background:#07101d;color:#fff;border:1px solid #263b58;border-radius:12px;padding:13px;margin:7px 0}button{border:0;border-radius:12px;padding:12px 16px;background:#1678ff;color:#fff;font-weight:700;cursor:pointer}.g{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.muted{color:#91a4bd;font-size:12px;line-height:1.9}.ok{color:#46df9a}.bad{color:#ff7777}table{width:100%;border-collapse:collapse;font-size:12px}td,th{padding:9px;border-bottom:1px solid #1b2a40;text-align:right}@media(max-width:680px){.g{grid-template-columns:1fr}}</style></head><body><main class="w"><h2>مدیریت ${BRAND_FA}</h2><section id="login" class="c"><h3>ورود مدیر</h3><input id="pass" type="password" placeholder="Admin password"><button onclick="login()">ورود</button><div id="loginmsg" class="muted"></div></section><div id="panel" style="display:none"><div class="g"><section class="c"><h3>TG Tools</h3><div id="tg" class="muted"></div><input id="tgkey" type="password" placeholder="TG Tools API Key"><button onclick="saveProviders('tg')">ذخیره کلید</button></section><section class="c"><h3>BluePal</h3><div id="bp" class="muted"></div><input id="bpkey" type="password" placeholder="BluePal API Key"><button onclick="saveProviders('bp')">ذخیره کلید</button></section></div><section class="c"><h3>قیمت‌گذاری</h3><div class="g"><div><label>درصد سود</label><input id="profit" type="number" min="0" max="500"></div><div><label>گرد کردن قیمت</label><input id="rounding" type="number" min="100"></div></div><input id="support" placeholder="Support username / contact"><input id="newpass" type="password" placeholder="رمز جدید مدیر (اختیاری، حداقل ۱۰ کاراکتر)"><button onclick="saveSettings()">ذخیره تنظیمات</button> <button onclick="sync()">همگام‌سازی قیمت</button></section><section class="c"><h3>پلن‌ها</h3><div id="plans"></div></section><section class="c"><h3>آخرین سفارش‌ها</h3><button onclick="reconcile()">بررسی سفارش‌های باز</button><div style="overflow:auto"><table><thead><tr><th>کد</th><th>یوزرنیم</th><th>پلن</th><th>مبلغ</th><th>وضعیت</th><th>زمان</th></tr></thead><tbody id="orders"></tbody></table></div></section></div></main><script>
  let token=sessionStorage.getItem('bp_admin')||'';const H=()=>({'content-type':'application/json','authorization':'Bearer '+token});
  async function login(){const r=await fetch('/api/admin/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({password:document.getElementById('pass').value})});const d=await r.json();if(!d.ok){document.getElementById('loginmsg').textContent='رمز نادرست است';return}token=d.token;sessionStorage.setItem('bp_admin',token);load()}
  async function load(){if(!token)return;const r=await fetch('/api/admin/summary',{headers:H()});if(r.status===401){sessionStorage.removeItem('bp_admin');return}const d=await r.json();document.getElementById('login').style.display='none';document.getElementById('panel').style.display='block';document.getElementById('profit').value=d.settings.profit_percent||15;document.getElementById('rounding').value=d.settings.rounding||1000;document.getElementById('support').value=d.settings.support||'';document.getElementById('tg').innerHTML='وضعیت: <b class="'+(d.providers.tgtools.ok?'ok':'bad')+'">'+(d.providers.tgtools.configured?(d.providers.tgtools.ok?'متصل':'خطا در اتصال'):'تنظیم نشده')+'</b>'+(d.providers.tgtools.balance_ton!=null?'<br>موجودی TON: '+d.providers.tgtools.balance_ton:'')+(d.providers