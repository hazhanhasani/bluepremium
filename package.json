{
  "name": "bluepremium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply blue-premium-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blue-premium-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.43.0"
  }
}
